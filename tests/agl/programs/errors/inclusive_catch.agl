# Inclusive `catch`: a handler matches its declared exception type and every
# descendant, tried most-specific-first; a re-raise from an inner handler
# still reaches an outer handler for its type.
exception Problem extends Exception
  code: int
exception Detailed extends Problem
  detail: text
exception VeryDetailed extends Detailed
  hint: text
exception Other extends Exception
  note: text
exception MyRoot
  note: text
exception MineOfMyRoot extends MyRoot
  code: int

program def main(mode: text) -> unit =
  if
    | mode == "most-specific-first" =>
        try
          raise Detailed(message = "m", code = 1, detail = "d")
        catch Detailed as d =>
          print "detailed: %{d.detail}"
        catch Problem as p =>
          print "problem: %{p.code}"
        catch _ as e =>
          print "other: %{e.message}"
    | mode == "base-catches-descendant" =>
        try
          raise VeryDetailed(message = "m", code = 2, detail = "d", hint = "h")
        catch Problem as p =>
          print "caught by base: %{p.code}"
        catch _ as e =>
          print "other: %{e.message}"
    | mode == "sibling-falls-to-wildcard" =>
        try
          raise Other(message = "m", note = "n")
        catch Problem as p =>
          print "caught by base: %{p.code}"
        catch _ as e =>
          print "fell through: %{e.message}"
    | mode == "reraise-caught-by-outer" =>
        try
          try
            raise Detailed(message = "m", code = 3, detail = "d")
          catch Problem as inner =>
            raise inner
        catch Detailed as outer =>
          print "outer caught: %{outer.detail}"
    | mode == "user-declared-root-catches-own-descendant" =>
        try
          raise MineOfMyRoot(note = "n", code = 4)
        catch MyRoot as r =>
          print "root caught: %{r.note}"
        catch _ as e =>
          print "fell through: %{e.message}"
    | mode == "user-declared-root-does-not-catch-unrelated" =>
        try
          raise Other(message = "m", note = "n")
        catch MyRoot as r =>
          print "root caught: %{r.note}"
        catch _ as e =>
          print "fell through: %{e.message}"
    | else => ()
