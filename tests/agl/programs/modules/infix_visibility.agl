# A cross-module operator takes the fixity of its defining module: the prelude
# supplies |>, a wildcard import supplies %>, and a selective import tail ~>.
import flow/pipe::*
import flow/compose::~>

def inc(x: int) -> int = x + 1

program def main(value: int) -> unit =
  print((value |> inc) as text)
  print((value %> inc) as text)
  let twice = inc ~> inc
  print(twice(value) as text)
