import std/env::Environ
# `chdir` raises `FsError`; imported so the companion can construct it.
import std/fs::FsError
import std/option::Option
import std/path::path

extern def exit(code: int = 0) -> unit
# Raises `std/fs::FsError(path = ".", operation = "cwd")` if the working
# directory no longer exists, or `EncodingError` if it is not valid Unicode.
extern def cwd() -> path
extern def pid() -> int
# Raises `EncodingError` if the host name is not valid Unicode.
extern def hostname() -> text
# The host's temporary directory. Raises `EncodingError` if it is not valid Unicode.
@extern-name("temp_dir")
extern def temp-dir() -> path

scope ChdirInternals
  @extern-name("chdir")
  extern def raw-chdir(dir: path, vars: dict[text, text]) -> unit
end ChdirInternals

# Changes the host process working directory, recording `OLDPWD` (the
# directory before) and `PWD` (`cwd()` after) into `std/env::environ`.
# Raises `std/fs::FsError(path = dir, operation = "chdir")` on failure, or
# `EncodingError` if the directory before or after is not valid Unicode,
# leaving the directory unchanged. Leaving a working directory that no longer
# exists is allowed; `OLDPWD` then keeps the previous `PWD`, and the directory
# cannot be restored after an `EncodingError`.
def chdir(dir: path) -> unit = ChdirInternals::raw-chdir(dir, std/env::environ.vars)

# Whether standard input and output are both connected to a terminal.
@extern-name("is_interactive")
extern def is-interactive() -> bool
# Executable lookup on `env`'s `PATH` (the host default `PATH` when absent).
extern def which(name: text, env: Environ = std/env::environ) -> Option[path]
extern def platform() -> text
# Usable CPU count; at least 1.
@extern-name("cpu_count")
extern def cpu-count() -> int
# The real user's passwd name; `None` when it has none. Raises `EncodingError`
# if the name is not valid Unicode.
extern def user() -> Option[text]

# Raised by `edit` and `open`. `exit-code` is `Some(code)` for a non-zero
# exit, or `None` when there was nothing to launch. `command` is what failed
# to launch or exit: the editor (the `VISUAL`/`EDITOR` value, or the last
# fallback, `vi`, when none is found), `sh` if the shell itself is missing, or
# the opener.
exception LaunchError extends Exception
  command: text
  exit-code: Option[int]

# Opens `file` for editing: the first non-empty `VISUAL`, then `EDITOR`, from
# `env`, else the first of `micro`, `vi` found on `env`'s `PATH`. Blocks until
# the editor exits, inheriting stdio; the editor value is a shell snippet
# (`code --wait` works). `env` is the child's complete environment, not an
# overlay on AGM's own. While waiting, AGM ignores SIGINT and SIGQUIT (git's
# editor behavior) and restores them once the editor exits. Raises
# `LaunchError`: `exit-code = None` when the editor command itself could not
# be found (including a shell "command not found"), `Some(code)` for any
# other non-zero exit.
extern def edit(file: path, env: Environ = std/env::environ) -> unit

# Round-trips `initial` through the editor: writes it to a fresh
# `std/fs::temp-file(suffix)`, calls `edit`, reads back the result, and
# removes the temporary file. A failed `edit` (raised `LaunchError`) leaves
# the temporary file for `std/fs::temp-file`'s own host-session-end cleanup.
def edit-text(initial: text, suffix: text = ".md", env: Environ = std/env::environ) -> text =
  let file = std/fs::temp-file(suffix)
  std/fs::write(file, initial)
  edit(file, env)
  let content = std/fs::read(file)
  std/fs::remove(file)
  content

# Opens `target` (a file or URL) with the desktop default application:
# `open` on darwin, `xdg-open` otherwise, found on `env`'s `PATH`. `env` is
# the child's complete environment, not an overlay on AGM's own. Waits for
# the opener, not the launched application, to exit. Raises `LaunchError`.
extern def open(target: text, env: Environ = std/env::environ) -> unit
