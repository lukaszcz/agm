# Modules: a glob import exposes mutable engine settings for bare assignment.
# Exercises a bare write cross-checked through a qualified read, a bare write
# whose value comes from a function exposed by an import tail, and a
# differently-typed setting on the same import. A param drives the values.
import std/config::*
import tuning::*

program def main(budget: int) -> unit =
  # Bare write through the glob import; the qualified read sees the same binding.
  strict-json := budget <= 4
  print std/config::strict-json

  # The written value may come from a function exposed by an import tail, read back bare.
  strict-json := wants-strict(budget)
  print strict-json

  # `timeout` is a differently-typed setting reached through the same import.
  timeout := Some(seconds(budget))
  print timeout
  print std/config::timeout
