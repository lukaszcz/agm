{
  "scenarios": [
    {
      "name": "in_range_argument_runs_normally",
      "params": {"rate": "1.5"},
      "expect": {
        "stdout": "1.5\n1\n"
      }
    },
    {
      "name": "integral_decimal_argument_fills_an_int_parameter",
      "params": {"rate": "1.5", "count": "2.0e3"},
      "expect": {
        "stdout": "1.5\n2000\n"
      }
    },
    {
      "name": "out_of_range_argument_is_rejected_at_preflight",
      "params": {"rate": "1e1000000"},
      "expect": {
        "host_error": {}
      }
    },
    {
      "name": "exponent_past_any_decimal_is_rejected_at_preflight",
      "params": {"rate": "1e99999999999999999999"},
      "expect": {
        "host_error": {}
      }
    },
    {
      "name": "integral_decimal_too_large_for_int_is_rejected_at_preflight",
      "params": {"rate": "1.5", "count": "1e999999999999"},
      "expect": {
        "host_error": {}
      }
    },
    {
      "name": "infinite_int_argument_is_rejected_at_preflight",
      "params": {"rate": "1.5", "count": "Infinity"},
      "expect": {
        "host_error": {}
      }
    }
  ]
}
