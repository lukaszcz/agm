# Code review, revision and refinement workflows

import std/config
import std/fs
import std/log
import devel/utils

enum Severity = NIT | LOW | MEDIUM | HIGH | CRITICAL

record Issue
  severity: Severity
  @doc("location - file:line:column")
  location: text
  description: text

record Review
  issues: array[Issue]

enum ReviseIssueResponse
  | Valid(fix-description: text)
  | Invalid(reason: text)

def Agent::review(self, scope: text, aspects: text) -> Review =
  let prompt: text = """
  Review %{scope} for %{aspects}.

  Reply with a list of issues classified by severity: NIT, LOW, MEDIUM, HIGH, CRITICAL.
  """
  self.ask prompt

def revise-issue-prompt(issue: Issue) -> text =
  """
  Check if the following issue is still valid — if so, understand the root cause and fix it. Keep changes minimal and validate. Commit after fixing the issue.

  ## Issue

  %{issue as json}

  ## Response

  - If the issue was valid, respond with `Valid` and the fix description.
  - If the issue wasn't valid, respond with `Invalid` and the reason for invalidity.
  """

def Agent::revise-issue(self, issue: Issue) -> ReviseIssueResponse =
  self.ask <| revise-issue-prompt(issue)

# Returns `true` if there was at least one valid HIGH or CRITICAL issue.
def Agent::revise-review(self, review: Review) -> bool =
  var ct: bool = false
  for issue in review.issues do
    log::info(issue as json)
    let r = self.revise-issue(issue)
    log::info(r as json)
    log::info-nl()
    if r is Valid and (issue.severity is HIGH or issue.severity is CRITICAL) =>
      ct := true
  done
  ct

def revise-whole-review-prompt(review: text) -> text =
  """
  Read the following review. For each listed issue, check if the issue is valid — if so, understand the root cause and fix it. Fix only still-valid issues, skip the rest, keep changes minimal, and validate.

  Fix the root cause of ALL valid issues. Commit after fixing each valid issue.

  ## Review

  START REVIEW
  >>>>>>>>>>>>>>>>

  %{review}

  >>>>>>>>>>>>>>>>
  END REVIEW

  ## Response

  After fixing ALL valid issues, respond with the following.

  - If at least one HIGH or CRITICAL issue was valid, return `true`.
  - If no HIGH or CRITICAL issue was valid, return `false`.
  """

def Agent::revise-whole-review(self, review: text) -> bool =
  self.ask <| revise-whole-review-prompt(review)

def refine(scope: text, aspects: text, review-agent: Agent, revise-agent: Agent, max-steps: int, save-reviews: bool) -> unit =
  var n: int = 1
  do[max-steps]
    log::info-heading "Refine step %{n}"
    n := n + 1
    let review = review-agent.review(scope, aspects)
    let review-json = review as json
    log::info(review-json)
    log::info-nl()
    if save-reviews =>
      fs::write(utils::new-path("review", ".json"), "%{review-json}")
    let ct = revise-agent.revise-review(review)
  until not ct

let default-aspects = "correctness, maintainability, efficency, adherence to relevant AGENTS.md files"

@command("devel review")
@doc("""
Review <scope> for given aspects.

Default aspects: %{default-aspects}.

Examples:
  agm devel review "against main"
  agm devel review "last commit" --extra-aspects "simplicity"
  agm devel review "the test suite" --aspects "efficiency only"
""")
program def review-main(
  scope: text,
  aspects: text = default-aspects,
  extra-aspects: text = "",
  agent: Agent = config::default-agent
) -> unit =
  let sep = if extra-aspects == "" => "" else => ", "
  print <| agent.review(scope, aspects ++ sep ++ extra-aspects) as json

@command("devel revise")
@doc("Revise based on a review.")
program def revise-main(
  review-file: path,
  agent: Agent = config::default-agent
) -> unit =
  let txt: text = fs::read(review-file)
  let high-valid: bool =
    case txt as? Review of
      | Some(value) =>
        agent.revise-review(value)
      | None =>
        agent.revise-whole-review(txt)
  if
    | high-valid => print "At least one HIGH or CRITICAL issue was valid."
    | else => print "There were no valid HIGH or CRITICAL issues."

@command("devel refine")
@doc("""
Refine in a review-revise loop.

Runs a refinement loop until no high-severity issues remain, for at most `max-steps` iterations.

Examples:
  agm devel refine "against main"
  agm devel refine "last commit" --extra-aspects "simplicity"
  agm devel refine "the test suite" --aspects "efficiency only"
""")
program def refine-main(
  scope: text,
  aspects: text = default-aspects,
  extra-aspects: text = "",
  review-agent: Agent = config::default-agent,
  revise-agent: Agent = config::default-agent,
  max-steps: int = 8,
  save-reviews: bool = true
) -> unit =
  let sep = if extra-aspects == "" => "" else => ", "
  refine(scope, aspects ++ sep ++ extra-aspects, review-agent, revise-agent, max-steps, save-reviews)
