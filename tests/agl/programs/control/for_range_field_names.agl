# Operator words stay usable as record fields: `.` and `:` positions never
# promote them. Regression: the range operators in field_name position.
record Stride
  step: int
  to: int
  downto: int
  or: int

program def main() -> unit =
  let s = Stride(step = 3, to = 10, downto = 2, or = 7)
  print s.step
  print s.to
  print s.downto
  print s.or

  for i in s.step to s.to step s.step do
    ()
  done
  print "ok"
