{
  "scenarios": [
    {
      "name": "plain_name",
      "params": {
        "who": "Ada"
      },
      "agents": {
        "ask": [
          "r1",
          "r2",
          "r3",
          "r4"
        ]
      },
      "expect": {
        "stdout": "r1\nr2\nr3\nr4\n",
        "calls": {
          "ask": 4
        },
        "prompts": [
          {
            "agent": {
              "$case": "AgentClaude",
              "model": "sonnet",
              "thinking": "medium"
            },
            "call": 0,
            "contains": [
              "Ada",
              "qty 7,",
              "sum 7."
            ]
          },
          {
            "agent": {
              "$case": "AgentClaude",
              "model": "sonnet",
              "thinking": "medium"
            },
            "call": 1,
            "contains": [
              "Ada"
            ]
          },
          {
            "agent": {
              "$case": "AgentClaude",
              "model": "sonnet",
              "thinking": "medium"
            },
            "call": 2,
            "contains": [
              "data: {\"kind\": \"demo\", \"tags\": [\"alpha\", \"beta\"]}"
            ]
          },
          {
            "agent": {
              "$case": "AgentClaude",
              "model": "sonnet",
              "thinking": "medium"
            },
            "call": 3,
            "contains": [
              "Report for ",
              "Ada",
              "Item(name = \"bolt\", qty = 7)",
              "Pick::One(item = Item(name = \"bolt\", qty = 7))"
            ]
          }
        ]
      }
    },
    {
      "name": "name_with_template_syntax_is_not_reinterpolated",
      "params": {
        "who": "Eve %{exploit} ${exploit} \"quoted\""
      },
      "agents": {
        "ask": [
          "w",
          "x",
          "y",
          "z"
        ]
      },
      "expect": {
        "stdout": "w\nx\ny\nz\n",
        "calls": {
          "ask": 4
        },
        "prompts": [
          {
            "agent": {
              "$case": "AgentClaude",
              "model": "sonnet",
              "thinking": "medium"
            },
            "call": 0,
            "contains": [
              "Eve %{exploit} ${exploit} \"quoted\"",
              "qty 7,",
              "sum 7."
            ]
          }
        ]
      }
    }
  ]
}
