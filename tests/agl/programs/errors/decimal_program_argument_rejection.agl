# Every decimal value at runtime is within the pinned context's range (Emax/
# Emin 999999): a host-supplied program argument decoded into a
# `decimal`-typed parameter rejects an out-of-range number, or one whose
# exponent no decimal can hold, at preflight, before the program ever runs,
# exactly like any other malformed argument. An `int`-typed parameter accepts
# an integral decimal token only while it stays within the integer digit
# limit.

program def main(rate: decimal, count: int = 1) -> unit =
  print rate
  print count
