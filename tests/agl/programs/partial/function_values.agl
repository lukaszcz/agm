# Generic function values and partial applications share one expression inference region.

def maker[T]() -> T -> T = fn(value: T) => value

def make-pair[T]() -> (T, T) -> T = fn(left: T, right: T) => left

program def main(mode: text) -> unit =
  if
    | mode == "call" =>
        print(maker()(7))
    | mode == "partial" =>
        let keep: (int) -> int = make-pair()(?, 5)
        print(keep(8))
    | else =>
        let first = maker()(3)
        let second = maker()("text")
        print(first)
        print(second)
