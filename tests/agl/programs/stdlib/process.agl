# Process metadata is available through explicit std/process imports.
import std/process

program def main(mode: int) -> unit =
  let directory = process::cwd()
  let process-id = process::pid()
  let host = process::hostname()
  case mode of
    | 1 =>
        print(directory.size() > 0)
        print(process-id > 0)
        print(host.size() > 0)
    | 2 =>
        print(directory == directory)
        print(process-id == process-id)
        print(host == host)
    | _ => process::exit(mode)
