scope A
  builtin
  exception ExecError extends Exception
    command: text
    exit-code: int
    stdout: text
    stderr: text
    timed-out: bool
end A

def run() -> text =
  try
    let out: text = exec("false")
    "no-error"
  catch ExecError as e =>
    "caught: %{e.exit-code}"

program def main() -> unit =
  print(run())
