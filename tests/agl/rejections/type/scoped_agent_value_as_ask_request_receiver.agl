scope A
builtin enum Agent
  | AgentCommand(command: text)
  | AgentClaude(model: text, thinking: text)
  | AgentCodex(model: text, thinking: text)
  | AgentPi(provider: text, model: text, thinking: text)

builtin def Agent::ask-request(self, prompt: text) -> AgentRequest
end A
program def main() -> unit =
  let g: A::Agent = A::Agent::AgentCommand("echo")
  let q = g.ask-request("hi")
  let name = case q.agent of
    | AgentCommand(command) => command
    | AgentClaude(model, thinking) => model
    | AgentCodex(model, thinking) => model
    | AgentPi(provider, model, thinking) => model
  print name
