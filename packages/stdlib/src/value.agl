import std/result::Result
import std/errors::ValueParseError

@doc("""
  Render a value as AgL text.

  Raises `CyclicValueError` when the value contains a cycle.
""")
builtin def render[T](value: T) -> text

@doc("Return a deep copy of the value, detaching nested mutable storage.")
builtin def copy[T](value: T) -> T

@doc("Return a shallow copy of the value, sharing nested mutable storage.")
builtin def shallow-copy[T](value: T) -> T

@doc("""
  Parse AgL value text as the requested type.

  Raises `ValueParseError` when the text cannot be parsed as that type.
""")
builtin def parse[T](value: text) -> T

@doc("Parse AgL value text as the requested type, returning `ValueParseError` as `Err`.")
builtin def try-parse[T](value: text) -> Result[T, ValueParseError]
