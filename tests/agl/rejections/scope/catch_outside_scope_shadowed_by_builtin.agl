scope A
  builtin
  exception ExecError extends Exception
    *
    command: text
    exit_code: int
    stdout: text
    stderr: text
    timed_out: bool
end A

def run() -> text =
  try
    let out: text = exec("false")
    "no-error"
  catch ExecError as e =>
    "caught: %{e.exit_code}"

program def main() -> unit =
  print(run())
