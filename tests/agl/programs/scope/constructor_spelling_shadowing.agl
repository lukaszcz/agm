# An enum variant's bare spelling is a convenience injection of
# `Owner::variant`, so local bindings may reuse that spelling: pattern position
# still classifies the variant while value references select the local binding.
enum Color
  | Red
  | Blue

record Box
  shade: Color

def shade-of(c: Color, root-red: int, root-blue: int) -> int
  case c of
    | Red => root-red
    | Blue => root-blue

def shadowed(Red: int, root-red: int) -> int
  Red + root-red

def Retry(tint: int) -> int
  tint + 100

program def main(pick: text, tint: int) -> unit =
  let Red = tint
  let Blue = tint * 2

  let chosen: Color = if | pick == "red" => Color::Red | else => Color::Blue
  let boxed = Box(shade = chosen)

  case boxed.shade of
    | Red => print "pattern red"
    | Blue => print "pattern blue"

  print Red
  print Blue
  print Red
  print shade-of(chosen, Red, Blue)
  print shadowed(1, Red)
  print Retry(tint)
