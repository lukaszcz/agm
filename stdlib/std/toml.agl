import std/result::Result

exception TomlParseError extends Exception
  raw: text

exception TomlRenderError extends Exception()

extern def parse(value: text) -> json
def try-parse(value: text) -> Result[json, TomlParseError] =
  try Result::Ok(value = parse(value)) catch TomlParseError as e => Result::Err(error = e)
extern def render(value: json) -> text
