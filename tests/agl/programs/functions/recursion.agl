# Recursive user-defined functions: factorial (direct recursion) and
# even/odd (mutual recursion).

def fact(x: int) =
  if x <= 1 => 1 else => x * fact(x - 1)

def is-even(x: int) =
  if x == 0 => true else => is-odd(x - 1)

def is-odd(x: int) =
  if x == 0 => false else => is-even(x - 1)

program def main(n: int) -> unit =
  print(fact(n))
  print(is-even(n))
