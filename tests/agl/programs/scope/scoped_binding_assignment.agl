# Scoped static bindings: qualified and bare assignment, a bare reference
# reaching a var made bare by `use` before its source scope declares it, and visibility from
# nested and qualified paths.
use Config::*

param increment: int

scope Config
let retries: int = 3
var attempts: int = 0
def bump() -> unit =
  attempts := attempts + increment
  ()
def show() -> text = "%{retries}/%{attempts}"
scope Nested
def doubled() -> int = attempts * 2
end Nested
end Config

program def main() -> unit =
  var extra: int = 1

  Config::bump()
  Config::attempts := Config::attempts + 1
  extra := extra + increment
  Config::bump()

  print(Config::show())
  print("%{Config::attempts}")
  print("%{extra}")
  print("%{Config::Nested::doubled()}")
