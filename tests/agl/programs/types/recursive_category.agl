# Recursive record guarded by an array field: Category can hold nested
# subcategories without needing a base-case variant, since array[Category] is
# always inhabited by the empty array. Builds a nested tree (root -> child ->
# optional grandchild) plus an EMPTY-children case, counts and renders both
# recursively.
record Category
  name: text
  subcategories: array[Category]

def count-categories(c: Category) -> int =
  var total: int = 1
  for child in c.subcategories do
    total := total + count-categories(child)
  total

def render-category(c: Category) -> text =
  var result: text = c.name
  for child in c.subcategories do
    result := result + " > " + render-category(child)
  result

program def main(root-name: text, child-name: text, include-grandchild: bool) -> unit =
  let grandchildren: array[Category] = if include-grandchild => [Category(name = "leaf", subcategories = [])] else => []
  let child = Category(name = child-name, subcategories = grandchildren)
  let root = Category(name = root-name, subcategories = [child])
  let empty-root = Category(name = "empty", subcategories = [])

  print count-categories(root)
  print render-category(root)
  print count-categories(empty-root)
  print render-category(empty-root)
