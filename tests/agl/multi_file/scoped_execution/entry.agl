import scoped_execution/workflow
import scoped_execution/workflow::{Workflow::Task}
import scoped_execution/workflow::*
use scoped_execution/workflow::Workflow::*
use scoped_execution/workflow::Workflow::Status::*

scope Dispatch
let reviewer = AgentCommand("reviewer")
def fetch() -> Task = ask("Return a recursive task.", agent = reviewer)
end Dispatch

program def main() -> unit =
  let task = Dispatch::fetch()
  let status: Status = ask("Return a workflow status.", agent = Dispatch::reviewer)
  print(score(task))
  print(label(status))
  print(status is completed)
