import std/config
import std/env::Environ
import std/errors::Exception
import std/option::Option
import std/path::path

builtin
record ExecResult
  stdout: text
  exit-code: int
  stderr: text
  timed-out: bool

builtin
exception ExecError extends Exception
  command: text
  exit-code: int
  stdout: text
  stderr: text
  timed-out: bool

builtin def exec(
  command: text,
  env: Environ = std/env::environ,
  cwd: Option[path] = Option[path]::None,
  timeout: Option[text] = std/config::timeout,
) -> ExecResult
