import std/option::Option

exception TomlParseError extends Exception
  raw: text

exception TomlRenderError extends Exception()

scope TomlInternals
  extern def parse_option(value: text) -> Option[json]
end TomlInternals

extern def parse(value: text) -> json
def parse?(value: text) -> Option[json] = TomlInternals::parse_option(value)
extern def render(value: json) -> text
