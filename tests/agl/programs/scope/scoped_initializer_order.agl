# Runtime initialization is sequenced in the selected program body. Named
# scopes are static declaration regions and do not perform module initialization.

program def main(start: int, branch-in-region: bool = false) -> unit =
  var order: int = start
  order := order + 1
  let root-a = order
  let scoped-x = if branch-in-region =>
    order := order + 1
    let first = order
    order := order + 1
    first + order
  else => (order := order + 1; order)
  order := order + 1
  let nested-n = order
  order := order + 1
  let scoped-y = order
  order := order + 1
  let root-b = order
  order := order + 1
  let scoped-z = order
  order := order + 1
  let scoped-w = order
  order := order + 1
  let root-c = order
  print("%{root-a} %{scoped-x} %{nested-n} %{scoped-y} %{root-b} %{scoped-z} %{scoped-w} %{root-c}")
