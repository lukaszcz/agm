# The multi-agent refinement loop, finished with exec and print.
enum Review
  | Pass
  | Fail(issues: array[text])

param spec

program def main() -> unit =
  let impl = AgentCommand("impl")
  let reviewer = AgentCommand("reviewer")
  let critic = AgentCommand("critic")
  var artifact: text = impl.ask("Implement %{spec}")

  # code and design declared as vars outside the loop so the until condition can see them.
  var code: Review = Pass
  var design: Review = Pass

  do[5]
    code := reviewer.ask("Review correctness:\n%{artifact}", on_parse_error = Retry(n = 2))
    design := critic.ask("Review design:\n%{artifact}", on_parse_error = Retry(n = 2))

    if code is Fail or design is Fail =>
      artifact := impl.ask("""
      Fix valid issues.

      Correctness review:
      %{code}

      Design review:
      %{design}

      Current artifact:
      %{artifact}
      """)
    else =>
      ()
  until code is Pass and design is Pass

  let stamp: text = exec "printf 'final:%s' %{artifact}"
  print stamp
