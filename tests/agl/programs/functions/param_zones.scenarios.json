{
  "scenarios": [
    {
      "name": "small_values",
      "params": {
        "a-val": 2,
        "b-val": 3,
        "z-val": 5
      },
      "expect": {
        "stdout": "5\n5\n10\n10\n10\n5\n5\n17\n10\n[\n  2,\n  3\n]\n"
      }
    },
    {
      "name": "larger_values",
      "params": {
        "a-val": 10,
        "b-val": 4,
        "z-val": 6
      },
      "expect": {
        "stdout": "14\n14\n60\n60\n20\n14\n14\n26\n20\n[\n  10,\n  4\n]\n"
      }
    },
    {
      "name": "zero_values",
      "params": {
        "a-val": 0,
        "b-val": 0,
        "z-val": 0
      },
      "expect": {
        "stdout": "0\n0\n0\n0\n0\n0\n0\n10\n0\n[\n  0,\n  0\n]\n"
      }
    }
  ]
}
