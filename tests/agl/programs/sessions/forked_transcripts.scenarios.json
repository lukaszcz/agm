{
  "scenarios": [
    {
      "name": "claude_forked_session_diverges_after_a_shared_prefix",
      "params": {"backend": 0, "fork_before_asks": false},
      "agents": {"ask": {"responses": ["shared", "parent", "child"]}},
      "expect": {
        "calls": {"ask": 0},
        "sessions": [{"agent": "ask", "tag": "session-1", "opened": true, "closed": true, "parent": null}, {"agent": "ask", "tag": "session-2", "opened": true, "closed": true, "parent": "session-1"}],
        "session_prompts": [
          {"agent": "ask", "session": "session-1", "call": 0, "equals": "shared prefix"},
          {"agent": "ask", "session": "session-1", "call": 1, "follow_up": {"equals": "parent continuation"}},
          {"agent": "ask", "session": "session-2", "call": 0, "equals": "child continuation"}
        ],
        "session_operations": [{"agent": "ask", "session": "session-1", "operation": "fork", "outcome": "success"}]
      }
    },
    {
      "name": "pi_cli_forked_session_diverges_after_a_shared_prefix",
      "params": {"backend": 1, "fork_before_asks": false},
      "agents": {"pi": {"responses": ["shared", "parent", "child"]}},
