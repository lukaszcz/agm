
enum Level
  | @name("silent") Silent
  | @name("error") Error
  | @name("warn") Warn
  | @name("info") Info
  | @name("debug") Debug

@param
@opt-name("log-level")
@doc("Logging level: silent, error, warn, info, debug.")
var level: Level = Info

def Level::to-int(self) -> int =
  case self of
    | Silent => 0
    | Error => 1
    | Warn => 2
    | Info => 3
    | Debug => 4

def Level::from-int(l: int) -> Level =
  if
    | l == 0 => Silent
    | l == 1 => Error
    | l == 2 => Warn
    | l == 3 => Info
    | l == 4 => Debug
    | else => Debug

def print[T](lvl: Level, val: T) -> unit =
  if lvl.to-int() <= level.to-int() =>
    print val

def print-sep(lvl: Level) -> unit =
  ::print(lvl, "------------------------------------------")

def print-nl(lvl: Level) -> unit =
  ::print(lvl, "")

def print-heading[T](lvl: Level, val: T) -> unit =
  print-nl(lvl)
  ::print(lvl, "## %{val}")
  print-nl(lvl)

def error[T](val: T) -> unit =
  ::print(Error, val)

def error-sep() -> unit =
  print-sep(Error)

def error-nl() -> unit =
  print-nl(Error)

def error-heading[T](val: T) -> unit =
  print-heading(Error, val)

def warn[T](val: T) -> unit =
  ::print(Warn, val)

def warn-sep() -> unit =
  print-sep(Warn)

def warn-nl() -> unit =
  print-nl(Warn)

def warn-heading[T](val: T) -> unit =
  print-heading(Warn, val)

def info[T](val: T) -> unit =
  ::print(Info, val)

def info-sep() -> unit =
  print-sep(Info)

def info-nl() -> unit =
  print-nl(Info)

def info-heading[T](val: T) -> unit =
  print-heading(Info, val)

def debug[T](val: T) -> unit =
  ::print(Debug, val)

def debug-sep() -> unit =
  print-sep(Debug)

def debug-nl() -> unit =
  print-nl(Debug)

def debug-heading[T](val: T) -> unit =
  print-heading(Debug, val)
