                "spam": {"type": "noul", "instructions": "Is it spam?"},
                "routed": {
                  "type": "choice",
                  "instructions": "routed",
                  "criteria": {"Billing": "Invoices and refunds.", "Technical": null, "acct": null}
                },
                "urgent": {"type": "noul", "instructions": "urgent"}
              }
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {
              "spam": {"type": "noul", "noul": 0.1},
              "routed": {
                "type": "choice",
                "choice": "acct",
                "confidence": 0.7,
                "probabilities": {"Billing": 0.2, "Technical": 0.1, "acct": 0.7}
              },
              "urgent": {"type": "noul", "noul": 0.9}
            },
            "usage": {"input_tokens": 30, "output_tokens": 3}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        }
      ],
      "expect": {
        "stdout": "[0.1, 0.7]\ntrue\n{\"Billing\": 0.2, \"Technical\": 0.1, \"acct\": 0.7}\ntrue\n"
      }
    },
