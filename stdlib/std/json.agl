import std/option::Option

scope JsonInternals
  extern def parse_strict(value: text) -> json
  extern def parse_strict_option(value: text) -> Option[json]
  extern def parse_lenient(value: text) -> json
  extern def parse_lenient_option(value: text) -> Option[json]
  extern def kind(self: json) -> text
  extern def size(self: json) -> int
  extern def keys(self: json) -> array[text]
  extern def has(self: json, key: text) -> bool
  extern def get(self: json, key: text) -> json
  extern def get_option(self: json, key: text) -> Option[json]
end JsonInternals

def parse(value: text) -> json = JsonInternals::parse_strict(value)
def parse?(value: text) -> Option[json] = JsonInternals::parse_strict_option(value)
def parse-lenient(value: text) -> json = JsonInternals::parse_lenient(value)
def parse-lenient?(value: text) -> Option[json] = JsonInternals::parse_lenient_option(value)

def json::kind(self) -> text = JsonInternals::kind(self)
def json::size(self) -> int = JsonInternals::size(self)
def json::keys(self) -> array[text] = JsonInternals::keys(self)
def json::has(self, key: text) -> bool = JsonInternals::has(self, key)
def json::get(self, key: text) -> json = JsonInternals::get(self, key)
def json::get?(self, key: text) -> Option[json] = JsonInternals::get_option(self, key)
