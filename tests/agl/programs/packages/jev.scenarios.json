    {
      "name": "ask_builds_every_target_kind_from_its_question",
      "params": {"scenario": "targets"},
      "jev": [
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {"question": {"type": "noul", "instructions": "Is it urgent?"}}
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {"question": {"type": "noul", "noul": 0.5}},
            "usage": {"input_tokens": 12, "output_tokens": 1}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {"question": {"type": "noul", "instructions": "Is it spam?"}}
