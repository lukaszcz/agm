# Value-call partial application covers let-bound functions, lambdas, and chaining.

def add(a: int, b: int) -> int = a + b

def digits3(a: int, b: int, c: int) -> int = a * 100 + b * 10 + c

program def main(mode: text, base: int) -> unit =
  let add-value: (int, int) -> int = add
  let lambda-value = fn(x: int, y: int) -> int => x * 10 + y
  let add-base = add-value(?, base)
  let lambda-left = lambda-value(?, base)
  let partial-digits = digits3(?, 1, ?)
  let finish-digits = partial-digits(?, base)

  if
    | mode == "values" =>
        print(add-base(3))
        print(lambda-left(4))
    | mode == "direct_chain" =>
        print(add(?, 1)(base))
        print(digits3(?, base, 9)(2))
    | else =>
        print(finish-digits(7))
        let stored = add(?, 1)
        print(stored(base))
