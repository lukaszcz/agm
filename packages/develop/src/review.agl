# Code review, revision and refinement workflows

enum Severity = LOW | MEDIUM | HIGH | CRITICAL

record Issue
  severity: Severity
  @doc("location - file and line(s)")
  location: text
  description: text

type Review = array[Issue]

def Agent::review(self, scope: text, aspects: text) -> Review =
  let prompt: text = """
  Review %{scope} for %{aspects}.

  Reply with a list of issues classified by severity: LOW, MEDIUM, HIGH, CRITICAL.
  """
  self.ask prompt

program def main(
  scope: text,
  aspects: text = "correctness, maintainability, adherence to relevant AGENTS.md files",
  extra-aspects: text = "",
  agent: Agent = default-agent) -> unit =
  let sep = if extra-aspects == "" => "" else => ", " + extra-aspects
  let r = agent.review(scope, aspects + sep + extra-aspects)
  print r
