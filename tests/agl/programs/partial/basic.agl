# Bare-hole partial applications over declared functions.

def add(a: int, b: int) -> int = a + b

def digits(a: int, b: int, c: int) -> int = a * 100 + b * 10 + c

program def main(mode: text, base: int) -> unit =
  let inc = add(?, 1)
  let add-to-base = add(base, ?)
  let first-position = digits(?, base, 9)
  let middle-position = digits(base, ?, 9)
  let last-position = digits(1, base, ?)
  let two-holes = digits(?, base, ?)
  let all-holes = digits(?, ?, ?)
  let immediate = add(?, base)(2)

  if
    | mode == "single" =>
        print(inc(base))
        print(add-to-base(6))
        print(immediate)
    | mode == "positions" =>
        print(first-position(2))
        print(middle-position(3))
        print(last-position(7))
    | else =>
        print(two-holes(3, 4))
        print(all-holes(1, 2, 3))
