# Every HttpError subtype reached through the raising function and through
# the try- twin, narrowing a caught `HttpError` with `as?`/`is`, inclusive
# `catch HttpError` handling every subtype through one handler, a sibling
# mismatch still not caught by a subtype-specific handler, and a Save write
# failure.
import std/fs
import std/http
import std/http::HttpError
import std/http::HttpTimeoutError
import std/path
import std/text

# Narrows `e` with `as?` to read each subtype's own fields; `HttpUrlError`,
# `HttpRequestError`, and `HttpTlsError` carry nothing this prints, so `is`
# alone identifies them.
def describe-http-error(e: http::HttpError) -> unit =
  case e as? http::HttpStatusError of
    | Some(value) =>
        print("url=%{e.url} method=%{e.method.render()} type=HttpStatusError status=%{value.response.status}")
    | None =>
        case e as? http::HttpTimeoutError of
          | Some(value) =>
              print("url=%{e.url} method=%{e.method.render()} type=HttpTimeoutError timeout=%{value.timeout}")
          | None =>
              case e as? http::HttpConnectionError of
                | Some(value) =>
                    print("url=%{e.url} method=%{e.method.render()} type=HttpConnectionError has-cause=%{not value.cause.is-empty()}")
                | None =>
                    case e as? http::HttpRedirectError of
                      | Some(value) =>
                          print("url=%{e.url} method=%{e.method.render()} type=HttpRedirectError redirects=%{value.redirects}")
                      | None =>
                          case e as? http::HttpDecodeError of
                            | Some(value) =>
                                print("url=%{e.url} method=%{e.method.render()} type=HttpDecodeError encoding=%{value.encoding}")
                            | None =>
                                if
                                  | e is http::HttpUrlError =>
                                      print("url=%{e.url} method=%{e.method.render()} type=HttpUrlError")
                                  | e is http::HttpTlsError =>
                                      print("url=%{e.url} method=%{e.method.render()} type=HttpTlsError")
                                  | else =>
                                      print("url=%{e.url} method=%{e.method.render()} type=HttpRequestError")

# One `get` wrapped in `catch HttpError`, describing whatever subtype fires.
def get-and-describe(target: text) -> unit =
  try
    let _ = http::get(target)
    ()
  catch HttpError as e =>
    describe-http-error(e)

program def main(root: path, scenario: text) -> unit =
  case scenario of
    | "get_raises_transport_error" =>
        let _ = http::get("https://x/y")
        ()
    | "custom_method_raises_http_request_error" =>
        let _ = http::request(http::Method::Other("BAD METHOD"), "https://x/y")
        ()
    | "get_raises_http_timeout_error" =>
        let _ = http::get("https://x/y", timeout = Some("5s"))
        ()
    | "raise_for_status_raises_http_status_error" =>
        let _ = http::get("https://x/y").raise-for-status()
        ()
    | "try_twins_wrap_every_transport_failure_kind" =>
        let results = [
          http::try-get("https://x/y"),
          http::try-request(http::Method::Other("BAD METHOD"), "https://x/y"),
          http::try-get("https://x/y"),
          http::try-get("https://x/y"),
          http::try-get("https://x/y"),
          http::try-get("https://x/y"),
          http::try-get("https://x/y"),
        ]
        for result in results do
          case result of
            | Ok(_) => ()
            | Err(_ as e) => describe-http-error(e)
    | "specific_catch_does_not_match_a_different_http_error_subtype" =>
        try
          let _ = http::get("https://x/y", timeout = Some("5s"))
          ()
        catch HttpTimeoutError as e =>
          print("caught timeout: %{e.timeout}")
    | "catch_http_error_reads_the_status_after_raise_for_status" =>
        try
          let _ = http::get("https://x/y").raise-for-status()
          ()
        catch HttpError as e =>
          case e as? http::HttpStatusError of
            | Some(value) => print("status: %{value.response.status}")
            | None => print("no status")
    | "catch_http_error_handles_every_transport_kind" =>
        get-and-describe("https://x/y")
        try
          let _ = http::request(http::Method::Other("BAD METHOD"), "https://x/y")
          ()
        catch HttpError as e =>
          describe-http-error(e)
        get-and-describe("https://x/y")
        get-and-describe("https://x/y")
        get-and-describe("https://x/y")
        get-and-describe("https://x/y")
        get-and-describe("https://x/y")
    | "save_to_unwritable_path_raises_fs_error" =>
        let destination = path::join([root, "missing", "out.bin"])
        let _ = http::download("https://x/y", destination)
        ()
    | _ =>
        ()
