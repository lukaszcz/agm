{
  "scenarios": [
    {
      "name": "bad_input_triggers_cast_error",
      "params": {
        "bad-input": "abc"
      },
      "expect": {
        "stdout_contains": [
          "CastError(message = \"Failed to parse text as JSON:",
          "source-type = \"text\", target-type = \"int\", raw = \"abc\")",
          "caught: text -> int\n",
          "\"source-type\": \"text\"",
          "\"target-type\": \"int\"",
          "\"raw\": \"abc\"",
          "no int\n",
          "ArithmeticError(message = \"Division by zero\", operation = \"/\")",
          "operation: /\n"
        ],
        "stdout_not_contains": [
          "parsed:",
          "trace-id"
        ]
      }
    },
    {
      "name": "valid_input_no_cast_error",
      "params": {
        "bad-input": "42"
      },
      "expect": {
        "stdout_contains": [
          "parsed: 42\n",
          "got int\n",
          "ArithmeticError(message = \"Division by zero\", operation = \"/\")",
          "operation: /\n"
        ],
        "stdout_not_contains": [
          "CastError",
          "caught:",
          "trace-id"
        ]
      }
    }
  ]
}
