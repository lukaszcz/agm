{
  "scenarios": [
    {
      "name": "fixed_iso_and_strftime_values_round_trip_in_utc",
      "params": {"mode": 1},
      "expect": {"stdout": "2024-01-02T03:04:05.123456+00:00\n2024/01/02 03:04:05.123456 +0000\ntrue\n", "calls": {}}
    },
    {
      "name": "invalid_iso_and_strptime_text_raise_time_parse_error",
      "params": {"mode": 2},
      "expect": {"stdout": "not an instant\nnot a date\n", "calls": {}}
    },
    {
      "name": "try_parse_variants_return_results_instead_of_raising",
      "params": {"mode": 4},
      "expect": {"stdout": "Option::Some(value = \"not an instant\")\ntrue\nOption::Some(value = \"2024-01-02T03:04:05+00:00\")\nOption::Some(value = \"2024-01-02T00:00:00+00:00\")\n", "calls": {}}
    },
    {
      "name": "clock_operations_have_stable_shape_and_a_monotonic_elapsed_clock",
      "params": {"mode": 3},
      "expect": {"stdout": "true\ntrue\ntrue\ntrue\ntrue\n", "calls": {}}
    }
  ]
}
