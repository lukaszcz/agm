import std/result::Result

exception FsError extends Exception
  path: text
  operation: text

extern def read(path: text) -> text
extern def write(path: text, content: text) -> unit
extern def append(path: text, content: text) -> unit
extern def exists(path: text) -> bool
extern def list(path: text) -> array[text]
extern def mkdir(path: text) -> unit
extern def remove(path: text) -> unit
extern def copy(source: text, destination: text) -> unit
extern def move(source: text, destination: text) -> unit
extern def glob(pattern: text) -> array[text]

def try-read(path: text) -> Result[text, FsError] =
  try Result::Ok(value = read(path)) catch FsError as e => Result::Err(error = e)

@extern-name("is_file")
extern def is-file(path: text) -> bool
@extern-name("is_dir")
extern def is-dir(path: text) -> bool
