# Scoped static bindings resolve bare sibling nominal, generic, and alias
# annotations. Runtime parsing and scoped-type construction use those types
# from the program body.
scope A
  record R(v: int)
  record Box[T](value: T)
  type Alias = int

  let x: R = R(v = 1)
  var y: R = R(v = 2)
  let boxed: Box[int] = Box(value = 3)
  let a: Alias = 4
end A

program def main() -> unit =
  var z: A::R = A::R(v = 5)
  let w: A::R = A::R(v = 6)
  let parsed: json = exec("give-json", format = "json")
  let casted = parsed as A::R
  let fetched: A::R = exec("give-r", format = "json")

  print(A::x.v)
  print(A::y.v)
  print(A::boxed.value)
  print(A::x.v)
  print(casted.v)
  print(fetched.v)
  print(A::a)
  print(z.v)
  print(w.v)
