# Array-guarded recursive record at the agent boundary: `Category`'s own
# `subcategories: array[Category]` field closes the recursive instantiation
# graph exactly like a self-referencing enum variant does — the empty array is
# the base case for inhabitation, and the SAME self-loop makes `Category`
# recursive for the `$defs`/`$ref` schema and `RefDecode` decode derivation.
record Category
  name: text
  subcategories: array[Category]

def count_categories(c: Category) -> int =
  var total: int = 1
  for sub in c.subcategories do
    total := total + count_categories(sub)
  total

program def main() -> unit =
  let tree_source = AgentCommand("tree_source")
  let c: Category = tree_source.ask("Fetch the category tree.")
  print c.name
  print count_categories(c)
