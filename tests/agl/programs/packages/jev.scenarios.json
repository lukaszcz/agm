          },
          "headers": {"x-typesafe-request-id": "req-1"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {
                "question": {
                  "type": "choice",
                  "instructions": "Which team?",
                  "criteria": {"Billing": "Invoices and refunds.", "Technical": null, "acct": null}
                }
              }
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {
              "question": {
                "type": "choice",
                "choice": "acct",
                "confidence": 0.7,
                "probabilities": {"Billing": 0.1, "Technical": 0.2, "acct": 0.7}
              }
            },
            "usage": {"input_tokens": 12, "output_tokens": 1}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {
                "question": {
                  "type": "choice",
                  "instructions": "Which team?",
                  "criteria": {"Billing": "Invoices and refunds.", "Technical": null, "acct": null}
                }
              }
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {
              "question": {
                "type": "choice",
                "choice": "Billing",
                "confidence": 0.7,
                "probabilities": {"Billing": 0.7, "Technical": 0.2, "acct": 0.1}
              }
            },
            "usage": {"input_tokens": 12, "output_tokens": 1}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {
                "question": {
                  "type": "score",
                  "instructions": "How severe?",
                  "criteria": ["Can wait.", "Medium", "Drop everything."]
                }
              }
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {
              "question": {
                "type": "score",
                "score": 1.8,
                "confidence": 0.4,
                "legend": {"0": "Can wait.", "1": "Medium", "2": "Drop everything."},
                "probabilities": {"0": 0.05, "1": 0.1, "2": 0.85}
              }
            },
            "usage": {"input_tokens": 12, "output_tokens": 1}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        }
