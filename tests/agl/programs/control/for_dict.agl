# for x in dict do body — iterate dict keys; use d[x] for values.
# Exercises: for over dict, key binding, value access via index.

program def main(d: dict[text, int]) -> unit =
  var count: int = 0
  var key_sum: int = 0
  for k in d do
    count := count + 1
    key_sum := key_sum + d[k]
  done
  print count
  print key_sum
