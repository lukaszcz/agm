# CastError field access: verifies that a caught CastError carries its declared
# source_type, target_type, raw, and message fields for downstream logic.
param value
param target

# Attempt cast and inspect all fields on failure

program def main() -> unit =
  try
    if target == "int" =>
      let n = value as int
      print "int: %{n}"
    else =>
      let d = value as decimal
      print "decimal: %{d as text}"
  catch CastError as e =>
    print "source: %{e.source_type}"
    print "target: %{e.target_type}"
    print "raw: %{e.raw}"
    # message is non-empty
    let has_msg = e.message != ""
    print "has_message: %{has_msg as text}"
