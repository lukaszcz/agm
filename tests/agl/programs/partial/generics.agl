# Generic callees can use concrete arguments and expected function types to solve holes.

def id[T](x: T) -> T = x

def singleton[T](x: T) -> array[T] = [x]

def map-one[A, B](f: (A) -> B, xs: array[A]) -> array[B] = [f(xs[0])]

def apply[A, B](x: A, f: (A) -> B) -> B = f(x)

def tag[T](label: int, x: T) -> T = x

program def main(mode: text, n: int) -> unit =
  if
    | mode == "concrete" =>
        # A generic callee with a fixed concrete-typed argument: the hole's type is
        # solved from the expected function type while the bound `int` argument stays
        # concrete.
        let keep: (text) -> text = tag(n, ?)
        print(keep("kept"))
    | mode == "map" =>
        let map-id: (array[int]) -> array[int] = map-one(id, ?)
        let mapped = map-id([n])
        print(mapped[0])
        let map-render = map-one(fn(x: int) -> text => "v=%{x}", ?)
        let rendered = map-render([3])
        print(rendered[0])
    | mode == "expected" =>
        let make-single: (int) -> array[int] = singleton(?)
        let result = make-single(n)
        print(result[0])
        let int-id: (int) -> int = id(?)
        print(int-id(n + 1))
    | else =>
        let apply-text: (text) -> text = apply(?, id)
        print(apply-text("kept"))
        let typed-map = map-one::[int, int](id::[int], ?)
        print(typed-map([n + 2])[0])
