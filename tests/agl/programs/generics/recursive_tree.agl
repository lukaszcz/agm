# Generic recursion: a single `enum Tree[T]` declaration built, matched,
# folded, and compared with '=' at three different instantiations —
# `Tree[int]`, `Tree[text]`, and the nested `Tree[array[int]]` — via one
# generic `count_nodes[T]` fold plus instantiation-specific folds.
enum Tree[T]
  | Leaf
  | Node(value: T, left: Tree[T], right: Tree[T])

def count-nodes[T](t: Tree[T]) -> int =
  case t of
    | Leaf => 0
    | Node(value, left, right) => 1 + count-nodes(left) + count-nodes(right)

def sum-ints(t: Tree[int]) -> int =
  case t of
    | Leaf => 0
    | Node(value, left, right) => value + sum-ints(left) + sum-ints(right)

def concat-texts(t: Tree[text]) -> text =
  case t of
    | Leaf => ""
    | Node(value, left, right) => concat-texts(left) ++ value ++ concat-texts(right)

def sum-nested-arrays(t: Tree[array[int]]) -> int =
  case t of
    | Leaf => 0
    | Node(value, left, right) =>
        var total: int = sum-nested-arrays(left) + sum-nested-arrays(right)
        for x in value do
          total := total + x
        total

# Tree[int]: build, fold, equality.

program def main(a: int, b: int, c: int) -> unit =
  let int-tree: Tree[int] = Node(
    value = a,
    left = Node(value = b, left = Leaf, right = Leaf),
    right = Node(value = c, left = Leaf, right = Leaf),
  )
  let same-int-tree: Tree[int] = Node(
    value = a,
    left = Node(value = b, left = Leaf, right = Leaf),
    right = Node(value = c, left = Leaf, right = Leaf),
  )
  let different-int-tree: Tree[int] = Node(value = a, left = Leaf, right = Leaf)

  print count-nodes(int-tree)
  print sum-ints(int-tree)
  print (int-tree == same-int-tree)
  print (int-tree == different-int-tree)

  # Tree[text]: the SAME generic declaration, a different instantiation.
  let text-tree: Tree[text] = Node(
    value = "b",
    left = Node(value = "a", left = Leaf, right = Leaf),
    right = Node(value = "c", left = Leaf, right = Leaf),
  )
  print count-nodes(text-tree)
  print concat-texts(text-tree)

  # Tree[array[int]]: a container-of-container instantiation.
  let array-tree: Tree[array[int]] = Node(
    value = [a, b],
    left = Leaf,
    right = Node(value = [c], left = Leaf, right = Leaf),
  )
  print count-nodes(array-tree)
  print sum-nested-arrays(array-tree)

  case int-tree of
    | Leaf => print "empty"
    | Node(value, left, right) => print "root %{value}"
