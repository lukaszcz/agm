{
  "scenarios": [
    {
      "name": "distinct_args_no_collision",
      "params": { "y": 3 },
      "expect": { "stdout": "{Point(x = 1, y = 2): 10, Point(x = 1, y = 3): 20}\n" }
    },
    {
      "name": "same_args_collide_at_runtime",
      "params": { "y": 2 },
      "expect": { "stdout": "dup: Point(x = 1, y = 2)\n" }
    }
  ]
}
