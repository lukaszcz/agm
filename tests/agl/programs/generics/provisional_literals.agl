# Container literals can collect their element/value type from constraints
# elsewhere in one expression. Empty literals receive evidence from sibling
# arguments, expected results, and generic constructor fields; populated
# containers and branches can unify provisional generic values.

record Bundle[T]
  values: array[T]
  metadata: dict[text, T]
  value: T

enum Option[T]
  | none
  | some(value: T)

def choose[T](left: T, right: T) -> T = right
def id[T](value: T) -> T = value

program def main(prefer-empty: bool) -> unit =
  let from-array-sibling = choose([], [7])
  let from-dict-sibling = choose({}, {answer: 8})
  let from-result: array[int] = id([])
  let from-fields = Bundle(values = [], metadata = {}, value = 9)
  let options: array[Option[int]] = [none, some(value = 10)]
  let selected = if prefer-empty => [] else => [11]

  print from-array-sibling
  print from-dict-sibling
  print from-result
  print from-fields.values
  print from-fields.metadata
  print options
  print selected
