import std/option::Option
import std/errors::{JsonParseError, KeyError}

scope JsonInternals
  extern def parse_option(value: text) -> Option[json]
  extern def parse_lenient(value: text) -> json
  extern def parse_lenient_option(value: text) -> Option[json]
  extern def get_option(self: json, key: text) -> Option[json]
end JsonInternals

extern def parse(value: text) -> json
def parse?(value: text) -> Option[json] = JsonInternals::parse_option(value)
def parse-lenient(value: text) -> json = JsonInternals::parse_lenient(value)
def parse-lenient?(value: text) -> Option[json] = JsonInternals::parse_lenient_option(value)

extern def json::kind(self) -> text
extern def json::size(self) -> int
extern def json::keys(self) -> array[text]
extern def json::has(self, key: text) -> bool
extern def json::get(self, key: text) -> json
def json::get?(self, key: text) -> Option[json] = JsonInternals::get_option(self, key)
