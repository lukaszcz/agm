# Records: nested types, multi-line constructors with trailing comma, field access
# chains, record agent targets.
record Author
  name: text
  active: bool

record Issue
  title: text
  severity: int
  weight: decimal
  tags: array[text]
  extra: json
  author: Author

program def main(min-severity: int) -> unit =
  let tracker: Agent = AgentCommand("tracker")
  let issue = Issue(
    title = "Missing tests",
    severity = 3,
    weight = 0.5,
    tags = ["tests", "coverage"],
    extra = {origin: "static", retries: null},
    author = Author(name = "Ada", active = true),
  )

  print issue.title
  print issue.severity
  print issue.weight
  print issue.author.name
  print issue.author.active

  let fetched: Issue = tracker.ask("Fetch the top issue.")
  print fetched.title
  print fetched.severity

  if fetched.severity >= min-severity =>
    print "escalate"
  else =>
    print "ignore"
