# let/var/set, literal inference, agent-call targets, bare expression statements.
param start

program def main() -> unit =
  let impl: Agent = AgentCommand("impl")
  let greeting = "hello"
  let count = 2
  let exact = 1.5
  let okay = true

  var artifact = impl.ask("Start from %{start}")
  print artifact
  artifact := impl.ask("Refine: %{artifact}")
  print artifact

  var total: int = count + 1
  total := total * 2
  print total

  ask "Note %{greeting} %{exact} %{okay}"
  print "done"
