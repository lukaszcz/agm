# for x in text do body — iterate characters of a text string.
# Exercises: for over text, char binding, until terminator.

program def main(s: text) -> unit =
  var count: int = 0
  var found: bool = false
  for ch in s do
    count := count + 1
    if ch == "!" =>
      found := true
  until found
  print count
  print found
