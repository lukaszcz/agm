import std/option::Option

scope RandomInternals
  extern def shuffle_in_place[T](values: array[T]) -> unit
end RandomInternals

extern def seed(value: int) -> unit
extern def below(upper: int) -> int
extern def between(lower: int, upper: int) -> int
extern def uniform() -> decimal
extern def choice[T](values: array[T]) -> T
def choice?[T](values: array[T]) -> Option[T] =
  try Option::Some(value = choice(values)) catch IndexError as _ => Option::None
def shuffle![T](values: array[T]) -> unit = RandomInternals::shuffle_in_place(values)
extern def uuid() -> text
