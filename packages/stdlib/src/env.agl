# Environ's implementation needs dict methods even when a custom standard
# library has no dependency on receiver-method modules.
import std/dict
import std/option::Option

record Environ
  vars: dict[text, text]

@doc("""
  Return the environment variable's value.

  Raises `KeyError` when the variable is absent.
""")
def Environ::get(self, name: text) -> text = self.vars.get(name)
@doc("Return the environment variable's value, or `None` when absent.")
def Environ::get?(self, name: text) -> Option[text] = self.vars.get?(name)
@doc("Set an environment variable's value.")
def Environ::set(self, name: text, value: text) -> unit = self.vars.set(name, value)
@doc("""
  Remove an environment variable.

  Raises `KeyError` when the variable is absent.
""")
def Environ::unset(self, name: text) -> unit =
  let _ = self.vars.remove(name)
  ()
@doc("Check if the environment contains the variable.")
def Environ::contains(self, name: text) -> bool = self.vars.contains(name)
@doc("Return a new environment with the overrides replacing shared variables.")
def Environ::extended(self, overrides: dict[text, text]) -> Environ =
  Environ(self.vars.merge(overrides))

# A process environment variable that is not valid Unicode is a pre-run host
# error, before any of `environ`'s entries are readable.
builtin var environ: Environ = Environ({})

@doc("""
  Return a variable's value from `environ`.

  Raises `KeyError` when the variable is absent.
""")
def getenv(name: text) -> text = environ.get(name)
@doc("Return a variable's value from `environ`, or `None` when absent.")
def getenv?(name: text) -> Option[text] = environ.get?(name)
@doc("Check if `environ` contains the variable.")
def hasenv(name: text) -> bool = environ.contains(name)
@doc("Set a variable's value in `environ`.")
def setenv(name: text, value: text) -> unit = environ.set(name, value)
@doc("""
  Remove a variable from `environ`.

  Raises `KeyError` when the variable is absent.
""")
def unsetenv(name: text) -> unit = environ.unset(name)
