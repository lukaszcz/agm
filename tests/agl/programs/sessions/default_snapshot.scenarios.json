{
  "scenarios": [
    {
      "name": "default_session_snapshots_the_first_default_agent",
      "params": {"explicit_close": true},
      "agents": {
        "writer": {"responses": ["first", "second"]},
        "reviewer": {"responses": []}
      },
      "expect": {
        "calls": {"writer": 0, "reviewer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "opened": true, "closed": true, "parent": null}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "equals": "first prompt"},
          {"agent": "writer", "session": "session-1", "call": 1, "follow_up": {"equals": "second prompt"}}
        ]
      }
    },
    {
      "name": "default_session_cleanup_keeps_its_first_agent_snapshot",
      "params": {"explicit_close": false},
      "agents": {
        "writer": {"responses": ["first", "second"]},
        "reviewer": {"responses": []}
      },
      "expect": {
        "calls": {"writer": 0, "reviewer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "opened": true, "closed": true, "parent": null}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "equals": "first prompt"},
          {"agent": "writer", "session": "session-1", "call": 1, "follow_up": {"equals": "second prompt"}}
        ]
      }
    }
  ]
}
