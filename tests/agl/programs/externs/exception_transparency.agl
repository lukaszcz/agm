# AgL exceptions cross callback and companion frames without becoming ExternError.

exception Problem extends Exception
  detail: text

extern def invoke(f: () -> int) -> int
extern def catch_and_reraise(f: () -> int) -> int
extern def raise_from_companion() -> int

def fail-from-callback() -> int =
  raise Problem(message = "callback", detail = "original")

program def main(mode: text) -> unit =
  if mode == "callback" =>
    try
      let _ = invoke(fail-from-callback)
    catch Problem as error =>
      print "%{error.message}:%{error.detail}"

  if mode == "reraise" =>
    try
      let _ = catch_and_reraise(fail-from-callback)
    catch Problem as error =>
      print "%{error.message}:%{error.detail}"

  if mode == "companion" =>
    try
      let _ = raise_from_companion()
    catch Problem as error =>
      print "%{error.message}:%{error.detail}"
