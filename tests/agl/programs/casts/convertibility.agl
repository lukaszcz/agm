# `as?` yields `Option`: `Some(value)` carries the converted value when the
# corresponding `as` cast would succeed, so selecting a branch on it also
# supplies the value; `None` reports that the cast would fail.

# Check if the text is a valid int before using it

program def main(user-input: text, d: decimal) -> unit =
  case user-input as? int of
    | Some(value) =>
      print "got int: %{value}"
      print "squared: %{(value * value) as text}"
    | None => print "not an int: %{user-input}"

  case d as? int of
    | Some(value) => print "decimal is integral: %{value}"
    | None => print "decimal has fraction: %{d as text}"

  print((42 as? text).is-some())
