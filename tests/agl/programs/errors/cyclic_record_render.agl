# A mutable enum-member record can close a cycle without an array or dict.
# Rendering and JSON encoding raise a catchable CyclicValueError only when
# the cycle is actually closed.
param close_cycle: bool

enum Link
  | End
  | Cell(var next: Link)

program def main() -> unit =
  let cell = Cell(next = End)
  if close_cycle =>
    cell.next := cell

  try
    print(cell)
  catch CyclicValueError =>
    print "print caught"

  try
    let _: json = cell as json
    print "json completed"
  catch CyclicValueError =>
    print "json caught"
