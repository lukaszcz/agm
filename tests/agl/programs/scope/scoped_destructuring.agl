# Named-scope nominal declarations support runtime destructuring with
# qualified paths. `mode` drives every destructured value, so each scenario's
# output differs across every printed line, not just the trailing mode line.
param mode: text

record Bounds(low: int, high: int)

scope A
  record Point(x: int, y: int)
end A

scope B
end B

scope C
  enum Status
    | Idle(reason: text)
end C

scope D
  exception Oops extends Exception
    code: int
  def use(offset: int) -> int =
    try
      raise Oops(message = "boom", code = 5 + offset)
    catch Oops as e =>
      e.code
end D

scope E
  record Range(low: int, high: int)

  def pick(r: Range) -> int =
    case r of
    | Range(low, high) => low + high

  def unqualified_let_destructure(r: Range) -> int =
    let Range(low, high) = r
    low - high
end E

program def main() -> unit =
  let offset = if | mode == "verbose" => 100 | else => 0
  let reason = if | mode == "verbose" => "loud" | else => "quiet"

  let A::Point(x = _ as first_x, y = _ as first_y) = A::Point(x = 1 + offset, y = 2 + offset)
  let Bounds(low = _ as bound_low, high = _ as bound_high) = Bounds(low = 10 + offset, high = 20 + offset)
  let C::Status::Idle(reason = _ as scoped_reason) = C::Status::Idle(reason = reason)
  let A::Point(x = _ as qx, y = _ as qy) = A::Point(x = 4 + offset, y = 5 + offset)
  let C::Status::Idle(reason = _ as qreason) = C::Status::Idle(reason = reason)

  print("%{first_x} %{first_y}")
  print("%{bound_low} %{bound_high}")
  print("%{scoped_reason}")
  print("%{D::use(offset)}")
  print("%{E::pick(E::Range(low = 1 + offset, high = 2 + offset))}")
  print("%{E::unqualified_let_destructure(E::Range(low = 5 + offset, high = 2 + offset))}")
  print("%{qx} %{qy}")
  print("%{qreason}")

  if mode == "verbose" =>
    print("mode: verbose")
  else =>
    print("mode: quiet")
