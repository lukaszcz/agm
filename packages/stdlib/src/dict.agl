import std/option::Option
import std/pair::Pair
import std/errors::{DuplicateKeyError, KeyError}

enum DuplicateKeys
  | Raise
  | KeepFirst
  | KeepLast

@doc("Return the number of entries.")
extern def dict[K, V]::size(self) -> int

@doc("Check if the dictionary has no entries.")
def dict[K, V]::is-empty(self) -> bool = self.size() == 0
@doc("""
  Return the value for the given key.

  Raises `KeyError` when the key is absent.
""")
extern def dict[K, V]::get{Hashable K}(self, key: K) -> V

@extern-name("get_option")
@doc("Return the value for the given key, or `None` when absent.")
extern def dict[K, V]::get?{Hashable K}(self, key: K) -> Option[V]

@doc("""
  Remove and return the value for the given key.

  Raises `KeyError` when the key is absent.
""")
extern def dict[K, V]::remove{Hashable K}(self, key: K) -> V

@doc("Set the value for the given key, replacing any existing value.")
extern def dict[K, V]::set{Hashable K}(self, key: K, value: V) -> unit

@extern-name("remove_option")
@doc("Remove and return the value for the given key, or `None` when absent.")
extern def dict[K, V]::remove?{Hashable K}(self, key: K) -> Option[V]

@doc("Check if the dictionary contains the given key.")
extern def dict[K, V]::contains{Hashable K}(self, key: K) -> bool

@doc("Remove all entries from the dictionary.")
extern def dict[K, V]::clear(self) -> unit

@doc("Return the keys in insertion order.")
extern def dict[K, V]::keys(self) -> array[K]

@doc("Return the values in insertion order.")
extern def dict[K, V]::values(self) -> array[V]

@doc("Return key-value pairs in insertion order.")
extern def dict[K, V]::entries(self) -> array[Pair[K, V]]

@doc("Return a new dictionary combining both dictionaries, with the other's values winning.")
extern def dict[K, V]::merge{Hashable K}(self, other: dict[K, V]) -> dict[K, V]

@extern-name("merge_in_place")
@doc("Merge the other's entries in place, replacing values for shared keys.")
extern def dict[K, V]::merge!{Hashable K}(self, other: dict[K, V]) -> unit

@extern-name("map_values")
@doc("Return a new dictionary with the function applied to each value.")
extern def dict[K, V]::map-values[U](self, function: (V) -> U) -> dict[K, U]

@doc("Return a new dictionary containing entries that satisfy the predicate.")
extern def dict[K, V]::select(self, predicate: (K, V) -> bool) -> dict[K, V]

@extern-name("select_in_place")
@doc("Keep only entries that satisfy the predicate in place.")
extern def dict[K, V]::select!(self, predicate: (K, V) -> bool) -> unit

@doc("Call the function on each key-value pair in insertion order.")
extern def dict[K, V]::each(self, function: (K, V) -> unit) -> unit

@extern-name("from_entries")
@doc("""
  Build a dictionary from key-value pairs.

  `on-duplicate` decides what an equal key seen again does: `Raise` raises
  `DuplicateKeyError`, `KeepFirst` keeps the first value, `KeepLast` the last.
""")
extern def from-entries[K, V]{Hashable K}(
  values: array[Pair[K, V]],
  on-duplicate: DuplicateKeys = Raise
) -> dict[K, V]
