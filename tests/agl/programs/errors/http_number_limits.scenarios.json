{
  "scenarios": [
    {
      "name": "integral_decimal_count_narrows",
      "http": [
        {
          "status": 200,
          "body": "{\"n\": 2.0e3}",
          "expect": {
            "method": "GET"
          }
        }
      ],
      "expect": {
        "stdout": "2000\n",
        "calls": {}
      }
    },
    {
      "name": "integral_decimal_too_large_for_int_is_not_a_count",
      "http": [
        {
          "status": 200,
          "body": "{\"n\": 1e999999999999}",
          "expect": {
            "method": "GET"
          }
        }
      ],
      "expect": {
        "stdout": "not a count\n",
        "calls": {}
      }
    },
    {
      "name": "infinite_decimal_is_not_json",
      "http": [
        {
          "status": 200,
          "body": "{\"n\": Infinity}",
          "expect": {
            "method": "GET"
          }
        }
      ],
      "expect": {
        "stdout": "not json\n",
        "calls": {}
      }
    },
    {
      "name": "exponent_past_any_decimal_is_not_json",
      "http": [
        {
          "status": 200,
          "body": "{\"n\": 1e99999999999999999999}",
          "expect": {
            "method": "GET"
          }
        }
      ],
      "expect": {
        "stdout": "not json\n",
        "calls": {}
      }
    },
    {
      "name": "over_long_integer_is_not_json",
      "http": [
        {
          "status": 200,
          "body": "{\"n\": }",
          "expect": {
            "method": "GET"
          }
        }
      ],
      "expect": {
        "stdout": "not json\n",
        "calls": {}
      }
    }
  ]
}
