# while loop with break and continue:
# Counts n from 0; skips values <= skip_below via continue;
# breaks when n >= stop_at.
# Accumulates the sum of values that pass both filters.

program def main(skip-below: int, stop-at: int) -> unit =
  var n: int = 0
  var total: int = 0
  while n < stop-at do
    n := n + 1
    if n <= skip-below => continue
    if n >= stop-at => break
    total := total + n
  done
  print total
