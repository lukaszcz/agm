# Bare names in nested patterns follow their matched field names.
enum Flag
  | on
  | off

enum Packet
  | packet(count: int, flag: Flag, label: text)

enum NamedPacket
  | named-packet(on: Flag)

program def main() -> unit =
  var on: int = 0
  let value = packet(7, Flag::on, "ready")
  case value of
    | packet(count, flag = on, label = label as shown) =>
      on := on + 1
      print "%{on}:%{count}:%{shown}"
    | packet(_, _, _) => print "other"

  let named = named-packet(on = Flag::on)
  case named of
    | named-packet(on()) => print "constructor"
    | named-packet(_ as captured) => print "capture"
