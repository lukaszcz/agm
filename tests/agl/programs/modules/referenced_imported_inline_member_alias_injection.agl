# Imported enum and alias paths to an inline member retain its one canonical
# constructor when referenced enums are brought into this module.
import routes::{ViaImportedEnum, ViaImportedAlias}

program def main() -> unit =
  let from-enum: ViaImportedEnum[int] = Member(value = 6)
  let from-alias: ViaImportedAlias[text] = Member(value = "seven")
  print from-enum
  print from-alias
