# ask/ask-request sandbox: the sandbox operand selects the dispatched
# request's permission mode, defaults to std/config::default-sandbox when
# omitted (and follows a later write to that setting), and ask-request
# exposes the decoded AgentSandbox value -- both a plain member and the
# Sandbox-widened record -- without dispatching.
import std/config

def classify(mode: AgentSandbox) -> text =
  case mode of
    | Disabled => "disabled"
    | Native => "native"
    | Sandbox(memory, swap, settings, patch) =>
        "sandbox(%{memory}, %{swap}, %{settings}, %{patch})"

program def main(mode: text) -> unit =
  let impl: Agent = AgentCommand("impl")

  if
    | mode == "native" =>
        let response = ask("Do it.", agent = impl, sandbox = AgentSandbox::Native)
        print response
    | mode == "disabled" =>
        let response = ask("Do it.", agent = impl, sandbox = AgentSandbox::Disabled)
        print response
    | mode == "sandbox-default-fields" =>
        let response = ask("Do it.", agent = impl, sandbox = Sandbox)
        print response
    | mode == "sandbox-explicit-fields" =>
        let response = ask("Do it.", agent = impl, sandbox = Sandbox(memory = Some("8G")))
        print response
    | mode == "implicit-default" =>
        let response = ask("Do it.", agent = impl)
        print response
    | mode == "default-sandbox-write" =>
        let first = ask("Do it.", agent = impl)
        print first
        std/config::default-sandbox := AgentSandbox::Disabled
        let second = ask("Do it.", agent = impl)
        print second
    | mode == "request-member" =>
        let request = ask-request("Prepare.", sandbox = AgentSandbox::Native)
        print request.prompt
        print classify(request.sandbox)
    | mode == "request-widened" =>
        let request = ask-request("Prepare.", sandbox = Sandbox(memory = Some("8G")))
        print classify(request.sandbox)
    | else =>
        let request = ask-request("Prepare.")
        print classify(request.sandbox)
