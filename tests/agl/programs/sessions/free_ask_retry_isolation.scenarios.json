{
  "scenarios": [
    {
      "name": "agent_ask_retries_in_one_ephemeral_session",
      "runtime": {"session_host": true},
      "agents": {"writer": ["not a number", "7"]},
      "expect": {
        "stdout": "7\n",
        "calls": {"writer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "transport": "cli", "single_prompt": false, "opened": true, "closed": true, "parent": null}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "starts_with": "calculate the total"},
          {"agent": "writer", "session": "session-1", "call": 1, "contains": ["Validation errors"]}
        ]
      }
    }
  ]
}
