{
  "scenarios": [
    {
      "name": "unsupported_operations_fail_the_same_before_and_after_the_first_ask",
      "params": {"reset_before_ask": false},
      "agents": {"ask": {"responses": ["created"]}},
      "expect": {
        "stdout": "set-name\ncompact\nfork\nset-name\nstats\ncompact\nfork\nset-name\nstats\ncompact-message\nfork-message\nset-name-message\nstats-message\n",
        "calls": {"ask": 0},
        "sessions": [{"agent": "ask", "tag": "session-1", "opened": true, "closed": true, "parent": null}],
        "session_prompts": [{"agent": "ask", "session": "session-1", "call": 0, "equals": "create the thread"}],
        "session_operations": [
          {"agent": "ask", "session": "session-1", "operation": "compact", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "compact", "call": 1, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "fork", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "fork", "call": 1, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "set-name", "call": 0, "arg": "unsupported", "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "set-name", "call": 1, "arg": "unsupported", "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "reset", "outcome": "success"},
          {"agent": "ask", "session": "session-1", "operation": "stats", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "stats", "call": 1, "outcome": "unsupported"}
        ]
      }
    },
    {
      "name": "reset_before_the_first_ask_never_requires_a_codex_thread",
      "params": {"reset_before_ask": true},
      "agents": {"ask": {"responses": ["created"]}},
      "expect": {
        "stdout": "set-name\ncompact\nfork\nset-name\nstats\ncompact\nfork\nset-name\nstats\ncompact-message\nfork-message\nset-name-message\nstats-message\n",
        "calls": {"ask": 0},
        "sessions": [{"agent": "ask", "tag": "session-1", "opened": true, "closed": true, "parent": null}],
        "session_prompts": [{"agent": "ask", "session": "session-1", "call": 0, "equals": "create the thread"}],
        "session_operations": [
          {"agent": "ask", "session": "session-1", "operation": "compact", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "compact", "call": 1, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "fork", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "fork", "call": 1, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "set-name", "call": 0, "arg": "unsupported", "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "set-name", "call": 1, "arg": "unsupported", "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "reset", "call": 0, "outcome": "success"},
          {"agent": "ask", "session": "session-1", "operation": "reset", "call": 1, "outcome": "success"},
          {"agent": "ask", "session": "session-1", "operation": "stats", "call": 0, "outcome": "unsupported"},
          {"agent": "ask", "session": "session-1", "operation": "stats", "call": 1, "outcome": "unsupported"}
        ]
      }
    }
  ]
}
