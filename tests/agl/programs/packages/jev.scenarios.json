    {
      "name": "failures_are_caught_by_their_type_by_the_root_and_by_the_try_twins",
      "params": {"scenario": "caught"},
      "module_params": {"sysone/jev::max-retries": 0},
      "jev": [
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {"question": {"type": "noul", "instructions": "Is it urgent?"}}
            }
          },
          "status": 429,
          "json": {"error": "scripted"},
          "headers": {"retry-after-ms": "250", "x-typesafe-request-id": "req-5"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {
                "question": {
                  "type": "choice",
                  "instructions": "Which team?",
                  "criteria": {"Billing": "Invoices and refunds.", "Technical": null, "acct": null}
                }
              }
            }
          },
          "status": 503,
          "json": {"error": "scripted"},
          "headers": {"x-typesafe-request-id": "req-6"}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {"question": {"type": "noul", "instructions": "Is it urgent?"}}
            }
          },
          "status": 401,
          "json": {"error": "scripted"},
          "headers": {}
        },
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
              "questions": {"question": {"type": "noul", "instructions": "Is it urgent?"}}
            }
          },
          "json": {
            "model": "jev-1",
            "answers": {"question": {"type": "noul", "noul": 0.4}},
            "usage": {"input_tokens": 12, "output_tokens": 1}
          },
          "headers": {"x-typesafe-request-id": "req-1"}
        }
      ],
      "expect": {"stdout": "rate limited after 250ms\n503 req-6\nerr: 401 -\nerr: no status\ntrue\n"}
    },
