# Total casts: `as text` (any renderable value → text) and `as json` (any
# JSON-shaped value → json) never fail at runtime. Also demonstrates the
# contrast between `"42" as json` (embeds text as a JSON string) and
# `json::parse("42")` (parses the text and yields the JSON number 42).
import std/json

# int / bool / decimal → text

program def main(n: int, flag: bool, ratio: decimal) -> unit =
  let n-text   = n     as text
  let b-text   = flag  as text
  let d-text   = ratio as text
  print n-text
  print b-text
  print d-text

  # int / bool / decimal → json
  let n-json   = n     as json
  let b-json   = flag  as json
  let d-json   = ratio as json
  print n-json
  print b-json
  print d-json

  # text → json embeds the text as a JSON string (total, no parse)
  let embedded = "42" as json
  print embedded

  # json::parse returns the number 42 (not a string)
  let parsed   = json::parse("42")
  print parsed

  # Chained: int as json as text renders the JSON representation
  let chained  = n as json as text
  print chained
