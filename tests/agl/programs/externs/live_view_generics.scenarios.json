{
  "scenarios": [
    {
      "name": "reverse_sealed_text_handles_in_callers_live_array",
      "params": {"mode": "reverse_text"},
      "expect": {"stdout": "[\"three\", \"two\", \"one\"]\n"}
    },
    {
      "name": "rotate_sealed_record_handles_in_callers_live_array",
      "params": {"mode": "rotate_record"},
      "expect": {
        "stdout": "[Label(value = \"three\"), Label(value = \"one\"), Label(value = \"two\")]\n"
      }
    },
    {
      "name": "write_received_sealed_handle_back_at_same_type_variable",
      "params": {"mode": "duplicate_text"},
      "expect": {"stdout": "[\"three\", \"two\", \"three\"]\n"}
    },
    {
      "name": "reject_handle_from_another_type_variable_without_mutating_caller",
      "params": {"mode": "reject_other_type_variable"},
      "expect": {
        "stdout": "BoundaryTypeError\n[Label(value = \"one\"), Label(value = \"two\")]\n"
      }
    },
    {
      "name": "reject_plain_python_value_without_mutating_caller",
      "params": {"mode": "reject_plain_value"},
      "expect": {"stdout": "BoundaryTypeError\n[\"one\", \"two\"]\n"}
    },
    {
      "name": "sorting_sealed_handles_surfaces_python_type_error",
      "params": {"mode": "sort_sealed_handles"},
      "expect": {"stdout": "TypeError\n"}
    }
  ]
}
