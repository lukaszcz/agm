import std/option::Option
import std/pair::Pair

scope DictInternals
extern def size[V](self: dict[text, V]) -> int
extern def get[V](self: dict[text, V], key: text) -> V
extern def get_option[V](self: dict[text, V], key: text) -> Option[V]
extern def remove[V](self: dict[text, V], key: text) -> V
extern def set[V](self: dict[text, V], key: text, value: V) -> unit
extern def remove_option[V](self: dict[text, V], key: text) -> Option[V]
extern def contains[V](self: dict[text, V], key: text) -> bool
extern def clear[V](self: dict[text, V]) -> unit
extern def keys[V](self: dict[text, V]) -> array[text]
extern def values[V](self: dict[text, V]) -> array[V]
extern def entries[V](self: dict[text, V]) -> array[Pair[text, V]]
extern def merge[V](self: dict[text, V], other: dict[text, V]) -> dict[text, V]
extern def merge_in_place[V](self: dict[text, V], other: dict[text, V]) -> unit
extern def map_values[V, U](self: dict[text, V], function: (V) -> U) -> dict[text, U]
extern def filter[V](self: dict[text, V], predicate: (text, V) -> bool) -> dict[text, V]
extern def filter_in_place[V](self: dict[text, V], predicate: (text, V) -> bool) -> unit
extern def each[V](self: dict[text, V], function: (text, V) -> unit) -> unit
extern def from_entries[V](values: array[Pair[text, V]]) -> dict[text, V]
end DictInternals

def dict[text, V]::size(self) -> int = DictInternals::size(self)
def dict[text, V]::is-empty(self) -> bool = self.size() == 0
def dict[text, V]::get(self, key: text) -> V = DictInternals::get(self, key)
def dict[text, V]::get?(self, key: text) -> Option[V] = DictInternals::get_option(self, key)
def dict[text, V]::remove(self, key: text) -> V = DictInternals::remove(self, key)
def dict[text, V]::set(self, key: text, value: V) -> unit = DictInternals::set(self, key, value)
def dict[text, V]::remove?(self, key: text) -> Option[V] = DictInternals::remove_option(self, key)
def dict[text, V]::contains(self, key: text) -> bool = DictInternals::contains(self, key)
def dict[text, V]::clear(self) -> unit = DictInternals::clear(self)
def dict[text, V]::keys(self) -> array[text] = DictInternals::keys(self)
def dict[text, V]::values(self) -> array[V] = DictInternals::values(self)
def dict[text, V]::entries(self) -> array[Pair[text, V]] = DictInternals::entries(self)
def dict[text, V]::merge(self, other: dict[text, V]) -> dict[text, V] = DictInternals::merge(self, other)
def dict[text, V]::merge!(self, other: dict[text, V]) -> unit = DictInternals::merge_in_place(self, other)
def dict[text, V]::map-values[U](self, function: (V) -> U) -> dict[text, U] = DictInternals::map_values(self, function)
def dict[text, V]::filter(self, predicate: (text, V) -> bool) -> dict[text, V] = DictInternals::filter(self, predicate)
def dict[text, V]::filter!(self, predicate: (text, V) -> bool) -> unit = DictInternals::filter_in_place(self, predicate)
def dict[text, V]::each(self, function: (text, V) -> unit) -> unit = DictInternals::each(self, function)

def from-entries[V](values: array[Pair[text, V]]) -> dict[text, V] = DictInternals::from_entries(values)
