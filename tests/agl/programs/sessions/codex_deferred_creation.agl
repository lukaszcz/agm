# Codex creates its underlying thread only on its first session ask.

def report(error: SessionError) -> unit =
  print error.operation

program def main(reset-before-ask: bool) -> unit =
  let agent = AgentCodex("model", "high")
  let session = Session::open(agent)
  try
    let _ = Session::open(agent, name = "unsupported")
  catch SessionError as error => report(error)
  var compact-before: text = ""
  try
    session.compact()
  catch SessionError as error =>
    compact-before := error.message
    report(error)
  var fork-before: text = ""
  try
    let _ = session.fork()
  catch SessionError as error =>
    fork-before := error.message
    report(error)
  var set-name-before: text = ""
  try
    session.set-name("unsupported")
  catch SessionError as error =>
    set-name-before := error.message
    report(error)
  var stats-before: text = ""
  try
    let _ = session.stats()
  catch SessionError as error =>
    stats-before := error.message
    report(error)
  if reset-before-ask => session.reset()
  session.ask("create the thread")
  var compact-after: text = ""
  try
    session.compact()
  catch SessionError as error =>
    compact-after := error.message
    report(error)
  var fork-after: text = ""
  try
    let _ = session.fork()
  catch SessionError as error =>
    fork-after := error.message
    report(error)
  var set-name-after: text = ""
  try
    session.set-name("unsupported")
  catch SessionError as error =>
    set-name-after := error.message
    report(error)
  var stats-after: text = ""
  try
    let _ = session.stats()
  catch SessionError as error =>
    stats-after := error.message
    report(error)
  if compact-before != "" and compact-before == compact-after => print "compact-message"
  if fork-before != "" and fork-before == fork-after => print "fork-message"
  if set-name-before != "" and set-name-before == set-name-after => print "set-name-message"
  if stats-before != "" and stats-before == stats-after => print "stats-message"
  session.reset()
