# break targets only the INNERMOST enclosing loop.
# Inner loop breaks after one step; outer loop runs `n` times.

program def main(n: int) -> unit =
  var outer: int = 0
  var inner-sum: int = 0
  do
    outer := outer + 1
    var inner: int = 0
    do
      inner := inner + 1
      if inner >= 2 => break
    done
    inner-sum := inner-sum + inner
    if outer >= n => break
  done
  print outer
  print inner-sum
