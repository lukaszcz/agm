# Session::open's sandbox operand fixes a session's sandboxing for its whole
# lifetime: every accepted AgentSandbox shape, the .sandbox field reporting
# exactly what was passed, a later default-sandbox write never reaching an
# already-open session, and fork inheriting the parent's mode verbatim.
import std/config

def classify(mode: AgentSandbox) -> text =
  case mode of
    | Disabled => "disabled"
    | Native => "native"
    | Sandbox(memory, swap, settings, patch) =>
        "sandbox(%{memory}, %{swap}, %{settings}, %{patch})"

program def main(mode: text) -> unit =
  if
    | mode == "native" =>
        let session = Session::open(AgentCommand("impl"), sandbox = AgentSandbox::Native)
        print classify(session.sandbox)
    | mode == "disabled" =>
        let session = Session::open(AgentCommand("impl"), sandbox = AgentSandbox::Disabled)
        print classify(session.sandbox)
    | mode == "sandbox-default-fields" =>
        let session = Session::open(AgentCommand("impl"), sandbox = Sandbox)
        print classify(session.sandbox)
    | mode == "sandbox-explicit-fields" =>
        let session = Session::open(AgentCommand("impl"), sandbox = Sandbox(memory = Some("8G")))
        print classify(session.sandbox)
    | mode == "operand-survives-a-later-default-write" =>
        let session = Session::open(AgentCommand("impl"), sandbox = AgentSandbox::Native)
        std/config::default-sandbox := AgentSandbox::Disabled
        print classify(session.sandbox)
    | mode == "fork-inherits" =>
        let parent = Session::open(AgentClaude("model", "high"), sandbox = Sandbox(memory = Some("4G")))
        let child = parent.fork()
        print classify(parent.sandbox)
        print classify(child.sandbox)
    | else =>
        let session = Session::open(AgentCommand("impl"))
        print classify(session.sandbox)
