open import std/env

param mode: int

program def main() -> unit =
  case mode of
    | 1 =>
        print(getenv?("missing"))
        setenv("one", "1")
        print(getenv("one"))
        print(environ.contains("one"))
        unsetenv("one")
        print(getenv?("one"))
    | 2 =>
        setenv("base", "original")
        let extended = environ.extended({"base": "override", "extra": "value"})
        print(environ.get("base"))
        print(extended.get("base"))
        print(extended.get("extra"))
        print(environ.contains("extra"))
    | _ =>
        let _ = getenv("missing")
        ()
