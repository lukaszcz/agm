# A recursive enum crossing the Python FFI in both directions: `build_tree`
# constructs a nested Tree in the companion by calling the synthesized
# Tree.Leaf and Tree.Node classes imported from `agl`, and `sum_tree` consumes
# an AgL-built Tree in the companion by pattern-matching on those same
# variants. Recursion in `build_tree` terminates at n <= 0 with a Leaf.
enum Tree
  | Leaf(value: int)
  | Node(left: Tree, right: Tree)

extern def build_tree(n: int) -> Tree
extern def sum_tree(t: Tree) -> int

param n: int

program def main() -> unit =
  let built = build_tree(n)
  print sum_tree(built)

  let manual = Node(
    left = Leaf(value = 10),
    right = Node(left = Leaf(value = 20), right = Leaf(value = 30)),
  )
  print sum_tree(manual)
