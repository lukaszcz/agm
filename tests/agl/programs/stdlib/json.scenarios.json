{
  "scenarios": [
    {
      "name": "strict_object_parse_exposes_object_methods_and_optional_lookup",
      "params": {"mode": 1},
      "expect": {
        "stdout": "object\n2\n[\"name\", \"count\"]\ntrue\n2\nOption::None\n",
        "calls": {}
      }
    },
    {
      "name": "lenient_recovery_and_non_object_receivers_have_identity_results",
      "params": {"mode": 2},
      "expect": {
        "stdout": "array\n2\n[]\nfalse\nOption::None\nbool\n0\n[]\nfalse\nOption::None\n",
        "calls": {}
      }
    },
    {
      "name": "strict_failures_raise_or_return_none_while_lenient_parse_recovers",
      "params": {"mode": 3},
      "expect": {
        "stdout": "answer: 42\nnull\nOption::None\n42\nOption::None\n",
        "calls": {}
      }
    },
    {
      "name": "raising_object_lookup_reports_a_typed_key_error",
      "params": {"mode": 4},
      "expect": {"stdout": "missing\n", "calls": {}}
    },
    {
      "name": "raising_get_on_an_array_reports_a_typed_key_error",
      "params": {"mode": 5},
      "expect": {
        "stdout": "",
        "raises": {"type": "KeyError", "fields": {"key": "missing"}},
        "calls": {}
      }
    },
    {
      "name": "raising_get_on_a_scalar_reports_a_typed_key_error",
      "params": {"mode": 6},
      "expect": {
        "stdout": "",
        "raises": {"type": "KeyError", "fields": {"key": "missing"}},
        "calls": {}
      }
    },
    {
      "name": "strict_optional_parse_returns_some_for_valid_json",
      "params": {"mode": 7},
      "expect": {
        "stdout": "Option::Some(value = {\"answer\": 42})\n",
        "calls": {}
      }
    },
    {
      "name": "lenient_optional_parse_returns_some_for_recovered_json",
      "params": {"mode": 8},
      "expect": {
        "stdout": "Option::Some(value = [1, 2])\n",
        "calls": {}
      }
    },
    {
      "name": "optional_object_lookup_returns_some_for_a_present_key",
      "params": {"mode": 9},
      "expect": {
        "stdout": "Option::Some(value = \"agm\")\n",
        "calls": {}
      }
    },
    {
      "name": "kind_names_every_value_category_and_size_counts_only_containers",
      "params": {"mode": 10},
      "expect": {
        "stdout": "null\nbool\nint\ndecimal\ntext\narray\nobject\n0\n3\n2\n",
        "calls": {}
      }
    }
  ]
}
