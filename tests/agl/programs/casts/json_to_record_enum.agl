# json → record and json → enum casts: parse a JSON blob, then validate it
# into a typed structure using `as`. Covers successful and failed validation.
import std/json
record Config
  name: text
  timeout: int
  retries: int

enum Priority
  | Low
  | High(reason: text)

param config_json
param priority_json

# json → record parsing and cast

program def main() -> unit =
  try
    let j = json::parse(config_json)
    let cfg = j as Config
    print cfg.name
    print cfg.timeout
    print cfg.retries
  catch CastError as e =>
    print "config invalid: %{e.source_type} -> %{e.target_type}"
  catch JsonParseError as e =>
    print "config json error: %{e.raw}"

  # json → enum parsing and cast
  try
    let p_json = json::parse(priority_json)
    let p = p_json as Priority
    if p is Low =>
      print "priority: low"
    else =>
      case p of
        | High(reason) => print "priority: high (%{reason})"
        | Low          => ()
  catch CastError as e =>
    print "priority invalid: %{e.source_type} -> %{e.target_type}"
  catch JsonParseError as e =>
    print "priority json error: %{e.raw}"
