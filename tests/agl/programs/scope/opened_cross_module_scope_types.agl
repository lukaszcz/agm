# A `use` of a re-exported scope keeps its declaration origins and nested type paths.
import facade
use facade::Shapes::*

def inspect(point: Nested::Point) -> int = point.x + measure()
def unpack(box: Nested::Box[int]) -> int = box.value

program def main() -> unit =
  print inspect(Nested::Point(x = 4))
  print unpack(Nested::Box(value = 5))
