builtin
exception Exception
  @arg-named message: text

builtin
exception ExternError extends Exception
  function: text
  python-type: text

builtin
exception MaxIterationsExceeded extends Exception
  limit: int
  condition: text
  last-condition-value: bool
  metadata: json

builtin
exception MatchError extends Exception
  scrutinee-type: text
  scrutinee: json

builtin
exception IndexError extends Exception
  index: int
  length: int

builtin
exception KeyError extends Exception
  key: text

builtin
exception TypeError extends Exception

builtin
exception ArithmeticError extends Exception
  operation: text

builtin
exception UndefinedVariableError extends Exception
  name: text

builtin
exception ImmutableBindingError extends Exception
  name: text
  operation: text

builtin
exception Abort extends Exception

builtin
exception RecursionError extends Exception
  limit: int

builtin
exception CastError extends Exception
  source-type: text
  target-type: text
  raw: text

builtin
exception JsonParseError extends Exception
  raw: text

builtin
exception RangeError extends Exception

builtin
exception CyclicValueError extends Exception

builtin
exception ValueParseError extends Exception
  source-type: text
  target-type: text
  raw: text

# Host text (an OS path, name, or variable) was not valid Unicode; `raw` shows it with
# undecodable bytes escaped.
exception EncodingError extends Exception
  raw: text
