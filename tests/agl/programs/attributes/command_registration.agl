# A `program def` names the package command it registers as with `@command`.
# The registration describes the program to a package host; running the program
# is unaffected. `@doc` describes the program wherever it runs, and is the prose
# its registered command carries too.

@command("devel review")
@doc("Change review")
program def main(@arg-pos subject: text, strict: bool = false) -> unit =
  print "reviewing %{subject}"
  if strict => print "strict" else => ()
