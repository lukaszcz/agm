{
  "scenarios": [
    {
      "name": "lenient_unrepresentable_numbers_are_retried",
      "agents": {
        "meter": [
          "{\"n\": 1e99999999999999999999}",
          "{\"n\": 1.5}",
          "{\"n\": 1e999999999999}",
          "{\"n\": 3}",
          "{\"n\": NaN}",
          "{\"n\": 1}"
        ]
      },
      "expect": {
        "stdout": "1.5\n3\n{\"n\": 1}\n",
        "calls": {
          "meter": 6
        }
      }
    },
    {
      "name": "strict_unrepresentable_numbers_are_retried",
      "agents": {
        "meter": [
          "{\"n\": 1e99999999999999999999}",
          "{\"n\": 1.5}",
          "{\"n\": 1e999999999999}",
          "{\"n\": 3}",
          "{\"n\": NaN}",
          "{\"n\": 1}"
        ]
      },
      "runtime": {
        "default_strict_json": true
      },
      "expect": {
        "stdout": "1.5\n3\n{\"n\": 1}\n",
        "calls": {
          "meter": 6
        }
      }
    },
    {
      "name": "lenient_over_long_integer_is_exact_and_infinity_is_retried",
      "agents": {
        "meter": [
          "{\"n\": 1.5}",
          "{\"n\": }",
          "{\"n\": Infinity}",
          "{\"n\": 1}"
        ]
      },
      "expect": {
        "stdout": "1.5\\n{\"n\": 1}\n",
        "calls": {
          "meter": 4
        }
      }
    },
    {
      "name": "strict_over_long_integer_is_exact_and_infinity_is_retried",
      "agents": {
        "meter": [
          "{\"n\": 1.5}",
          "{\"n\": }",
          "{\"n\": Infinity}",
          "{\"n\": 1}"
        ]
      },
      "runtime": {
        "default_strict_json": true
      },
      "expect": {
        "stdout": "1.5\\n{\"n\": 1}\n",
        "calls": {
          "meter": 4
        }
      }
    },
    {
      "name": "exhausted_retries_raise_agent_parse_error",
      "agents": {
        "meter": [
          "{\"n\": 1e99999999999999999999}",
          "{\"n\": -Infinity}"
        ]
      },
      "expect": {
        "stdout": "",
        "calls": {
          "meter": 2
        },
        "raises": {
          "type": "AgentParseError"
        }
      }
    }
  ]
}
