# AgentParseError carries the documented diagnostic fields, usable in follow-up
# prompts.
record Spec
  name: text
  level: int

program def main() -> unit =
  let builder: Agent = AgentCommand("builder")
  let critic: Agent = AgentCommand("critic")
  try
    let s: Spec = builder.ask("Build the spec.", on-parse-error = Retry(n = 1))
    print s.name
  catch AgentParseError as e =>
    let advice = critic.ask("""
    Agent %{e.agent} failed for type %{e.target-type} after %{e.attempts} attempts.

    Raw:
    %{e.raw}

    Errors:
    %{e.validation-errors}

    Schema:
    %{e.expected-schema}
    """)
    print "advised"
    raise e
