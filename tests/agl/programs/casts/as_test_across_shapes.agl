# `as?` predicts whether the corresponding `as` would succeed. Only a value
# that actually holds a reference cycle tests `false`: scalars, nominals,
# enums, and generic instantiations — including one whose type argument is an
# array — all test `true`, whether or not a cycle exists elsewhere in the
# program.
param close_cycle: bool

record Scalar(value: int)
record Box[T]
  value: T
record Node(children: array[Node])

enum Tree
  | leaf
  | branch(next: Tree)

def succeeds[T](value: Option[T]) -> bool =
  case value of
    | Some(_) => true
    | None => false

program def main() -> unit =
  let scalar = Scalar(value = 1)
  let tree = leaf
  let boxed_int: Box[int] = Box(value = 1)
  let boxed_array: Box[array[int]] = Box(value = [1])
  var nodes: array[Node] = [Node(children = [])]
  let node = Node(children = nodes)
  if close_cycle =>
    nodes[0] := node

  print(succeeds(1 as? text))
  print(succeeds(1 as? json))
  print(succeeds(scalar as? text))
  print(succeeds(scalar as? json))
  print(succeeds(tree as? text))
  print(succeeds(tree as? json))
  print(succeeds(boxed_int as? text))
  print(succeeds(boxed_int as? json))
  print(succeeds(boxed_array as? text))
  print(succeeds(boxed_array as? json))
  print(succeeds(node as? text))
  print(succeeds(node as? json))
