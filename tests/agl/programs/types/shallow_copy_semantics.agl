# shallow-copy detaches exactly the top-level container: mutating the copy's
# own slot does not touch the original, but mutating a nested container
# reached THROUGH the copy is visible through the original, because the
# nested container is the same shared object.

program def main(first: int, second: int, third: int) -> unit =
  var inner = [first, second]
  var outer = [inner]
  let copied = shallow-copy(outer)

  copied[0][0] := 99
  print(outer)
  print(copied)

  outer[0] := [third]
  print(outer)
  print(copied)
