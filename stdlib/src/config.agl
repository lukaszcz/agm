import std/agent::Agent
import std/option::Option
import std/path::path

builtin var default-agent: Agent = AgentClaude("sonnet", "medium")
builtin var log: bool = false
builtin var log-file: Option[path] = None
builtin var strict-json: bool = false
builtin var max-iters: int = 0
builtin var timeout: Option[text] = None
