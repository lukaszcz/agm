import std/option::Option

enum Either[A, B] =
  | Left(value: A)
  | Right(value: B)

@doc("Apply the function to a `Left` value, preserving a `Right`.")
def Either::map-left[A, B, C](self, f: (A) -> C) -> Either[C, B] =
  case self of
    | Left(value) => Left(f(value))
    | Right(value) => Right(value)

@doc("Apply the function to a `Right` value, preserving a `Left`.")
def Either::map-right[A, B, C](self, f: (B) -> C) -> Either[A, C] =
  case self of
    | Left(value) => Left(value)
    | Right(value) => Right(f(value))

@doc("Return whether this value is `Left`.")
def Either::is-left[A, B](self) -> bool =
  case self of
    | Left(_) => true
    | Right(_) => false

@doc("Return whether this value is `Right`.")
def Either::is-right[A, B](self) -> bool = not self.is-left()

@doc("Return the `Left` value as an option, or `None` for a `Right`.")
def Either::left[A, B](self) -> Option[A] =
  case self of
    | Left(value) => Some(value)
    | Right(_) => None

@doc("Return the `Right` value as an option, or `None` for a `Left`.")
def Either::right[A, B](self) -> Option[B] =
  case self of
    | Left(_) => None
    | Right(value) => Some(value)

@doc("Exchange the `Left` and `Right` variants, preserving the value.")
def Either::swap[A, B](self) -> Either[B, A] =
  case self of
    | Left(value) => Right(value)
    | Right(value) => Left(value)
