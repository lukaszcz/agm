# Program arguments: each parameter's declared type is validated at the host
# boundary, `text` verbatim and every other type as JSON.

program def main(topic: text, rounds: int, ratio: decimal, flag: bool, meta: json) -> unit =
  print topic
  print rounds
  print ratio
  print flag
  print meta
  let summary = ask "Summarize %{topic} in %{rounds} rounds (ratio %{ratio}, flag %{flag})."
  print summary
