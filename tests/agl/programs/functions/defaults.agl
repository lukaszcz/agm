# Optional arguments via default values; named-argument calls.

def tag-text(text-val: text, prefix: text = "INFO", suffix: text = "") -> text =
  "[" ++ prefix ++ "] " ++ text-val ++ suffix

# Called with only required arg — both defaults apply.

program def main(msg: text) -> unit =
  print(tag-text(msg))

  # Override just prefix by name.
  print(tag-text(msg, prefix = "WARN"))

  # Override both optional args by name.
  print(tag-text(msg, prefix = "ERR", suffix = "!"))

  # Fixed text, explicit prefix only.
  print(tag-text("done", prefix = "OK"))
