# Casts inside user-defined function bodies and with agent-supplied text.
# Demonstrates: a boolean `as?` condition inside a def, cast in a recursive helper, and casting
# an agent's text response to a typed record.
record Task
  title: text
  effort: int

def parse-int-or-zero(s: text) -> int =
  if s as? int => s as int else => 0

# A helper that doubles a numeric text value
def double-text-int(s: text) -> text =
  let n = parse-int-or-zero(s)
  (n * 2) as text

program def main(a: text, b: text) -> unit =
  let planner: Agent = AgentCommand("planner")
  # A helper that converts a text to int, returning 0 on failure
  print(parse-int-or-zero(a))
  print(double-text-int(b))

  # Agent supplies a JSON text; cast it to a record
  try
    let raw: text = planner.ask("Return a task.")
    let task = raw as Task
    print task.title
    print task.effort
  catch CastError as e =>
    print "task cast failed: %{e.source-type} -> %{e.target-type}"
