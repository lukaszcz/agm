# `decimal as int`: succeeds only when the decimal has no fractional part;
# raises CastError otherwise.  The CastError carries source-type="decimal",
# target-type="int", and raw=the original decimal value.

program def main(d: decimal) -> unit =
  try
    let i = d as int
    print "ok: %{i}"
    print "next: %{i + 1}"
  catch CastError as e =>
    print "not integral: %{e.raw}"
    print e.source-type
    print e.target-type
