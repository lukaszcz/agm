# The iterator holds the array by reference, not a snapshot, so mutating an
# element still ahead of the cursor changes what the loop sees when it gets
# there; mutating an element the cursor has already passed does not change
# the sum, even though the array itself still ends up mutated.
param trigger: int

var xs = [1, 2, 3, 4]
var total = 0
var i = 0
for x in xs do
  if i == trigger => xs[3] := 100
  total := total + x
  i := i + 1
done
print total
print xs
