# The dialogue loop: typed mutable state driven by two agents.
enum Turn
  | Continue(message: text)
  | Done(answer: text)

program def main(problem: text) -> unit =
  let researcher: Agent = AgentCommand("researcher")
  let critic: Agent = AgentCommand("critic")
  var proposal: Turn = ask("Propose a solution for %{problem}.", agent = researcher, parse-error-retries = 2)
  var final-answer: text = ""

  do[6]
    case proposal of
      | Continue(message) =>
          let critique: Turn = ask("Critique this proposal:\n%{message}", agent = critic, parse-error-retries = 2)
          proposal := ask("Revise using critique:\n%{critique}", agent = researcher, parse-error-retries = 2)

      | _ => ()

  until proposal is Done

  case proposal of
    | Done(answer) =>
        final-answer := answer
    | _ => ()

  print final-answer
