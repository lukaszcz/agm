{
  "scenarios": [
    {
      "name": "inline_text_and_markdown_review_use_default_agent",
      "params": {"document": "release notes"},
      "agents": {
        "ask": [
          "Concise summary",
          "{\"approved\": true, \"summary\": \"Looks good\"}",
          "{\"approved\": false, \"summary\": \"Call-form feedback\"}"
        ],
        "reviewer": ["{\"approved\": false, \"summary\": \"Explicit feedback\"}"]
      },
      "expect": {
        "stdout": "Concise summary\nExplicit feedback\ntrue\nfalse\n",
        "calls": {"ask": 3, "reviewer": 1},
        "prompts": [
          {"agent": "ask", "call": 0, "equals": "Summarize release notes in one line."},
          {
            "agent": "reviewer",
            "call": 0,
            "equals": "Explicit review for release notes.",
            "schema_contains": ["approved", "summary"]
          },
          {
            "agent": "ask",
            "call": 1,
            "equals": "# Review release notes\n- correctness\n- style",
            "schema_contains": ["approved", "summary"]
          },
          {
            "agent": "ask",
            "call": 2,
            "equals": "Call-form review for release notes.",
            "schema_contains": ["approved", "summary"]
          }
        ]
      }
    },
    {
      "name": "typed_raw_and_call_form_parse_failures_stay_on_default_agent",
      "params": {"document": "migration guide"},
      "agents": {
        "ask": ["Guide summary", "not a review", "still not a review"],
        "reviewer": ["{\"approved\": true, \"summary\": \"Explicit pass\"}"]
      },
      "expect": {
        "stdout": "Guide summary\nExplicit pass\nraw ask 1 Review\ncall ask 1 Review\n",
        "calls": {"ask": 3, "reviewer": 1},
        "prompts": [
          {"agent": "ask", "call": 0, "equals": "Summarize migration guide in one line."},
          {"agent": "reviewer", "call": 0, "equals": "Explicit review for migration guide."},
          {
            "agent": "ask",
            "call": 1,
            "equals": "# Review migration guide\n- correctness\n- style",
            "schema_contains": ["approved", "summary"]
          },
          {
            "agent": "ask",
            "call": 2,
            "equals": "Call-form review for migration guide.",
            "schema_contains": ["approved", "summary"]
          }
        ]
      }
    }
  ]
}
