# The dialogue loop: typed mutable state driven by two agents.
enum Turn
  | Continue(message: text)
  | Done(answer: text)

param problem

program def main() -> unit =
  let researcher = AgentCommand("researcher")
  let critic = AgentCommand("critic")
  var proposal: Turn = researcher.ask("Propose a solution for %{problem}.", on_parse_error = Retry(n = 2))
  var final_answer: text = ""

  do[6]
    case proposal of
      | Continue(message) =>
          let critique: Turn = critic.ask("Critique this proposal:\n%{message}", on_parse_error = Retry(n = 2))
          proposal := researcher.ask("Revise using critique:\n%{critique}", on_parse_error = Retry(n = 2))

      | _ => ()

  until proposal is Done

  case proposal of
    | Done(answer) =>
        final_answer := answer
    | _ => ()

  print final_answer
