# json values, null, literal shorthand vs quoted keys, empty literals with
# annotations, typed agent targets for every built-in.

program def main(payload: json) -> unit =
  let source: Agent = AgentCommand("source")
  let empty-array: array[text] = []
  let empty-map: dict[text, json] = {}
  print empty-array
  print empty-map

  let document: json = {
    "quoted": 1,
    shorthand: [true, false, null],
    nested: {inner: ["x", 2.5]},
  }
  print document

  let fetched: json = source.ask("Emit a JSON document about %{payload}.")
  print fetched

  let n: int = source.ask("Emit a count.")
  let d: decimal = source.ask("Emit a ratio.")
  let flag: bool = source.ask("Emit a flag.")
  let names: array[text] = source.ask("Emit names.")
  let scores: dict[text, int] = source.ask("Emit scores.")
  print n
  print d
  print flag
  print names
  print scores
