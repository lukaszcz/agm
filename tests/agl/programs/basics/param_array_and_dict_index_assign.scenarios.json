{
  "scenarios": [
    {
      "name": "positive_pair",
      "params": {"xs": [1, 2], "counts": {"first": 1, "second": 2}},
      "expect": {"stdout": "[0, 2]\n0\n2\n"}
    },
    {
      "name": "negative_pair",
      "params": {"xs": [9, -3], "counts": {"first": 9, "second": -3}},
      "expect": {"stdout": "[0, -3]\n0\n-3\n"}
    }
  ]
}
