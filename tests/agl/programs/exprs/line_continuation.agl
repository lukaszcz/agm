# Line continuation: a line break between an operator and its operand joins the
# lines, whether the operator ends the line or opens a more indented one.

record Point(x: int, y: int)

program def main(a: int, b: int, tag: text) -> unit =
  let values = [a, b, a + b]

  # The operator ends the line; the continuation may sit at any indentation.
  let piped = values.map(fn v => v + 1) |>
  .fold(0, fn (total, v) => total + v)
  let sum = a +
      b
  let flags = a > 0 and
    b > 0

  # The operator opens a more indented line.
  let chained = values
    .filter(fn v => v > 0)
    .map(fn v => v * 2)
    |> .fold(0, fn (total, v) => total + v)
  let label = tag
    ++ "/"
    ++ (if flags => "both" | else => "mixed")
  let shifted = Point(x = a, y = b)
    with x = a - 1, y = b +
    1

  print piped
  print sum
  print flags
  print chained
  print label
  print shifted.x
  print shifted.y

  # A block's own item still stands alone at the block's level.
  let negate = fn (p: Point) => 0 - p.x
  print (negate(shifted))
