# Built-in record and enum payload fields follow the standard default.

program def main(exit-code: int, command: text) -> unit =
  let result = ExecResult("out", exit-code, "err", false)
  let agent: Agent = AgentCommand(command)

  print result.stdout
  print result.exit-code
  case agent of
    | AgentCommand(command) => print command
    | _ => print "other"
