{
  "scenarios": [
    {
      "name": "most_specific_handler_wins_over_its_own_ancestor",
      "params": {
        "mode": "most-specific-first"
      },
      "expect": {
        "stdout": "detailed: d\n"
      }
    },
    {
      "name": "base_handler_catches_a_multi_level_descendant",
      "params": {
        "mode": "base-catches-descendant"
      },
      "expect": {
        "stdout": "caught by base: 2\n"
      }
    },
    {
      "name": "sibling_falls_through_to_wildcard",
      "params": {
        "mode": "sibling-falls-to-wildcard"
      },
      "expect": {
        "stdout": "fell through: m\n"
      }
    },
    {
      "name": "reraise_from_a_base_handler_is_caught_by_the_outer_handler",
      "params": {
        "mode": "reraise-caught-by-outer"
      },
      "expect": {
        "stdout": "outer caught: d\n"
      }
    },
    {
      "name": "handler_for_exception_declared_without_extends_catches_its_descendant",
      "params": {
        "mode": "no-extends-catches-own-descendant"
      },
      "expect": {
        "stdout": "root caught: n\n"
      }
    },
    {
      "name": "handler_for_exception_declared_without_extends_is_not_a_catch_all",
      "params": {
        "mode": "no-extends-does-not-catch-unrelated"
      },
      "expect": {
        "stdout": "fell through: m\n"
      }
    }
  ]
}
