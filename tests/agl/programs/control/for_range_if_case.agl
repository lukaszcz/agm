# Range for with if in the body: conditional logic using the loop variable.
# Exercises: if expression in range for body, loop variable in condition.

program def main(threshold: int, n: int) -> unit =
  var above: int = 0
  var at-or-below: int = 0
  for i in 1 to n do
    if i > threshold =>
      above := above + 1
    else =>
      at-or-below := at-or-below + 1
  done
  print above
  print at-or-below
