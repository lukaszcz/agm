# Scoped declarations cross the complete execution boundary: linked calls,
# opened members, recursive agent decoding, and enum variants.
open Workflow
open Workflow::Status

scope Workflow
record Task
  name: text
  children: list[Task]
agent reviewer = "reviewer"
end Workflow

enum Workflow::Status
  | waiting
  | completed

def Workflow::score(task: Workflow::Task) -> bool = task.children[0].name == "ready"
def Workflow::Status::label(status: Workflow::Status) -> text =
  case status of
    | Workflow::Status::waiting => "waiting"
    | Workflow::Status::completed => "completed"

let task: Task = ask("Return a recursive task.", agent = reviewer)
let status: Status = ask("Return a workflow status.", agent = reviewer)
print(score(task))
print(label(status))
print(status is completed)
