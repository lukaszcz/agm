# Named-argument holes bind to the named parameter, including named-only params.
var default-ticks = 0

def next-default() -> int =
  default-ticks := default-ticks + 1
  default-ticks

def shaped(x: int, *, y: int, z: int = next-default()) -> int = x * 100 + y * 10 + z

def named-only(*, left: int, right: int = next-default()) -> int = left * 10 + right

program def main(mode: text, base: int) -> unit =
  if
    | mode == "named" =>
        let fill-y = shaped(base, y = ?, z = 9)
        let fill-x = shaped(x = ?, y = base, z = 8)
        print(fill-y(4))
        print(fill-x(3))
    | mode == "defaults" =>
        let with-default = shaped(x = ?, y = base)
        print(with-default(2))
        print(with-default(2))
        print(default-ticks)
    | else =>
        let left-open = named-only(left = ?)
        let right-open = named-only(left = base, right = ?)
        print(left-open(6))
        print(right-open(7))
        print(default-ticks)
