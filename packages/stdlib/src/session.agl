import std/agent::{Agent, AgentSandbox}
import std/config
import std/env::Environ
import std/errors::Exception
import std/option::Option

builtin
enum SessionTransport
  | Cli
  | Rpc

builtin record Session
  id: text
  agent: Agent
  transport: SessionTransport
  sandbox: AgentSandbox

builtin record SessionStats
  input-tokens: int
  output-tokens: int
  cost: decimal
  context-percent: decimal

builtin exception SessionError extends Exception
  operation: text

@doc("""
  Open an agent session with the requested transport and settings.

  Raises `SessionError` when the session cannot be opened.
""")
builtin def Session::open(
  agent: Agent,
  transport: Option[SessionTransport] = None,
  name: text = "",
  sandbox: AgentSandbox = std/config::default-sandbox,
  env: Environ = std/env::environ,
) -> Session

@doc("""
  Return the host's default session, creating it on first use.

  Uses the configured default agent and sandbox. Raises `SessionError` when the session is
  unavailable.
""")
builtin def Session::default() -> Session

@doc("""
  Ask the session's agent and parse its response as the requested type.

  Raises `SessionError` for an unavailable session, `AgentCallError` on invocation failure, or
  `AgentParseError` after parsing retries are exhausted.
""")
builtin def Session::ask[T](
  self,
  prompt: text,
  format: text = "",
  strict-json: bool = false,
  parse-error-retries: int = std/config::parse-error-retries,
) -> T

@doc("""
  Compact the session's conversation using the optional instructions.

  Raises `SessionError` when compaction fails or is unsupported.
""")
builtin def Session::compact(self, instructions: text = "") -> unit

@doc("""
  Clear the session's conversation.

  Raises `SessionError` when resetting fails or is unsupported.
""")
builtin def Session::reset(self) -> unit

@doc("""
  Create a new session from the current conversation.

  Raises `SessionError` when forking fails or is unsupported.
""")
builtin def Session::fork(self) -> Session

@doc("""
  Return the session's token usage, cost, and context usage.

  Raises `SessionError` when statistics are unavailable.
""")
builtin def Session::stats(self) -> SessionStats

@doc("""
  Set the session's display name.

  Raises `SessionError` when renaming fails or is unsupported.
""")
builtin def Session::set-name(self, name: text) -> unit

@doc("""
  Close the agent session.

  Raises `SessionError` when the session cannot be closed.
""")
builtin def Session::close(self) -> unit
