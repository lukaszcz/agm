# Bounds and step are evaluated exactly once at loop entry.
# Mutating the vars they reference from inside the body does not change iteration count.
# Exercises: single-evaluation of bounds and step at loop entry, ascending and descending.

program def main(down-start: int = 10, down-stop: int = 5, down-step: int = 2) -> unit =
  var end-val: int = 5
  var step-val: int = 1
  var count: int = 0

  for i in 1 to end-val step step-val do
    count := count + 1
    end-val := end-val + 100
    step-val := step-val + 100
  done
  print count
  print end-val

  var stop-var: int = down-stop
  var step-var: int = down-step
  var count2: int = 0
  for i in down-start downto stop-var step step-var do
    count2 := count2 + 1
    step-var := step-var + 100
  done
  print count2
