# Built-in record and enum payload fields follow the standard default.

program def main(exit-code: int, retries: int) -> unit =
  let result = ExecResult("out", exit-code, "err", false)
  let policy: ParsePolicy = ParsePolicy::Retry(retries)

  print result.stdout
  print result.exit-code
  case policy of
    | ParsePolicy::Retry(n) => print n
    | ParsePolicy::Abort => print 0
