# Methods can update mutable fields through their `self` receiver, and every
# alias observes both updates.
record Counter
  var value: int
  var label: text

def Counter::add(self, amount: int) -> unit =
  self.value := self.value + amount

def Counter::rename(self, label: text) -> unit =
  self.label := label

program def main(initial: int, amount: int, label: text) -> unit =
  let counter = Counter(value = initial, label = "before")
  let alias = counter
  counter.add(amount)
  alias.rename(label)
  print(counter.value)
  print(alias.value)
  print(counter.label)
  print(alias.label)
