import std/config
import std/errors::Exception
import std/option::Option

builtin
enum ParsePolicy =
  | Abort
  | Retry(n: int)

builtin
enum Agent
  | AgentCommand(command: text)
  | AgentClaude(model: text, thinking: text)
  | AgentCodex(model: text, thinking: text)
  | AgentPi(provider: text, model: text, thinking: text)

builtin
record AgentRequest
  agent: Agent
  prompt: text
  target-type: Option[text]
  format-instructions: Option[text]
  json-schema: Option[json]
  attempt: int
  previous-error: Option[text]
  metadata: json

builtin
exception AgentCallError extends Exception
  agent: Agent
  cause: text
  metadata: json

builtin
exception AgentParseError extends Exception
  agent: Agent
  target-type: text
  expected-schema: json
  raw: text
  normalized-raw: text
  validation-errors: json
  attempts: int
  metadata: json

builtin def ask[T](
  prompt: text,
  agent: Agent = std/config::default-agent,
  format: text = "",
  strict-json: bool = false,
  on-parse-error: ParsePolicy = ParsePolicy::Abort,
) -> T
builtin def Agent::ask[T](
  self,
  prompt: text,
  format: text = "",
  strict-json: bool = false,
  on-parse-error: ParsePolicy = ParsePolicy::Abort,
) -> T
builtin def Agent::ask-request[T](
  self,
  prompt: text,
  format: text = "",
  strict-json: bool = false,
  on-parse-error: ParsePolicy = ParsePolicy::Abort,
) -> AgentRequest
builtin def ask-request[T](
  prompt: text,
  agent: Agent = std/config::default-agent,
  format: text = "",
  strict-json: bool = false,
  on-parse-error: ParsePolicy = ParsePolicy::Abort,
) -> AgentRequest
