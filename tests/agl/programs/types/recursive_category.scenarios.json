{
  "scenarios": [
    {
      "name": "with_grandchild",
      "params": {
        "root-name": "root",
        "child-name": "child",
        "include-grandchild": true
      },
      "expect": {
        "stdout": "3\nroot > child > leaf\n1\nempty\n"
      }
    },
    {
      "name": "without_grandchild",
      "params": {
        "root-name": "root",
        "child-name": "child",
        "include-grandchild": false
      },
      "expect": {
        "stdout": "2\nroot > child\n1\nempty\n"
      }
    },
    {
      "name": "different_names",
      "params": {
        "root-name": "electronics",
        "child-name": "phones",
        "include-grandchild": true
      },
      "expect": {
        "stdout": "3\nelectronics > phones > leaf\n1\nempty\n"
      }
    }
  ]
}
