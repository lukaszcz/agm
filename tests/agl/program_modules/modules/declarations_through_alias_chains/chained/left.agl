# Library module forming a cyclic import with `right`. Its aliases chain:
# each names the one before, the last reaching `right`'s own record. Methods
# are declared at their records' own paths; what it declares beneath
# `right`'s aliases stands at the path written.
import right::*

record Base
  x: int

type L0 = Base

type L1 = L0

type L3 = L1

type L4 = Other

type L5 = L4

def Base::l0(self) -> int = self.x

def Base::l1(self) -> int = L0::l0(self) + 1

def Base::l3(self) -> int = L1::l1(self) + 1

def Other::o5(self) -> int = self.y * 2

def Rt0::Deep::first() -> int = 10

def Base::Deep::lower() -> int = Rt2::Deep::upper() + 1

record Rt1::Deep::Pair
  a: int
  b: int
