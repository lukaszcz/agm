# Canonical import surface: qualified routes, bare-tail injection, aliases,
# hiding, distributed wildcards, use declarations, and forwarded export forms.
import num/arith hiding mul
import num/arith::* hiding mul
import num/stats as st
import text/format::{label, shout as yell}
import text/format::label
import lib/*::* hiding shared
import lib/*::{shared}
import lib/* hiding shared
import lib/* as L
import num/facade
use num/arith as Arith
use num/arith::Operations::*
use Local::*

scope Local
  def scope_value() -> int = 99
end Local

def tag() -> int = 7

def bump(tag: int) -> int = tag + ::tag()

program def main(x: int, y: int) -> unit =
  print(label("sum", add(x, y)))
  print(yell("go"))
  print(st::max2(x, y) as text)
  print(st::min2(x, y) as text)
  print(via_secret(x) as text)
  print(L::alpha())
  print(L::beta())
  print(difference(y, x) as text)
  print(scope_value() as text)
  print(Arith::add(x, y) as text)
  print(num/arith::add(x, y) as text)
  print(num/facade::plus(x, y) as text)
  print(num/facade::max2(x, y) as text)
  print(bump(x) as text)
