# Standard core constructor names (exception types like `Abort` and records
# like `ExecResult`/`AgentRequest`) are conveniences that a
# user declaration at the program scope may shadow — they are not reserved
# keywords. A `let` shadows the constructor binding for a value, and a `def`
# shadows it for a function, both without an "already declared" collision.

# `let` shadows the built-in `ExecResult` standard-library record constructor.
def Retry(x: int) -> int = x + 1

program def main(n: int) -> unit =
  let ExecResult = n * 2
  print "%{ExecResult}"

  # `let` shadows the built-in `AgentRequest` standard-library record constructor.
  let AgentRequest = "req-%{n}"
  print AgentRequest

  # `def` shadows the built-in `Retry` exception constructor.
  print "%{Retry(n)}"
