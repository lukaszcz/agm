# Regression: a diamond-shared enum tree built by repeatedly wrapping the
# current value in both fields of a new node (`t := Pair(a = t, b = t)`)
# shares one object from two sibling positions at every level. Comparing
# such a value to itself must stay cheap regardless of depth: the identity
# fast path in `values_equal` recognizes the self-comparison (and every
# shared subtree the comparison recurses into) without re-walking it.
# Without that fast path this is exponential in depth -- each extra level
# doubles the walk -- so this program pins the fix at a depth where the
# unfixed relation would be intractably slow.
enum T
  | Leaf
  | Pair(a: T, b: T)

var t: T = Leaf()
for i in 1 to 32 do
  t := Pair(a = t, b = t)
done

print(t == t)
