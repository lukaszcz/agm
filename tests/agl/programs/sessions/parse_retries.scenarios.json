{
  "scenarios": [
    {
      "name": "retry_uses_corrective_follow_up_in_the_open_session",
      "agents": {
        "writer": {
          "responses": [
            "{\"total\": {\"response_derived_key\": 12}}",
            "{\"total\": {\"amount\": 12}}",
            "the total"
          ]
        }
      },
      "expect": {
        "stdout": "12\nthe total\n",
        "calls": {"writer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "opened": true, "closed": true}
        ],
        "session_prompts": [
          {
            "agent": "writer",
            "session": "session-1",
            "call": 0,
            "starts_with": "calculate the total",
            "contains": ["JSON Schema"]
          },
          {
            "agent": "writer",
            "session": "session-1",
            "call": 1,
            "follow_up": {
              "contains": ["Validation errors:", "Return only valid JSON matching the schema."],
              "not_contains": [
                "calculate the total",
                "response_derived_key",
                "$.total"
              ]
            }
          },
          {
            "agent": "writer",
            "session": "session-1",
            "call": 2,
            "equals": "what should you remember?"
          }
        ]
      }
    },
    {
      "name": "retry_exhaustion_raises_after_every_corrective_follow_up",
      "agents": {"writer": {"responses": ["bad", "still bad", "again bad"]}},
      "expect": {
        "calls": {"writer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "opened": true, "closed": true}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "starts_with": "calculate the total"},
          {
            "agent": "writer",
            "session": "session-1",
            "call": 1,
            "follow_up": {
              "contains": ["Validation errors:", "Return only valid JSON matching the schema."],
              "not_contains": ["calculate the total", "bad"]
            }
          },
          {
            "agent": "writer",
            "session": "session-1",
            "call": 2,
            "follow_up": {
              "contains": ["Validation errors:", "Return only valid JSON matching the schema."],
              "not_contains": ["calculate the total", "still bad"]
            }
          }
        ],
        "raises": {"type": "AgentParseError", "fields": {"attempts": 3}}
      }
    }
  ]
}
