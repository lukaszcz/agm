{
  "scenarios": [
    {
      "name": "decodes_completed_status_and_recursive_task",
      "agents": {
        "reviewer": [
          "{\"name\": \"root\", \"children\": [{\"name\": \"ready\", \"children\": []}]}",
          "{\"$case\": \"completed\"}"
        ]
      },
      "expect": {
        "stdout": "true\ncompleted\ntrue\n",
        "calls": {"reviewer": 2},
        "prompts": [
          {
            "agent": "reviewer",
            "call": 0,
            "schema_paths": [
              {"path": ["$ref"], "equals": "#/$defs/Workflow_Task"},
              {
                "path": [
                  "$defs", "Workflow_Task", "properties", "children", "items", "$ref"
                ],
                "equals": "#/$defs/Workflow_Task"
              }
            ]
          },
          {
            "agent": "reviewer",
            "call": 1,
            "schema_contains": ["oneOf", "$case", "waiting", "completed"]
          }
        ]
      }
    },
    {
      "name": "decodes_waiting_status_and_nonmatching_task",
      "agents": {
        "reviewer": [
          "{\"name\": \"root\", \"children\": [{\"name\": \"later\", \"children\": []}]}",
          "{\"$case\": \"waiting\"}"
        ]
      },
      "expect": {
        "stdout": "false\nwaiting\nfalse\n",
        "calls": {"reviewer": 2},
        "prompts": [
          {
            "agent": "reviewer",
            "call": 0,
            "schema_paths": [
              {"path": ["$ref"], "equals": "#/$defs/Workflow_Task"},
              {
                "path": [
                  "$defs", "Workflow_Task", "properties", "children", "items", "$ref"
                ],
                "equals": "#/$defs/Workflow_Task"
              }
            ]
          },
          {
            "agent": "reviewer",
            "call": 1,
            "schema_contains": ["oneOf", "$case", "waiting", "completed"]
          }
        ]
      }
    }
  ]
}
