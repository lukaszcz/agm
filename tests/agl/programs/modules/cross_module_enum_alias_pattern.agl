# A pattern qualified through a cross-module type alias whose target is an
# enum (`lib/aliasmod::Local` aliases `pal/colors::Palette`). The alias
# selects members of the enum its own module resolves it to, and the pattern
# must still select the variant actually written (`Red`/`Green`).
import pal/colors
import lib/aliasmod

program def main(red: bool) -> unit =
  let p: pal/colors::Palette = if red => pal/colors::Palette::Red else => pal/colors::Palette::Green
  case p of
    | lib/aliasmod::Local::Red => print "red"
    | lib/aliasmod::Local::Green => print "green"
