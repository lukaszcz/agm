# copy/shallow-copy through records, enums, exceptions, and a generic
# container (dict[text, array[int]]); copy detaches every array field,
# shallow-copy shares it. Both are identity on primitives.

record Box(items: array[int])

enum Bag
  | Full(items: array[int])

exception Batch extends Exception
  items: array[int]

program def main(x: int) -> unit =
  var b = Box(items = [x, x + 1])
  let deep-box = copy(b)
  let shallow-box = shallow-copy(b)
  deep-box.items[0] := -1
  shallow-box.items[0] := -2
  print(b.items)
  print(deep-box.items)
  print(shallow-box.items)

  var bag: Bag = Full(items = [x])
  let deep-bag = copy(bag)
  case deep-bag of
    | Full(items) => items[0] := -1
  case bag of
    | Full(items) => print(items)

  try
    raise Batch(message = "boom", items = [x])
  catch Batch as e =>
    let deep-exc = copy(e)
    deep-exc.items[0] := -1
    print(e.items)
    print(deep-exc.items)

  var groups: dict[text, array[int]] = {"a": [x, x + 1]}
  let copied-groups = copy(groups)
  copied-groups["a"][0] := -1
  print(groups["a"])
  print(copied-groups["a"])

  print(copy(x))
  print(shallow-copy(true))
  print(copy("hi"))
