# A program parameter forbids rebinding the parameter itself, not mutating the
# container it is bound to: an indexed assignment through a parameter-bound
# array or dict is legal, exactly like through a `let` or `var` binding.

program def main(xs: array[int], counts: dict[text, int]) -> unit =
  xs[0] := 0
  counts["first"] := 0

  print(xs)
  print(counts["first"])
  print(counts["second"])
