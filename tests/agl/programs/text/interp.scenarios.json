{
  "scenarios": [
    {
      "name": "interpolates_single_multiple_adjacent_literal_and_empty_templates",
      "params": {"mode": "basic", "bad_template": ""},
      "expect": {"stdout": "hello Ada\nAda @ Earth\nAdaEarth\nliteral\n\n"}
    },
    {
      "name": "interpolates_exotic_names_and_preserves_escaped_and_bare_percents",
      "params": {"mode": "exotic", "bad_template": ""},
      "expect": {"stdout": "runtime.log: sum\nescaped %{name} and 100%\n"}
    },
    {
      "name": "supports_first_class_and_partially_applied_interpolation",
      "params": {"mode": "functions", "bad_template": ""},
      "expect": {"stdout": "first Ada\npartial Earth\n"}
    },
    {
      "name": "missing_names_raise_catchable_extern_errors",
      "params": {"mode": "missing", "bad_template": ""},
      "expect": {"stdout": "missing caught\n"}
    },
    {
      "name": "invalid_hole_names_raise_catchable_extern_errors",
      "params": {"mode": "malformed", "bad_template": "%{a b}"},
      "expect": {"stdout": "malformed caught\n"}
    },
    {
      "name": "unterminated_holes_raise_catchable_extern_errors",
      "params": {"mode": "malformed", "bad_template": "%{"},
      "expect": {"stdout": "malformed caught\n"}
    }
  ]
}
