# A text target opens single-prompt despite a retry count; a parsed target does not.
program def main() -> unit =
  let worker = AgentPi("writer", "model", "high")
  let note: text = worker.ask("describe the plan", parse-error-retries = 2)
  let answer: int = worker.ask("calculate the total", parse-error-retries = 2)
  print note
  print answer
