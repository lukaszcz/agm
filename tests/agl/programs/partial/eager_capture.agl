# Non-hole arguments and variable values are captured when the partial application is created.
var counter = 0

def tick() -> int =
  counter := counter + 1
  counter

def add(a: int, b: int) -> int = a + b

def digits(a: int, b: int) -> int = a * 10 + b

program def main(mode: text, base: int) -> unit =
  var current = base

  if
    | mode == "non_hole" =>
        let add-tick = add(?, tick())
        print(counter)
        print(add-tick(10))
        print(add-tick(20))
        print(counter)
    | mode == "var_value" =>
        let add-current = add(?, current)
        current := 99
        print(add-current(1))
        print(current)
    | else =>
        let captured-order = digits(tick(), ?)
        print(counter)
        print(captured-order(base))
        print(captured-order(base + 1))
        print(counter)
