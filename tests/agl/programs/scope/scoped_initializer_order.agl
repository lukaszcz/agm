# Runtime initialization is sequenced in the selected program body. Named
# scopes are static declaration regions and do not perform module initialization.
param start: int
param branch_in_region: bool = false

program def main() -> unit =
  var order: int = start
  order := order + 1
  let root_a = order
  let scoped_x = if branch_in_region =>
    order := order + 1
    let first = order
    order := order + 1
    first + order
  else => (order := order + 1; order)
  order := order + 1
  let nested_n = order
  order := order + 1
  let scoped_y = order
  order := order + 1
  let root_b = order
  order := order + 1
  let scoped_z = order
  order := order + 1
  let scoped_w = order
  order := order + 1
  let root_c = order
  print("%{root_a} %{scoped_x} %{nested_n} %{scoped_y} %{root_b} %{scoped_z} %{scoped_w} %{root_c}")
