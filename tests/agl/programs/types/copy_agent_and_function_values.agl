def inc(x: int) -> int = x + 1

program def main() -> unit =
  # copy/shallow-copy are identity on opaque values -- an agent handle and a
  # first-class function value are returned as-is, and remain fully usable
  # through the copy.
  let impl: Agent = AgentCommand("impl")
  let copied-agent = copy(impl)
  let copied-fn = shallow-copy(inc)

  let result = copied-agent.ask("Do it")
  print(result)
  print(copied-fn(4))
