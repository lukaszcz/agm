# The compact variant: vars for loop-carried state, indented case for branches.
enum Review
  | Pass
  | Fail(issues: array[text])

program def main(spec: text) -> unit =
  let impl: Agent = AgentCommand("impl")
  let reviewer: Agent = AgentCommand("reviewer")
  var artifact: text = ask("Implement %{spec}", agent = impl)
  var review: Review = Pass
  do[5]
    review := ask("Review %{artifact}", agent = reviewer, on-parse-error = Retry(n = 2))
    case review of
      | Fail(issues) =>
          artifact := ask("Fix %{issues} in %{artifact}", agent = impl)
      | Pass() => ()
  until review is Pass
  print artifact
