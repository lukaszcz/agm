# Imported generics: glob-tail-exposed and module-qualified applied types in annotations,
# function signatures, nested applications, constructor calls, qualified enum
# constructors with explicit type arguments, and generic pattern matching.
import library::*
def unbox(box: Box[int]) -> int = box.value

def describe-option(option: library::Option[int]) -> text =
  case option of
    | none() => "none"
    | some(value) => "some %{value}"

program def main(seed: int) -> unit =
  let open-box: Box[int] = Box(value = seed)
  let qualified-box: library::Box[int] = library::Box(value = 7)
  let nested: library::Box[Box[int]] = library::Box(value = open-box)

  print(unbox(open-box))
  print(qualified-box.value)
  print(nested.value.value)

  let some-value = library::Option[int]::some(value = seed + 5)
  let none-value = library::Option[int]::none()
  print(describe-option(some-value))
  print(describe-option(none-value))
