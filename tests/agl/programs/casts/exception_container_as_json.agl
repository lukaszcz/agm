# An exception value converts to a JSON object of its own and inherited
# fields, and a container of exceptions converts element by element.
exception Failure extends Exception
  code: int

exception Nested extends Failure
  causes: array[Failure]

program def main(code: int, note: text) -> unit =
  let one = Failure(message = note, code = code)
  print(one as json)

  let many: array[Failure] = [one, Failure(message = note, code = code + 1)]
  print(many as json)

  let by-stage: dict[text, Failure] = {"build": one}
  print(by-stage as json)

  # A subtype is convertible on its own terms, and its array field converts too.
  let deep = Nested(message = note, code = code, causes = [one])
  print(deep as json)

  print(one as? json)
  print(many as? json)
