{
  "scenarios": [
    {
      "name": "agent_method_default_retries_retries_in_one_ephemeral_session",
      "runtime": {"session_host": true},
      "agents": {"writer": ["not a number", "not a number", "not a number", "not a number", "not a number"]},
      "expect": {
        "raises": {"type": "AgentParseError"},
        "calls": {"writer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "opened": true, "closed": true, "parent": null}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "starts_with": "calculate the total"},
          {"agent": "writer", "session": "session-1", "call": 1, "follow_up": {"not_contains": ["calculate the total"]}},
          {"agent": "writer", "session": "session-1", "call": 2, "follow_up": {"not_contains": ["calculate the total"]}},
          {"agent": "writer", "session": "session-1", "call": 3, "follow_up": {"not_contains": ["calculate the total"]}},
          {"agent": "writer", "session": "session-1", "call": 4, "follow_up": {"not_contains": ["calculate the total"]}}
        ]
      }
    }
  ]
}
