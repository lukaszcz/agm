import std/fs
import std/path

def at(root: path, name: text) -> path = path::join([root, name])

program def main(root: path, scenario: text) -> unit =
  if scenario == "success" =>
    fs::mkdir(at(root, "nested/deep"))
    fs::write(at(root, "nested/source.txt"), "first")
    fs::append(at(root, "nested/source.txt"), " second")
    fs::copy(at(root, "nested/source.txt"), at(root, "nested/copy.txt"))
    fs::move(at(root, "nested/copy.txt"), at(root, "nested/deep/moved.txt"))
    print(fs::read(at(root, "nested/source.txt")))
    print(fs::is-file(at(root, "nested/source.txt")))
    print(fs::is-dir(at(root, "nested/deep")))
    print(fs::list(at(root, "nested")).size())
    print(fs::glob(path::join([root, "nested", "*.txt"])).size())
    print(fs::glob(path::join([root, "missing", "*.txt"])).size())
    print(fs::glob(path::join([root, "nested", "**", "*.txt"])).size())
    print(fs::glob(path::join([root, "nested", "**"])).size())
    fs::remove(at(root, "nested"))
    print(fs::exists(at(root, "nested")))
    print(fs::is-dir(fs::temp-dir()))
    print(path::is-absolute(fs::temp-dir()))
  if scenario == "missing_file" =>
    let _ = fs::read(at(root, "missing.txt"))
  if scenario == "missing_directory" =>
    let _ = fs::list(at(root, "missing"))
  if scenario == "optional_read" =>
    case fs::try-read(at(root, "missing.txt")) of
      | Result::Ok(value) => print(value)
      | Result::Err(error) => print(error.operation)
  if scenario == "invalid_encoding" =>
    let _ = fs::read(at(root, "invalid.txt"))
  if scenario == "invalid_encoding_optional" =>
    print(fs::try-read(at(root, "invalid.txt")).err().map(fn(error: fs::FsError) => error.operation))
  if scenario == "directory_symlink" =>
    fs::remove(at(root, "directory-link"))
    print(fs::is-dir(at(root, "directory-target")))
    print(fs::exists(at(root, "directory-link")))
