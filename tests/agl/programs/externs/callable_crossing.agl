# Extern companions may invoke AgL callbacks with scalar and generic values.

extern def apply(f: (int) -> int, value: int) -> int
extern def combine(f: (int, int) -> int, left: int, right: int) -> int
extern def twice[T](f: (T) -> T, value: T) -> T
extern def stash(f: (int) -> int) -> unit
extern def use_stashed(value: int) -> int

def add-one(value: int) -> int = value + 1
def add(left: int, right: int) -> int = left + right
def surround(value: text) -> text = "[" + value + "]"

program def main(mode: text) -> unit =
  if mode == "arity" =>
    print apply(add-one, 4)
    print combine(add, 2, 5)

  if mode == "generic" =>
    print twice(surround, "value")

  if mode == "retained" =>
    let _: unit = stash(add-one)
    print use_stashed(9)
