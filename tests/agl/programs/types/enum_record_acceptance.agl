# Enum members are records, and existing records may be members of several enums.
record R1(x: int, y: int)
record R2(x: int)

enum RR = ::R1 | ::R2 | R3(r: RR)
enum RRPrime = ::R1 | RR::R3

enum Tree[T] =
  | Leaf
  | Node(value: T, children: array[Tree[T]])

def r-value(value: RR) -> int =
  case value of
    | R1(x, y) => x + y
    | R2(x) => x
    | R3(r) => r-value(r)

program def main() -> unit =
  let shared = R1(x = 1, y = 2)
  let rr: RR = shared
  let rr-prime: RRPrime = shared
  let nested: RR = R3(r = rr)
  let tree: Tree[int] = Tree[int]::Node(value = 3, children = [Tree[int]::Leaf])
  let nested-value = r-value(nested)
  let tree-value = case tree of
    | Leaf => 0
    | Node(value) => value
  print nested-value
  print tree-value
  print (rr-prime is R1)
  print nested
  print tree
