# Marked inline loop bodies may end in a binder, including a single-item body.

program def main(target: int) -> unit =
  var rounds: int = 0
  do[3] rounds := rounds + 1; let complete = rounds >= target until complete

  var single-runs: int = 0
  do single-runs := single-runs + 1; let complete = true until complete

  print rounds
  print single-runs
