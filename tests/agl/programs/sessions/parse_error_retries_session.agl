program def main() -> unit =
  let session = Session::open(AgentPi("writer", "model", "high"))
  try
    let defaulted: int = session.ask("default policy")
  catch AgentParseError =>
    print "default"
  try
    let aborted: int = session.ask("abort policy", parse-error-retries = 0)
  catch AgentParseError =>
    print "abort"
  try
    let exhausted: int = session.ask("retry policy", parse-error-retries = 2)
  catch AgentParseError =>
    print "exhausted"
  let context: text = session.ask("conversation continues")
  print context
