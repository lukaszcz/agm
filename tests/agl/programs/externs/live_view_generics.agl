# Generic array elements cross as their ordinary runtime values while the array
# itself remains a live mutable view. Parametricity is the companion's
# obligation.
param mode: text

record Label
  value: text

extern def mutate[T](xs: array[T], operation: text) -> unit
extern def reject_other_type_variable[T, U](xs: array[T], other: array[U]) -> unit

if mode == "reverse_text" =>
  var xs = ["one", "two", "three"]
  let _: unit = mutate(xs, "reverse")
  print xs

if mode == "rotate_record" =>
  var xs = [Label(value = "one"), Label(value = "two"), Label(value = "three")]
  let _: unit = mutate(xs, "rotate")
  print xs

if mode == "duplicate_text" =>
  var xs = ["one", "two", "three"]
  let _: unit = mutate(xs, "duplicate")
  print xs

if mode == "reject_other_type_variable" =>
  var xs = [Label(value = "one"), Label(value = "two")]
  let other = ["foreign"]
  try
    let _: unit = reject_other_type_variable(xs, other)
  catch ExternError as e =>
    print e.python_type
  print xs

if mode == "reject_plain_value" =>
  var xs = ["one", "two"]
  try
    let _: unit = mutate(xs, "reject")
  catch ExternError as e =>
    print e.python_type
  print xs

if mode == "sort_sealed_handles" =>
  var xs = ["one", "two", "three"]
  try
    let _: unit = mutate(xs, "sort")
  catch ExternError as e =>
    print e.python_type
