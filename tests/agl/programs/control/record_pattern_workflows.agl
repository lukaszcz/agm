# Whole-program record pattern workflows: local swap plus nested generic records
# reached through glob-tail, qualified, and aliased imports.
import record_patterns
import record_patterns as rp
import record_patterns::*

record Pair
  left: int
  right: int

program def main(seed: int) -> unit =
  let pair = Pair(left = seed, right = seed + 1)
  let Pair(left = _ as swapped-right, right = _ as swapped-left) = pair
  print "%{swapped-left}:%{swapped-right}"

  let nested: rp::Outer[int] = rp::Outer(inner = rp::Box(value = seed + 2))
  let rp::Outer(inner = rp::Box(value = _ as nested-value)) = nested
  print nested-value

  let qualified: record_patterns::Alias[int] = record_patterns::Box(value = seed + 3)
  let record_patterns::Alias(value = _ as qualified-value) = qualified
  print qualified-value

  let opened: Alias[int] = Box(value = seed + 4)
  let Alias(value = _ as opened-value) = opened
  print opened-value
