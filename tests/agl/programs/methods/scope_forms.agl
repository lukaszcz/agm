# Declaration paths and scope regions declare the same members. The paired
# calls below cover records, generic receivers (including `_` slots), bound
# values, enums, exceptions, multi-segment regions, and nested regions.

record Plain(value: int)

def Plain::path-add(self, amount: int) -> int = self.value + amount

scope Plain
  def region-add(self, amount: int) -> int = self.value + amount
end Plain

record Box[T](value: T)
record Box::Entry[T](value: T)

def Box::path-value[T](self) -> T = self.value
def Box::path-size[_](self) -> int = 1

def Box::Entry::make[T](value: T) -> Box::Entry[T] = Box::Entry(value = value)

scope Box
  def region-value[T](self) -> T = self.value
  def region-size[_](self) -> int = 1
end Box

enum Signal
  | ready(value: int)

def Signal::path-text(self) -> text =
  case self of
    | ready(value) => "ready %{value}"

scope Signal
  def region-text(self) -> text =
    case self of
      | ready(value) => "ready %{value}"
end Signal

exception Notice extends Exception
  code: int

def Notice::path-text(self) -> text = "notice %{self.code}"

scope Notice
  def region-text(self) -> text = "notice %{self.code}"
end Notice

scope A
  record T(value: int)
end A

def A::T::path-value(self) -> int = self.value

scope A::T
  def region-value(self) -> int = self.value
end A::T

scope A

  scope T
    def nested-value(self) -> int = self.value
  end T
end A

program def main(mode: text, base: int) -> unit =
  if
    | mode == "plain" =>
        let plain = Plain(value = base)
        let path = plain.path-add
        let region = plain.region-add
        print(path(2))
        print(region(2))
    | mode == "generic" =>
        let box = Box(value = base)
        let entry = Box::Entry::make(base + 1)
        print(box.path-value())
        print(box.region-value())
        print(box.path-size())
        print(box.region-size())
        print(entry.value)
    | mode == "variants" =>
        let signal: Signal = Signal::ready(value = base)
        let notice = Notice(message = "notice", code = base)
        print(signal.path-text())
        print(signal.region-text())
        print(notice.path-text())
        print(notice.region-text())
    | else =>
        let value = A::T(value = base)
        print(value.path-value())
        print(value.region-value())
        print(value.nested-value())
