# Parse policies: portable default abort, retry[N] corrective retries, explicit
# abort, format option, trailing comma in call options.
enum Review
  | Pass
  | Fail(issues: array[text])

program def main() -> unit =
  let reviewer = AgentCommand("reviewer")
  let strict_default: Review = reviewer.ask("First review.")
  print "first ok"

  let with_retry: Review = reviewer.ask("Second review.", on_parse_error = Retry(n = 2))
  print "second ok"

  let aborting: Review = reviewer.ask("Third review.", format = "json", on_parse_error = Abort)
  print "third ok"
