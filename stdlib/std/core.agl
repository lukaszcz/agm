import std/config

builtin
enum Option[T] =
  | None
  | Some(value: T)

builtin
record ExecResult
  stdout: text
  exit_code: int
  stderr: text
  timed_out: bool

builtin
enum ParsePolicy =
  | Abort
  | Retry(n: int)

builtin
enum Agent
  | AgentCommand(command: text)
  | AgentClaude(model: text, thinking: text)
  | AgentCodex(model: text, thinking: text)
  | AgentPi(provider: text, model: text, thinking: text)

builtin
enum SessionTransport
  | Cli
  | Rpc

builtin record Session(id: text, agent: Agent, transport: SessionTransport)

builtin record SessionStats(
  input-tokens: int,
  output-tokens: int,
  cost: decimal,
  context-percent: decimal,
)

builtin exception SessionError extends Exception(operation: text)

builtin
record AgentRequest
  prompt: text
  target_type: Option[text]
  format_instructions: Option[text]
  json_schema: Option[json]
  attempt: int
  previous_error: Option[text]
  metadata: json

builtin
exception Exception
  *
  message: text

builtin
exception AgentCallError extends Exception
  *
  agent: Agent
  cause: text
  metadata: json

builtin
exception AgentParseError extends Exception
  *
  agent: Agent
  target_type: text
  expected_schema: json
  raw: text
  normalized_raw: text
  validation_errors: json
  attempts: int
  metadata: json

builtin
exception ExecError extends Exception
  *
  command: text
  exit_code: int
  stdout: text
  stderr: text
  timed_out: bool

builtin
exception ExternError extends Exception
  *
  function: text
  python_type: text

builtin
exception MaxIterationsExceeded extends Exception
  *
  limit: int
  condition: text
  last_condition_value: bool
  metadata: json

builtin
exception MatchError extends Exception
  *
  scrutinee_type: text
  scrutinee: json

builtin
exception IndexError extends Exception
  *
  index: int
  length: int

builtin
exception KeyError extends Exception
  *
  key: text

builtin
exception TypeError extends Exception()

builtin
exception ArithmeticError extends Exception
  *
  operation: text

builtin
exception UndefinedVariableError extends Exception
  *
  name: text

builtin
exception ImmutableBindingError extends Exception
  *
  name: text
  operation: text

builtin
exception Abort extends Exception()

builtin
exception RecursionError extends Exception
  *
  limit: int

builtin
exception CastError extends Exception
  *
  source_type: text
  target_type: text
  raw: text

builtin
exception JsonParseError extends Exception
  *
  raw: text

builtin
exception RangeError extends Exception()

builtin
exception CyclicValueError extends Exception()

builtin def print[T](value: T) -> unit
builtin def render[T](value: T) -> text
builtin def copy[T](value: T) -> T
builtin def shallow_copy[T](value: T) -> T
builtin def parse_json(value: text) -> json
builtin def resource(path: text) -> text
builtin def resource-dir() -> text
builtin def ask[T](
  prompt: text,
  format: text = "",
  strict_json: bool = false,
  on_parse_error: ParsePolicy = ParsePolicy::Abort,
) -> T
builtin def Agent::ask[T](
  self,
  prompt: text,
  format: text = "",
  strict_json: bool = false,
  on_parse_error: ParsePolicy = ParsePolicy::Abort,
) -> T
builtin def ask-request(
  prompt: text,
) -> AgentRequest
builtin def Session::open(
  agent: Agent,
  transport: Option[SessionTransport] = Option[SessionTransport]::None,
  name: text = "",
) -> Session
builtin def Session::default() -> Session
builtin def Session::ask[T](
  self,
  prompt: text,
  format: text = "",
  strict_json: bool = false,
  on_parse_error: ParsePolicy = ParsePolicy::Abort,
) -> T
builtin def Session::compact(self, instructions: text = "") -> unit
builtin def Session::reset(self) -> unit
builtin def Session::fork(self) -> Session
builtin def Session::stats(self) -> SessionStats
builtin def Session::set-name(self, name: text) -> unit
builtin def Session::close(self) -> unit
builtin def exec(command: text) -> ExecResult
