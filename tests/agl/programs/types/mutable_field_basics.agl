# Mutable record fields update their shared record values through every ordinary
# postfix receiver. Functional `with` updates still construct a new outer record.
record Inner(var b: int)
record Outer(var a: Inner, stable: int)

def set-value(value: Inner, next: int) -> unit =
  value.b := next

def returned(value: Inner) -> Inner = value

program def main(seed: int, receiver: Inner) -> unit =
  receiver.b := seed + 6

  let r = Outer(a = Inner(b = seed), stable = seed)
  let alias = r
  r.a.b := seed + 1
  set-value(r.a, seed + 2)
  returned(r.a).b := seed + 3

  let xs = [Inner(b = seed)]
  xs[0].b := seed + 4

  let rebuilt = r with stable = seed + 100
  r.a.b := seed + 5

  print(alias.a.b)
  print(xs[0].b)
  print(r.stable)
  print(rebuilt.stable)
  print(receiver.b)
