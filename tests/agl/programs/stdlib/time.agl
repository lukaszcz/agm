import std/time
import std/time::TimeParseError

program def main(mode: int) -> unit =
  case mode of
    | 1 =>
        let epoch = time::parse-iso("2024-01-02T03:04:05.123456+00:00")
        print(time::format-iso(epoch))
        let parsed = time::parse("2024/01/02 03:04:05.123456 +0000", "%Y/%m/%d %H:%M:%S.%f %z")
        print(time::format(parsed, "%Y/%m/%d %H:%M:%S.%f %z"))
        print(parsed == epoch)
    | 2 =>
        try
          let _ = time::parse-iso("not an instant")
        catch TimeParseError as error => print(error.raw)
        try
          let _ = time::parse("not a date", "%Y-%m-%d")
        catch TimeParseError as error => print(error.raw)
    | 4 =>
        print(time::try-parse-iso("not an instant").err().map(fn(error: TimeParseError) => error.raw))
        print(time::try-parse("not a date", "%Y-%m-%d").is-err())
        print(time::try-parse-iso("2024-01-02T03:04:05+00:00").ok().map(time::format-iso))
        print(time::try-parse("2024/01/02", "%Y/%m/%d").ok().map(time::format-iso))
    | 5 =>
        let stamp = time::timestamp()
        print(stamp.size() == 22)
        print(time::try-parse(stamp, "%Y%m%d-%H%M%S-%f").is-ok())
    | _ =>
        let epoch = time::now()
        print(time::format-iso(epoch).contains("T"))
        print(time::now-iso().contains("T"))
        let earlier = time::monotonic()
        time::sleep(0.001)
        let later = time::monotonic()
        print(later > earlier)
        print(later - earlier > 0.0)
        print(time::monotonic() >= later)
