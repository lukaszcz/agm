# Scoped `param` declarations: region-form only, external key is the full
# path, a default is used when a param is left unsupplied, nested regions
# accumulate their path, and a scoped param is visible bare inside its own
# region and after `use Deploy::*`.
use Deploy::*

param increment: int

scope Deploy
param region: text = "eu"
param replicas: int
scope Retry
param attempts: int = 1
end Retry
end Deploy

program def main() -> unit =
  print("%{Deploy::region} x %{Deploy::replicas}")
  print("%{Deploy::region}")
  print(Deploy::Retry::attempts + increment)
