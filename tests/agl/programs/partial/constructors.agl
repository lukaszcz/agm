# Partial application of record, enum-variant, exception, and generic constructors.

record Point
  @std
  x: int
  y: int

record Box[T]
  value: T

enum Option[T]
  | none
  | some(value: T)

enum Status
  | ok(value: int)
  | failed(reason: text)

exception Boom extends Exception
  code: int

program def main(mode: text, base: int) -> unit =
  if
    | mode == "record" =>
        let make-point = Point(?, base)
        let point = make-point(3)
        let make-box: (text) -> Box[text] = Box(value = ?)
        let boxed = make-box("hi")
        print(point.x)
        print(point.y)
        print(boxed.value)
    | mode == "enum" =>
        let make-some: (int) -> Option[int] = Option::some(?)
        let value = make-some(base)
        case value of
          | Option::none => print("none")
          | Option::some(_ as n) => print(n)
        let make-failed = Status::failed(reason = ?)
        let status: Status = make-failed("bad")
        case status of
          | ok(_ as n) => print(n)
          | failed(reason) => print(reason)
    | else =>
        let make-boom = Boom(message = ?, code = base)
        try
          raise make-boom("kapow")
        catch Boom as e =>
          print(e.message)
          print(e.code)
