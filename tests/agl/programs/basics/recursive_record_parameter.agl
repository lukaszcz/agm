# Recursive-record host parameter: `Category` decodes through the same
# $defs/$ref JSON Schema and RefDecode decode plan a recursive agent output
# type uses, so a recursive-typed parameter round-trips nested JSON exactly
# like any other structured parameter.
record Category
  name: text
  subcategories: array[Category]

def count_categories(c: Category) -> int =
  var total: int = 1
  for sub in c.subcategories do
    total := total + count_categories(sub)
  total

program def main(root: Category) -> unit =
  print root.name
  print count_categories(root)
