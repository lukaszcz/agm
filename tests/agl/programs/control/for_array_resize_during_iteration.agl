# Array iteration has an entry-time upper bound while reading each visited
# index from the live array. Structural changes can shift or remove future
# indices, but appended elements cannot extend the loop.
import std/array
import std/config

program def main(mode: int) -> unit =
  std/config::max-iters := 1
  var xs = if mode == 1 => [1] else => [1, 2, 3, 4]
  var seen: array[int] = []
  var iteration = 0
  for x in xs do
    seen.append(x)
    if mode == 1 and iteration < 2 => xs.append(xs.size() + 1)
    if mode == 2 and iteration == 0 => xs.insert(0, 9)
    if mode == 3 and iteration == 0 =>
      let _ = xs.remove-at(1)
    if mode == 4 and iteration == 1 =>
      let _ = xs.remove-at(0)
    if mode == 5 and iteration == 0 => xs.clear()
    iteration := iteration + 1
  done
  print seen
  print xs
