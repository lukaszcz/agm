      "expect": {
        "stdout": "problem: 3\n",
        "calls": {}
      }
    },
    {
      "name": "raised_unrelated_exception_matches_neither_cast",
      "params": {
        "kind": "other"
      },
      "expect": {
        "stdout": "other: m\n",
        "calls": {}
      }
    },
    {
      "name": "no_failure",
      "params": {
        "kind": "none"
      },
      "expect": {
        "stdout": "no failure\n",
        "calls": {}
      }
    },
    {
      "name": "upcasts_including_to_the_root_are_no_ops",
