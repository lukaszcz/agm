# Builtin Agent methods are call-only methods that select their receiver as the
# agent. The branches cover typed and defaulted ask calls and the free-function
# ask-request form, typed and untyped.

program def main(mode: text) -> unit =
  let agents: array[Agent] = [AgentCommand("typed"), AgentCommand("request")]

  if
    | mode == "typed" =>
        let count: int = agents[0].ask::[int](
          "How many?",
          format = "json",
          strict-json = true,
          on-parse-error = Abort,
        )
        print(count)
    | mode == "defaulted" =>
        let response = agents[0].ask("Use the defaults.")
        print(response)
    | mode == "request" =>
        let request = ask-request("Prepare a count.")
        print(request.prompt)
    | mode == "typed-request" =>
        let request = ask-request::[int] "Prepare a count."
        print(request.prompt)
        print(request.target-type)
    | else =>
        let request = ask-request("Prepare a count.")
        print(request.prompt)
