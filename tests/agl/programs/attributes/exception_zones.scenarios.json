{
  "scenarios": [
    {
      "name": "fatal_deploy_in_range",
      "params": {
        "mode": "fatal",
        "index": 1
      },
      "expect": {
        "stdout": "api/1 fatal=true: deploy failed\nweb/2\n1:positional\n2:named\nraised 1/3\n20\n"
      }
    },
    {
      "name": "plain_out_of_range",
      "params": {
        "mode": "plain",
        "index": 5
      },
      "expect": {
        "stdout": "api/5 fatal=false: deploy failed\nweb/6\n5:positional\n6:named\nraised 5/3\nhost 5/3\n"
      }
    },
    {
      "name": "uncaught_positional_exception",
      "params": {
        "mode": "abort",
        "index": 0
      },
      "expect": {
        "stdout": "api/0 fatal=false: deploy failed\nweb/1\n0:positional\n1:named\nraised 0/3\n10\n",
        "raises": {
          "type": "ParseFailure",
          "fields": {
            "line": 0,
            "detail": "unhandled"
          },
          "message_contains": ["no handler"]
        }
      }
    }
  ]
}
