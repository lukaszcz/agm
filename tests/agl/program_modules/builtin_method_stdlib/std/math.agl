def int::abs(self) -> int = if self < 0 => -self else => self
def decimal::abs(self) -> decimal = if self < 0 => -self else => self
builtin def decimal::shallow_copy(self) -> decimal
def bool::negated(self) -> bool = not self
builtin def bool::print(self) -> unit
builtin def int::copy(self) -> int
extern def int::extern_double(self) -> int
