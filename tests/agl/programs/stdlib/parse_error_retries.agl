# std/config: `parse-error-retries` reads its default, accepts a non-negative
# write, and rejects a negative one with a catchable RangeError that leaves the
# setting unchanged.
import std/config

program def main(retries: int) -> unit =
  print config::parse-error-retries
  let accepted = try
      config::parse-error-retries := retries
      true
    catch RangeError as e =>
      false
  print accepted
  print config::parse-error-retries
