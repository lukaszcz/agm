# Modules: a recursive type cycle spanning two library modules (tree_a's
# NodeA <-> tree_b's NodeB), used from the entry program.
import tree_a::*
import tree_b::*

def sum-a(n: NodeA) -> int =
  case n of
    | LeafA() => 0
    | BranchA(value, child) => value + sum-b(child)

def sum-b(n: NodeB) -> int =
  var total: int = 0
  for c in n.children do
    total := total + sum-a(c)
  total

program def main(v: int, tag: text) -> unit =
  let leaf = LeafA()
  let child-group = NodeB(tag = tag, children = [leaf])
  let branch = BranchA(value = v, child = child-group)

  print sum-a(branch)
  print child-group.tag
