{
  "scenarios": [
    {
      "name": "type_parameter_unused_in_key_field_is_trivially_hashable",
      "params": {"mode": 1},
      "expect": {"stdout": "{\"d\": [{\"key\": {\"x\": 1}, \"value\": 2}]}\n"}
    },
    {
      "name": "type_parameter_through_a_phantom_key_argument_is_not_a_key_parameter",
      "params": {"mode": 2},
      "expect": {"stdout": "{\"b\": {\"d\": []}}\n"}
    },
    {
      "name": "type_parameter_through_a_nested_wrap_key_argument_encodes",
      "params": {"mode": 3},
      "expect": {"stdout": "{\"b\": {\"d\": [{\"key\": {\"x\": {\"x\": 1}}, \"value\": 3}]}}\n"}
    },
    {
      "name": "generic_enum_type_parameter_as_key_stringifies",
      "params": {"mode": 4},
      "expect": {"stdout": "{\"d\": {\"A\": 1}}\n"}
    },
    {
      "name": "phantom_enum_type_parameter_accepts_a_non_hashable_argument",
      "params": {"mode": 5},
      "expect": {"stdout": "{\"d\": {\"A\": 1}}\n"}
    },
    {
      "name": "same_named_type_parameter_of_a_nested_declaration_is_not_confused_with_the_outer_ones",
      "params": {"mode": 6},
      "expect": {"stdout": "{\"b\": {\"d\": {\"1\": 2}}, \"v\": [1]}\n"}
    }
  ]
}
