import std/option::Option
import std/result::Result
import std/errors::{JsonParseError, KeyError}

# A `\uD8xx`/`\uDCxx` escape that does not combine with an adjacent partner
# into one scalar character is a parse error; a combining pair is one
# character, as elsewhere in AgL.
extern def parse(value: text) -> json
def try-parse(value: text) -> Result[json, JsonParseError] =
  try Ok(parse(value)) catch JsonParseError as e => Err(e)

@extern-name("parse_lenient")
extern def parse-lenient(value: text) -> json
def try-parse-lenient(value: text) -> Result[json, JsonParseError] =
  try Ok(parse-lenient(value)) catch JsonParseError as e => Err(e)

extern def json::kind(self) -> text
extern def json::size(self) -> int
extern def json::keys(self) -> array[text]
extern def json::has(self, key: text) -> bool
extern def json::get(self, key: text) -> json
@extern-name("get_option")
extern def json::get?(self, key: text) -> Option[json]
