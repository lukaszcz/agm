import std/result::Result

exception TimeParseError extends Exception
  raw: text

extern def now() -> decimal
@extern-name("now_iso")
extern def now-iso() -> text
extern def monotonic() -> decimal
extern def sleep(seconds: decimal) -> unit
@extern-name("parse_iso")
extern def parse-iso(value: text) -> decimal
def try-parse-iso(value: text) -> Result[decimal, TimeParseError] =
  try Result::Ok(value = parse-iso(value)) catch TimeParseError as e => Result::Err(error = e)

@extern-name("format_iso")
extern def format-iso(epoch: decimal) -> text
extern def format(epoch: decimal, fmt: text) -> text
extern def parse(value: text, fmt: text) -> decimal
def try-parse(value: text, fmt: text) -> Result[decimal, TimeParseError] =
  try Result::Ok(value = parse(value, fmt)) catch TimeParseError as e => Result::Err(error = e)
