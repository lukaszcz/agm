{
  "scenarios": [
    {
      "name": "inline_block_typed_and_postfix_raw_member_calls",
      "params": {"subject": "the release notes"},
      "agents": {
        "raw": ["Concise summary", "{\"summary\": \"Key change\"}"],
        "chain": ["Follow-up"]
      },
      "expect": {
        "stdout": "Concise summary\nKey change\nFollow-up\n",
        "calls": {"raw": 2, "chain": 1},
        "prompts": [
          {"agent": "raw", "call": 0, "equals": "Summarize the release notes."},
          {
            "agent": "raw",
            "call": 1,
            "equals": "Review the release notes and identify the key change.",
            "schema_contains": ["summary"]
          },
          {"agent": "chain", "call": 0, "equals": "Continue the release notes."}
        ]
      }
    },
    {
      "name": "member_payload_interpolation_changes_per_run",
      "params": {"subject": "the migration guide"},
      "agents": {
        "raw": ["Brief", "{\"summary\": \"Updated change\"}"],
        "chain": ["Next"]
      },
      "expect": {
        "stdout": "Brief\nUpdated change\nNext\n",
        "calls": {"raw": 2, "chain": 1},
        "prompts": [
          {"agent": "raw", "call": 0, "equals": "Summarize the migration guide."},
          {
            "agent": "raw",
            "call": 1,
            "equals": "Review the migration guide and identify the key change.",
            "schema_contains": ["summary"]
          },
          {"agent": "chain", "call": 0, "equals": "Continue the migration guide."}
        ]
      }
    }
  ]
}
