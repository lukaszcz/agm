# Recursive record guarded by a dict field: Tree can hold nested children
# keyed by name without needing a base-case variant, since dict[text, Tree]
# is always inhabited by the empty dict. Builds a nested tree (root with TWO
# children, one of which optionally has a grandchild) plus an EMPTY-children
# case, counts and renders both recursively.
record Tree
  name: text
  children: dict[text, Tree]

def count-nodes(t: Tree) -> int =
  var total: int = 1
  for key in t.children do
    total := total + count-nodes(t.children[key])
  total

def render-tree(t: Tree) -> text =
  var result: text = t.name
  for key in t.children do
    result := result ++ " > " ++ render-tree(t.children[key])
  result

program def main(root-name: text, child-name: text, include-grandchild: bool) -> unit =
  let grandchildren: dict[text, Tree] = if include-grandchild => {"leaf": Tree(name = "leaf", children = {})} else => {}
  let child = Tree(name = child-name, children = grandchildren)
  let root = Tree(name = root-name, children = {"child": child, "second": Tree(name = "second", children = {})})
  let empty-root = Tree(name = "empty", children = {})

  print count-nodes(root)
  print render-tree(root)
  print count-nodes(empty-root)
  print render-tree(empty-root)
