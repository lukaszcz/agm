    {
      "name": "ask_many_fills_noul_choice_and_bool_fields_in_one_request",
      "params": {"scenario": "many"},
      "jev": [
        {
          "expect": {
            "body": {
              "state": {"ticket": "I was charged twice."},
              "model": "jev-latest",
