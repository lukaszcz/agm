# Triple-quoted templates: dedent rule (drop one leading/trailing newline, strip
# minimum common indentation), interpolation holes are never dedented.
param body

program def main() -> unit =
  let critic = AgentCommand("critic")
  if true =>
    let block = critic.ask("""
    Header line:
      keep two spaces
    A "quoted" tail.
    """)
    print "block sent"
  else =>
    ()

  let mixed = critic.ask("""
  Wrap:
  %{body}
  End.
  """)
  print "mixed sent"
