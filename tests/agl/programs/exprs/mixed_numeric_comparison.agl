import std/math

# Comparing an `int` with a `decimal` -- `==`, `!=`, `<`, `<=`, `>`, `>=`,
# array membership, and a literal pattern -- is exact and never raises, even
# for an `int` far outside the decimal range: the `int` is never widened.
# Only a hashing lookup (`in` on a `dict[decimal, V]`) widens its `int`
# needle, raising `ArithmeticError` labelled with `in` when it cannot.
program def main(exponent: int) -> unit =
  let n = 2.pow(exponent)
  let near = 10.pow(30) + 1
  print([n == 1.5, n != 1.5, n < 1.5, n <= 1.5, n > 1.5, n >= 1.5])
  print([-n < 1.5, 1.5 > -n, 1.5 < n, 1.5 == n, n == 2.0, 2.0 <= n])
  print([n in [1.5, 2.0], near == 1000000000000000000000000000001.0])
  print([near > 1000000000000000000000000000000.5, near < 1000000000000000000000000000001.5])
  let match-label = case n of
    | 2.0 => "two"
    | _ => "other"
  print(match-label)
  try
    print(n in {1.5: "a", 2.0: "b"})
  catch ArithmeticError as e => print("dict lookup: %{e.operation}")
