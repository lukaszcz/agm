# A cyclic array crosses the Python FFI boundary as a lazy live view. `count`
# can inspect the outer array without walking into its cyclic `Node`, while
# `show` detects the cycle when its companion renders that view. `identity`
# passes its argument through directly, and rendering the corresponding view likewise
# detects the cycle. Both rendering failures are catchable `CyclicValueError`
# values rather than `ExternError`. `mode` selects how `xs` is built: "cycle"
# closes a genuine reference cycle through it, "acyclic" leaves it as an
# ordinary nested array, and "diamond" makes the same inner `Node` reachable
# twice through `xs` without `xs` ever reaching back to itself.
param mode: text

record Node(children: array[Node])

extern def count(xs: array[Node]) -> int
extern def show(xs: array[Node]) -> int
extern def identity[T](x: T) -> T

program def main() -> unit =
  let leaf = Node(children = [])
  var xs: array[Node] = [leaf]

  if mode == "cycle" =>
    let n = Node(children = xs)
    xs[0] := n

  if mode == "diamond" =>
    xs := [leaf, leaf]

  try
    let c = count(xs)
    print "count: %{c}"
  catch CyclicValueError as e =>
    print "count caught: %{e.message}"

  try
    let s = show(xs)
    print "show: %{s}"
  catch CyclicValueError as e =>
    print "show caught: %{e.message}"

  try
    let r = identity(xs)
    print "identity: %{r}"
  catch CyclicValueError as e =>
    print "identity caught: %{e.message}"

  print "done"
