# `as?` returns Option without raising. Pattern matching drives the success
# and fallback paths without repeating a potentially-failing cast.
param user_input
param d: decimal

# Check if the text is a valid int before using it

program def main() -> unit =
  case user_input as? int of
    | Some(value = _ as n) =>
        print "got int: %{n}"
        print "squared: %{(n * n) as text}"
    | None => print "not an int: %{user_input}"

  case d as? int of
    | Some(value = _ as i) => print "decimal is integral: %{i}"
    | None => print "decimal has fraction: %{d as text}"

  case 42 as? text of
    | Some(_) => print true
    | None => print false
