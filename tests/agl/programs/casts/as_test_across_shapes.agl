# `as?` yields `Some` where the corresponding `as` would succeed. Only a value
# that actually holds a reference cycle yields `None`: scalars, nominals,
# enums, and generic instantiations — including one whose type argument is an
# array — all convert, whether or not a cycle exists elsewhere in the
# program.

record Scalar
  value: int

record Box[T]
  value: T

record Node
  children: array[Node]

enum Tree
  | leaf
  | branch(next: Tree)

program def main(close-cycle: bool) -> unit =
  let scalar = Scalar(value = 1)
  let tree = leaf
  let boxed-int: Box[int] = Box(value = 1)
  let boxed-array: Box[array[int]] = Box(value = [1])
  var nodes: array[Node] = [Node(children = [])]
  let node = Node(children = nodes)
  if close-cycle =>
    nodes[0] := node

  print((1 as? text).is-some())
  print((1 as? json).is-some())
  print((scalar as? text).is-some())
  print((scalar as? json).is-some())
  print((tree as? text).is-some())
  print((tree as? json).is-some())
  print((boxed-int as? text).is-some())
  print((boxed-int as? json).is-some())
  print((boxed-array as? text).is-some())
  print((boxed-array as? json).is-some())
  print((node as? text).is-some())
  print((node as? json).is-some())
