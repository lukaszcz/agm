# The compact variant: vars for loop-carried state, indented case for branches.
param spec
enum Review
  | Pass
  | Fail(issues: array[text])

program def main() -> unit =
  let impl = AgentCommand("impl")
  let reviewer = AgentCommand("reviewer")
  var artifact: text = impl.ask("Implement %{spec}")
  var review: Review = Pass
  do[5]
    review := reviewer.ask("Review %{artifact}", on_parse_error = Retry(n = 2))
    case review of
      | Fail(issues) =>
          artifact := impl.ask("Fix %{issues} in %{artifact}")
      | Pass() => ()
  until review is Pass
  print artifact
