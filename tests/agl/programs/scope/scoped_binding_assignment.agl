# Scoped static bindings: qualified and bare assignment, a bare reference
# reaching a var made bare by `use` before its source scope declares it,
# visibility from nested and qualified paths, and a scope-region member
# reading a module-root binding bare.
use Config::*

let step: int = 2

scope Config
  let retries: int = 3
  var attempts: int = 0
  def bump(increment: int) -> unit =
    attempts := attempts + increment * step
    ()
  def show() -> text = "%{retries}/%{attempts}"

  scope Nested
    def doubled() -> int = attempts * 2
  end Nested
end Config

program def main(increment: int) -> unit =
  var extra: int = 1

  Config::bump(increment)
  Config::attempts := Config::attempts + 1
  extra := extra + increment
  Config::bump(increment)

  print(Config::show())
  print("%{Config::attempts}")
  print("%{extra}")
  print("%{Config::Nested::doubled()}")
