# Library module completing the cycle with `left`. Each of its aliases names
# a record directly, the last two `left`'s own.
import left::*

record Other
  y: int

type Rt0 = Other

type Rt1 = Other

type Rt2 = Base

def Other::rt1(self) -> int = self.y + L5::o5(self)

def Base::rt3(self) -> int = self.l3() + 100

def Base::Deep::upper() -> int = 5

def Other::Deep::second() -> int = Base::Deep::lower() + 1
