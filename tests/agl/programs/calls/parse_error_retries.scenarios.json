{
  "scenarios": [
    {
      "name": "all_valid_first_try",
      "agents": {
        "reviewer": [
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Fail\", \"issues\": [\"a\"]}",
          "{\"$case\": \"Pass\"}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\nthird ok\n",
        "calls": {
          "reviewer": 3
        }
      }
    },
    {
      "name": "default_retries_retries_four_times_then_aborts",
      "agents": {
        "reviewer": [
          "nonsense 1",
          "nonsense 2",
          "nonsense 3",
          "nonsense 4",
          "nonsense 5"
        ]
      },
      "expect": {
        "stdout": "",
        "calls": {
          "reviewer": 5
        },
        "raises": {
          "type": "AgentParseError",
          "fields": {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "attempts": 5,
            "target-type": "Review"
          }
        }
      }
    },
    {
      "name": "default_retries_recovers_on_fifth_attempt",
      "agents": {
        "reviewer": [
          "nonsense 1",
          "nonsense 2",
          "nonsense 3",
          "nonsense 4",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\nthird ok\n",
        "calls": {
          "reviewer": 7
        }
      }
    },
    {
      "name": "zero_default_retries_abort_immediately",
      "runtime": {"parse_error_retries": 0},
      "agents": {
        "reviewer": [
          "utter nonsense"
        ]
      },
      "expect": {
        "stdout": "",
        "calls": {
          "reviewer": 1
        },
        "raises": {
          "type": "AgentParseError",
          "fields": {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "attempts": 1,
            "target-type": "Review"
          }
        }
      }
    },
    {
      "name": "retry_recovers_on_last_attempt",
      "agents": {
        "reviewer": [
          "{\"$case\": \"Pass\"}",
          "not json",
          "{\"$case\": \"Unknown\"}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\nthird ok\n",
        "calls": {
          "reviewer": 5
        },
        "prompts": [
          {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "call": 1,
            "starts_with": "Second review."
          },
          {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "call": 2,
            "starts_with": "Second review.",
            "contains": ["Validation errors:"]
          },
          {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "call": 3,
            "starts_with": "Second review.",
            "contains": ["Validation errors:"]
          }
        ]
      }
    },
    {
      "name": "retries_exhausted",
      "agents": {
        "reviewer": [
          "{\"$case\": \"Pass\"}",
          "bad 1",
          "bad 2",
          "bad 3"
        ]
      },
      "expect": {
        "stdout": "first ok\n",
        "calls": {
          "reviewer": 4
        },
        "raises": {
          "type": "AgentParseError",
          "fields": {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "attempts": 3,
            "target-type": "Review"
          }
        }
      }
    },
    {
      "name": "explicit_abort_on_third_site",
      "agents": {
        "reviewer": [
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}",
          "{\"oops\": true}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\n",
        "calls": {
          "reviewer": 3
        },
        "raises": {
          "type": "AgentParseError",
          "fields": {
            "agent": {
              "$case": "AgentCommand",
              "command": "reviewer"
            },
            "attempts": 1
          }
        }
      }
    },
    {
      "name": "repeated_member_name_in_output_is_retried",
      "agents": {
        "reviewer": [
          "{\"$case\": \"Fail\", \"issues\": [\"a\"], \"issues\": [\"b\"]}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\nthird ok\n",
        "calls": {
          "reviewer": 4
        }
      }
    },
    {
      "name": "repeated_member_name_in_prose_wrapped_output_is_retried",
      "agents": {
        "reviewer": [
          "Here you go: {\"$case\": \"Fail\", \"issues\": [\"a\"], \"issues\": [\"b\"],}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}",
          "{\"$case\": \"Pass\"}"
        ]
      },
      "expect": {
        "stdout": "first ok\nsecond ok\nthird ok\n",
        "calls": {
          "reviewer": 4
        }
      }
    }
  ]
}
