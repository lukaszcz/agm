# Deeply nested control flow: loop > case > case > if, dedent-routed branch
# markers, state threading through outer vars.
enum Review
  | Pass
  | Fail(issues: array[text])

enum Plan
  | Retry
  | GiveUp(why: text)

param spec

program def main() -> unit =
  let impl = AgentCommand("impl")
  let reviewer = AgentCommand("reviewer")
  let planner = AgentCommand("planner")
  var artifact: text = impl.ask("Implement %{spec}")
  var status: text = "working"

  do[3]
    let review: Review = reviewer.ask("Review:\n%{artifact}")
    case review of
      | Pass() =>
          status := "accepted"
      | Fail(issues) =>
          let plan: Plan = planner.ask("Plan for:\n%{issues}")
          case plan of
            | Retry() =>
                artifact := impl.ask("Fix %{issues} in %{artifact}")
            | GiveUp(why) =>
                if why == "hopeless" =>
                  status := "abandoned"
                else =>
                  status := "deferred: %{why}"
  until status != "working"
  print status
  print artifact
