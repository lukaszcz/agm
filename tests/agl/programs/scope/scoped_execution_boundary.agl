# Scoped declarations cross the complete execution boundary: linked calls,
# members selected with `use`, recursive agent decoding, and enum variants.
use Workflow::*
use Workflow::Status::*

scope Workflow
record Task
  name: text
  children: array[Task]
let reviewer = AgentCommand("reviewer")
end Workflow

enum Workflow::Status
  | waiting
  | completed

def Workflow::score(task: Workflow::Task) -> bool = task.children[0].name == "ready"
def Workflow::Status::label(status: Workflow::Status) -> text =
  case status of
    | Workflow::Status::waiting => "waiting"
    | Workflow::Status::completed => "completed"

program def main() -> unit =
  let task: Workflow::Task = ask("Return a recursive task.", agent = Workflow::reviewer)
  let status: Workflow::Status = ask("Return a workflow status.", agent = Workflow::reviewer)
  print(Workflow::score(task))
  print(Workflow::Status::label(status))
  print(status is Workflow::Status::completed)
