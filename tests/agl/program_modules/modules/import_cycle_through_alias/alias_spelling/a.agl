# Library module forming a cyclic import with `b`, re-exporting `b`'s alias
# `G` of this module's own `Base`. Its own function reads the declaration `b`
# writes at `Base`'s path through that alias, which reaches what `b` declares
# there.
import b::*
export b::{G}

record Base
  x: int

def af() -> int = G::h()
