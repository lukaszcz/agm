# Mutual recursion between a record and an enum: Expr.Block holds a
# array[Stmt], and Stmt.value holds an Expr, so the two declarations are
# mutually recursive (guarded here by the array, though neither actually
# NEEDS a guard since Expr's Lit variant is already a base case). Folds over
# both via a single recursive function.
enum Expr
  | Lit(value: int)
  | Add(lhs: Expr, rhs: Expr)
  | Block(stmts: array[Stmt])

record Stmt
  name: text
  value: Expr

def eval-expr(e: Expr) -> int =
  case e of
    | Lit(value) => value
    | Add(lhs, rhs) => eval-expr(lhs) + eval-expr(rhs)
    | Block(stmts) =>
        var total: int = 0
        for s in stmts do
          total := total + eval-expr(s.value)
        total

program def main(x: int, y: int) -> unit =
  let block-expr = Block(stmts = [
    Stmt(name = "a", value = Lit(value = x)),
    Stmt(name = "b", value = Add(lhs = Lit(value = y), rhs = Lit(value = 1))),
  ])

  print eval-expr(block-expr)
  print eval-expr(Add(lhs = Lit(value = x), rhs = Lit(value = y)))
