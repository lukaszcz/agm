# Parse policies: default retries (std/config::parse-error-retries), Retry(n)
# corrective retries, explicit abort, format option, trailing comma in call options.
enum Review
  | Pass
  | Fail(issues: array[text])

program def main() -> unit =
  let reviewer: Agent = AgentCommand("reviewer")
  let strict-default: Review = ask("First review.", agent = reviewer)
  print "first ok"

  let with-retry: Review = ask("Second review.", agent = reviewer, on-parse-error = Retry(n = 2))
  print "second ok"

  let aborting: Review = ask("Third review.", agent = reviewer, format = "json", on-parse-error = ParsePolicy::Abort)
  print "third ok"
