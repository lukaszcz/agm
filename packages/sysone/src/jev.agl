# Typed questions to TypeSafe's System One model (Jev).
#
# The target type of `jev::ask` selects the question kind and converts the
# answer:
#
# - `bool` and `Noul` ask a noul (yes/no) question; `bool` is the noul
#   probability thresholded by `noul-threshold`, as `Noul::value` does.
# - A fieldless enum `E` and `Choice[E]` ask a choice question. A label is a
#   member's JSON tag (`@json-name`, else its declared name); its description
#   is the member's `@doc`, else `null`.
# - `Score[L]` asks a score question whose ordered rubric is `L`'s members in
#   declaration order; a level's description is the member's `@doc`, else its
#   tag. Bare `decimal` is not a target: a score needs a rubric type.
#
# A choice or score target must be an enum of at least two members, every
# member fieldless, and a rubric has 2-10 levels; any other target raises
# `JevTargetError` before a request is sent. An answer the target cannot hold
# (a label outside it, or probabilities not keyed by exactly its labels or
# levels) raises `JevResponseError`.
#
# Every request function takes the settings it uses as trailing parameters
# defaulting to the module settings below. Requests go through the official
# `typesafe-sdk`, which owns retries, backoff, `Retry-After`, request ids, and
# response validation. One client is pooled per interpreter for each distinct
# combination of `api-key`, `base-url`, and `max-retries`, so a call's values
# of these select or create a pooled client; its `model` and `timeout` apply
# to that request only. A `None` setting is not passed to the SDK, so its own
# environment variables and defaults apply.
#
# A `timeout` is a positive plain number (seconds) or a positive number
# suffixed with `s`, `m`, or `h`; text that is not a duration, a zero
# duration, or one too large to wait for raises `std/errors::TypeError` when a
# request uses it.
#
# Traces `jev_request` (model, state, questions), `jev_response` (model,
# answers, usage, request id), and `jev_failure` (error type, status, request
# id) records; the API key never appears in a record.

@param @opt-name("jev-api-key") @opt-env("TYPESAFE_API_KEY") @doc("TypeSafe API key.")
var api-key: Option[text] = None
@param @opt-name("jev-base-url") @doc("TypeSafe API base URL; None uses the SDK default.")
var base-url: Option[text] = None
@param @opt-name("jev-model") @doc("Jev model; None uses the SDK default.")
var model: Option[text] = None
@param @opt-name("jev-timeout") @doc("Request timeout; None uses the SDK default.")
var timeout: Option[text] = None
@param @opt-name("jev-max-retries") @doc("Retries after a failed request attempt.")
var max-retries: int = 2
@param @opt-name("jev-noul-threshold") @doc("Probability from which a noul answer is true.")
var noul-threshold: decimal = 0.5

@doc("A noul answer containing the probability of yes.")
record Noul
  @doc("The probability of yes.")
  probability: decimal

@doc("Check if the noul probability reaches the threshold.")
def Noul::value(self, threshold: decimal = ::noul-threshold) -> bool =
  self.probability >= threshold

@doc("A choice answer with the chosen member, confidence, and probabilities.")
record Choice[C]
  @doc("The chosen enum member.")
  choice: C
  @doc("The confidence reported by the API.")
  confidence: decimal
  @doc("The probability of each member of `C`.")
  probabilities: dict[C, decimal]

@doc("A score answer over the ordered rubric members of `L`.")
record Score[L]
  @doc("The most probable member, choosing the lowest index on a tie.")
  level: L
  @doc("The probability-weighted level index.")
  score: decimal
  @doc("The confidence reported by the API.")
  confidence: decimal
  @doc("The probability of each rubric member of `L`.")
  probabilities: dict[L, decimal]

@doc("Structured JSON descriptions of the yes and no outcomes of a noul question.")
record NoulCriteria
  @doc("A description of the yes outcome.")
  when-true: json
  @doc("A description of the no outcome.")
  when-false: json

@doc("Raw API questions whose instructions and outcome descriptions accept structured JSON.")
enum Question
  | @doc("A yes/no question with optional outcome descriptions.")
    NoulQuestion
      @doc("The question's instructions.")
      instructions: json
      @doc("Outcome descriptions, or `None` when unspecified.")
      criteria: Option[NoulCriteria]
  | @doc("A choice question mapping each label to its description, or `null` when undescribed.")
    ChoiceQuestion
      @doc("The question's instructions.")
      instructions: json
      @doc("A description for each label, or `null` when undescribed.")
      options: dict[text, json]
  | @doc("A score question with 2-10 level descriptions in rubric order.")
    ScoreQuestion
      @doc("The question's instructions.")
      instructions: json
      @doc("The level descriptions in rubric order.")
      levels: array[json]

@doc("Raw API answers returned by `system-one`.")
enum Answer
  | @doc("A yes/no answer containing the probability of yes.")
    NoulAnswer
      @doc("The probability of yes.")
      noul: decimal
  | @doc("A choice answer with the chosen label and probabilities keyed by label.")
    ChoiceAnswer
      @doc("The chosen option's label.")
      choice: text
      @doc("The confidence reported by the API.")
      confidence: decimal
      @doc("The probability of each option label.")
      probabilities: dict[text, decimal]
  | @doc("A score answer with probabilities and legend descriptions ordered by level index.")
    ScoreAnswer
      @doc("The probability-weighted level index.")
      score: decimal
      @doc("The confidence reported by the API.")
      confidence: decimal
      @doc("The level probabilities in rubric order.")
      probabilities: array[decimal]
      @doc("The level descriptions in rubric order.")
      legend: array[json]

@doc("Input and output token counts, or `None` when the API omits them.")
record Usage
  @doc("The input token count, or `None` when omitted.")
  input-tokens: Option[int]
  @doc("The output token count, or `None` when omitted.")
  output-tokens: Option[int]

@doc("A System One response with answers keyed by question name, usage, and an optional request id.")
record Response
  @doc("The model that answered the request.")
  model: text
  @doc("The answers keyed by question name.")
  answers: dict[text, Answer]
  @doc("The request's token usage.")
  usage: Usage
  @doc("The request id, or `None` when unavailable.")
  request-id: Option[text]

@doc("""
  The base exception for SDK failures and invalid Jev targets or responses.

  `message` is the SDK's message for SDK failures. An SDK failure with no more specific exception,
  such as a missing API key, invalid retry policy, or empty questions, is a plain `JevError` with
  `request-id` set to `None`, including failures while building the client.
""")
exception JevError extends Exception
  @doc("The request id, or `None` when unavailable.")
  request-id: Option[text]

@doc("An unsuccessful HTTP response after the SDK's retries, carrying its status and JSON body.")
exception JevApiError extends JevError
  @doc("The response's HTTP status.")
  status: int
  @doc("The response body as JSON, or `null` when unavailable or invalid.")
  body: json

@doc("An HTTP 401 or 403 authentication or permission failure.")
exception JevAuthError extends JevApiError

@doc("An HTTP 400, 404, or 422 request failure.")
exception JevRequestError extends JevApiError

@doc("An HTTP 429 rate limit failure with an optional retry delay in milliseconds.")
exception JevRateLimitError extends JevApiError
  @doc("The retry delay in milliseconds, or `None` when unspecified.")
  retry-after-ms: Option[int]

@doc("An HTTP 5xx server failure.")
exception JevServerError extends JevApiError

@doc("A request that received no response, carrying the transport failure's cause.")
exception JevConnectionError extends JevError
  @doc("The transport failure's cause.")
  cause: text

@doc("""
  A request that exceeded its timeout.

  `timeout` is the duration reported by the SDK, formatted as duration text such as `\"10.0s\"`.
""")
exception JevTimeoutError extends JevError
  @doc("The timeout reported by the SDK, formatted as duration text.")
  timeout: text

@doc("""
  A success response with an invalid body or an answer its target cannot hold.

  `field-path` locates the invalid response field: `answers.<question>.choice` for an unknown
  label, or `answers.<question>.probabilities` for keys other than exactly the target's labels
  or level indices.
""")
exception JevResponseError extends JevError
  @doc("The path of the invalid response field.")
  field-path: text

@doc("""
  A target type that no Jev question kind supports.

  `target` is the type label, such as `Team` or `std/option::Option[Team]`, or `<record>.<field>`
  for an unsupported `ask-many` field. Raised before any request is sent.
""")
exception JevTargetError extends JevError
  @doc("The unsupported target's type label or record field path.")
  target: text

@extern-name("system_one")
@doc("""
  Ask the named questions about the state in one request and return raw answers.

  Raises `JevError` for SDK failures or `JevResponseError` for invalid answers. A non-positive,
  unparseable, or excessively large `timeout` raises `std/errors::TypeError` before a request.

  Questions and answers are keyed by question name. Instructions and criteria accept structured
  JSON. Request settings default to the module settings; `None` uses the SDK's environment and
  defaults. The SDK handles retries and response validation.
""")
extern def system-one(state: json, questions: dict[text, Question],
                      model: Option[text] = ::model, timeout: Option[text] = ::timeout,
                      api-key: Option[text] = ::api-key, base-url: Option[text] = ::base-url,
                      max-retries: int = ::max-retries) -> Response

@doc("""
  Ask the named questions about the state, returning `JevError` failures as `Err`.

  Uses `system-one`; `std/errors::TypeError` for an invalid timeout still propagates.
""")
def try-system-one(state: json, questions: dict[text, Question], model: Option[text] = ::model,
                   timeout: Option[text] = ::timeout, api-key: Option[text] = ::api-key,
                   base-url: Option[text] = ::base-url,
                   max-retries: int = ::max-retries) -> Result[Response, JevError] =
  try Ok(system-one(state, questions, model, timeout, api-key, base-url, max-retries))
  catch JevError as e => Err(e)

@extern-name("ask_noul")
@doc("""
  Ask a noul (yes/no) question and return its probability.

  Raises `JevError` for SDK failures or `JevResponseError` for an invalid answer.
  An invalid timeout raises `std/errors::TypeError`.

  `criteria`, when supplied, describes the yes and no outcomes. Settings default to the module
  settings, as in `system-one`.
""")
extern def ask-noul(instructions: text, state: json = "", criteria: Option[NoulCriteria] = None,
                    model: Option[text] = ::model, timeout: Option[text] = ::timeout,
                    api-key: Option[text] = ::api-key, base-url: Option[text] = ::base-url,
                    max-retries: int = ::max-retries) -> Noul

@doc("""
  Ask a noul question, returning `JevError` failures as `Err`.

  Uses `ask-noul`; `std/errors::TypeError` for an invalid timeout still propagates.
""")
def try-ask-noul(instructions: text, state: json = "", criteria: Option[NoulCriteria] = None,
                 model: Option[text] = ::model, timeout: Option[text] = ::timeout,
                 api-key: Option[text] = ::api-key, base-url: Option[text] = ::base-url,
                 max-retries: int = ::max-retries) -> Result[Noul, JevError] =
  try Ok(ask-noul(instructions, state, criteria, model, timeout, api-key, base-url, max-retries))
  catch JevError as e => Err(e)

# The functions below take their target from the call site, so they have no
# `try-` twins; catch `JevError` instead.

@extern-name("ask_choice")
@doc("""
  Ask a choice question over the enum members of `C` and return the chosen member with probabilities.

  Raises `JevTargetError` unless `C` is an enum with at least two fieldless members, or
  `JevResponseError` when the answer's labels do not match `C`. Other SDK failures raise `JevError`;
  an invalid timeout raises `std/errors::TypeError`.

  Each option uses its member's JSON tag and `@doc`, or `null` when undocumented. Probabilities
  are keyed by members of `C`. The target is inferred from the call site; settings follow
  `system-one`.
""")
extern def ask-choice[C](instructions: text, state: json = "", model: Option[text] = ::model,
                         timeout: Option[text] = ::timeout, api-key: Option[text] = ::api-key,
                         base-url: Option[text] = ::base-url,
                         max-retries: int = ::max-retries) -> Choice[C]

@extern-name("ask_score")
@doc("""
  Ask a score question using the enum members of `L` as an ordered rubric.

  Raises `JevTargetError` unless `L` is an enum with 2-10 fieldless members, or `JevResponseError`
  when probabilities do not cover exactly its level indices. Other SDK failures raise `JevError`;
  an invalid timeout raises `std/errors::TypeError`.

  Levels follow declaration order; each description is its member's `@doc`, else its JSON tag.
  The result includes the most probable member, choosing the lowest index on a tie, the score,
  confidence, and probabilities keyed by members of `L`. The target is inferred from the call
  site; settings follow `system-one`.
""")
extern def ask-score[L](instructions: text, state: json = "", model: Option[text] = ::model,
                        timeout: Option[text] = ::timeout, api-key: Option[text] = ::api-key,
                        base-url: Option[text] = ::base-url,
                        max-retries: int = ::max-retries) -> Score[L]

@doc("""
  Ask one question selected by the target type and return its typed answer.

  Raises `JevTargetError` for an unsupported target or `JevResponseError` when the answer cannot
  fit it. Other SDK failures raise `JevError`; an invalid timeout raises `std/errors::TypeError`.

  `bool` and `Noul` select a noul question; `bool` uses `noul-threshold`. A fieldless enum or
  `Choice[C]` selects a choice question; `Score[L]` selects a score question. Choice and score
  enums follow `ask-choice` and `ask-score`. The target is inferred from the call site; settings
  follow `system-one`.
""")
extern def ask[T](instructions: text, state: json = "", model: Option[text] = ::model,
                  timeout: Option[text] = ::timeout, api-key: Option[text] = ::api-key,
                  base-url: Option[text] = ::base-url, max-retries: int = ::max-retries,
                  noul-threshold: decimal = ::noul-threshold) -> T

@extern-name("ask_many")
@doc("""
  Ask one question per field of the target record in one request and return the populated record.

  Raises `JevTargetError` for a non-record target, an empty record, or an unsupported field;
  a field error names `<record>.<field>`. An answer that cannot fit its field raises
  `JevResponseError`. Other SDK failures raise `JevError`; an invalid timeout raises
  `std/errors::TypeError`.

  Each field uses the target rules of `ask`. Questions are keyed by the field's JSON name;
  instructions are its `@doc`, else its declared name. The target is inferred from the call site;
  settings follow `system-one`.
""")
extern def ask-many[T](state: json, model: Option[text] = ::model,
                       timeout: Option[text] = ::timeout, api-key: Option[text] = ::api-key,
                       base-url: Option[text] = ::base-url, max-retries: int = ::max-retries,
                       noul-threshold: decimal = ::noul-threshold) -> T
