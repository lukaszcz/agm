# `json::parse(text) -> json` performs strict parsing with no target schema.
# It raises JsonParseError on malformed input. In contrast, `text as json`
# embeds text as a JSON string without parsing.
import std/json

# `text as json` embeds the text verbatim as a JSON string — always succeeds

program def main(raw: text) -> unit =
  let embedded: json = raw as json
  print embedded

  # json::parse performs strict parsing — may raise JsonParseError
  try
    let parsed = json::parse(raw)
    print parsed
  catch JsonParseError as e =>
    print "parse error"
    print e.raw
    let has-msg = e.message != ""
    print "has_message: %{has-msg as text}"
