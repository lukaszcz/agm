# `as?` returns whether the corresponding `as` cast would succeed. A successful
# test can select a branch before the explicit cast produces the converted value.
param user_input
param d: decimal

# Check if the text is a valid int before using it

program def main() -> unit =
  if user_input as? int =>
    let n = user_input as int
    print "got int: %{n}"
    print "squared: %{(n * n) as text}"
  else => print "not an int: %{user_input}"

  if d as? int =>
    let i = d as int
    print "decimal is integral: %{i}"
  else => print "decimal has fraction: %{d as text}"

  print(42 as? text)
