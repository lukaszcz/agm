# Agent values are ordinary enum data across JSON casts, nested records, and
# arrays. `agent` is likewise an ordinary binding and record field name.
record Team
  agent: Agent
  backups: array[Agent]

record Deployment
  primary: Team
  teams: array[Team]

# A direct member-record slot serializes as an ordinary object, without an enum case tag.
record DirectCommand
  command: Agent::AgentCommand

program def main() -> unit =
  let agent: Agent = AgentCommand("primary")
  let backup: Agent = AgentClaude("sonnet", "medium")
  let direct-json: json = agent as json
  let direct-round-trip: Agent = direct-json as Agent
  print(direct-round-trip == agent)

  let agents: array[Agent] = [agent, backup]
  let agents-json: json = agents as json
  let agents-round-trip: array[Agent] = agents-json as array[Agent]
  print(agents-round-trip == agents)

  let team = Team(agent = agent, backups = agents)
  let deployment = Deployment(primary = team, teams = [team])
  let deployment-json: json = deployment as json
  let deployment-round-trip: Deployment = deployment-json as Deployment
  print(deployment-round-trip == deployment)
  print(deployment-round-trip.primary.agent == agent)

  let direct = DirectCommand(command = AgentCommand("direct"))
  let direct-slot-json: json = direct as json
  let direct-slot-round-trip: DirectCommand = direct-slot-json as DirectCommand
  print(direct-slot-round-trip == direct)
