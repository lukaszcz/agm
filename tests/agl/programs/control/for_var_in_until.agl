# for x in array do body until x = sentinel — for-var referenced in until clause.
# Accumulates a sum until the for-variable equals the sentinel value.
# Proves the for-variable is in scope in the until condition.

program def main(items: array[int], sentinel: int) -> unit =
  var total: int = 0
  for x in items do
    total := total + x
  until x == sentinel
  print total
