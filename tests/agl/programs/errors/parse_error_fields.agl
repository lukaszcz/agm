# AgentParseError carries the documented diagnostic fields, usable in follow-up
# prompts.
record Spec
  name: text
  level: int

program def main() -> unit =
  let builder = AgentCommand("builder")
  let critic = AgentCommand("critic")
  try
    let s: Spec = builder.ask("Build the spec.", on_parse_error = Retry(n = 1))
    print s.name
  catch AgentParseError as e =>
    let advice = critic.ask("""
    Agent %{e.agent} failed for type %{e.target_type} after %{e.attempts} attempts.

    Raw:
    %{e.raw}

    Errors:
    %{e.validation_errors}

    Schema:
    %{e.expected_schema}
    """)
    print "advised"
    raise e
