{
  "scenarios": [
    {
      "name": "free_ask_retries_in_isolated_one_shot_sessions",
      "runtime": {"session_host": true},
      "agents": {"writer": ["not a number", "7"]},
      "expect": {
        "stdout": "7\n",
        "calls": {"writer": 0},
        "sessions": [
          {"agent": "writer", "tag": "session-1", "transport": "cli", "one_shot": true, "opened": true, "closed": true, "parent": null},
          {"agent": "writer", "tag": "session-2", "transport": "cli", "one_shot": true, "opened": true, "closed": true, "parent": null}
        ],
        "session_prompts": [
          {"agent": "writer", "session": "session-1", "call": 0, "starts_with": "calculate the total"},
          {
            "agent": "writer",
            "session": "session-2",
            "call": 0,
            "contains": ["calculate the total", "not a number"]
          }
        ]
      }
    }
  ]
}
