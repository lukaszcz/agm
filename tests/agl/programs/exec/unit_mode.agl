param target: int
param fail: bool

program def main() -> unit =
  # Bare ask and exec calls adapt to unit in statement and loop-body positions.
  let notifier = AgentCommand("notifier")
  notifier.ask("starting")
  exec "true"

  var rounds: int = 0
  do[3]
    rounds := rounds + 1
    notifier.ask("round %{rounds}")
  until rounds >= target

  do
    exec "true"
  until true

  if fail =>
    exec "false"

  print rounds
