# Planning and design workflows

import std/fs
import std/os
import std/config

def plan-prompt(plan-file: path) -> text =
  """
  <PROBLEM>

  Your task is to plan the implementation of the above. Save the plan to %{plan-file}

  All solutions must be general, principled and extensible - no pragmatic fixes.

  If anything is unclear, don't make assumptions, but ask me questions instead. Do NOT silently make major architectural decisions that are not explicitly specified by the owner.

  For every owner decision, present several alternatives with pros and cons and a single recommendation. Before writing the plan, ask me, one-by-one, about each major decision, explaining the issue and presenting the options together with your recommendation.
  """

@command("devel plan")
@doc("Create a plan interactively")
program def plan-main(
  file: path = ".agent-files/PLAN.md",
  agent: Agent = config::default-agent
) -> unit =
  let prompt-file = fs::temp-file("prompt")
  fs::write(prompt-file, plan-prompt(file))
  os::edit(prompt-file)
  agent.chat(fs::read(prompt-file))
