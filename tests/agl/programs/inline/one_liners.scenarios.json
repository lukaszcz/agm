{
  "scenarios": [
    {
      "name": "two_steps_then_done",
      "agents": {
        "stepper": [
          "\"More\"",
          "\"Done\"",
          "\"Done\""
        ]
      },
      "expect": {
        "stdout": "xy\n2\ndouble\ncase inline 2\ntail\n12\nend\n",
        "calls": {
          "stepper": 3
        },
        "prompts": [
          {
            "agent": {
              "$case": "AgentCommand",
              "command": "stepper"
            },
            "call": 0,
            "starts_with": "Step 1."
          },
          {
            "agent": {
              "$case": "AgentCommand",
              "command": "stepper"
            },
            "call": 1,
            "starts_with": "Step 2."
          }
        ]
      }
    },
    {
      "name": "done_immediately",
      "agents": {
        "stepper": [
          "\"Done\"",
          "\"Done\""
        ]
      },
      "expect": {
        "stdout": "xy\n1\nsingle\ntail\n11\nend\n",
        "calls": {
          "stepper": 2
        }
      }
    },
    {
      "name": "final_check_parse_failure_caught_inline",
      "runtime": {"parse_error_retries": 0},
      "agents": {
        "stepper": [
          "\"Done\"",
          "BROKEN"
        ]
      },
      "expect": {
        "stdout": "xy\n1\nsingle\ntail\n11\ncaught Agent::AgentCommand(command = \"stepper\")\nend\n",
        "calls": {
          "stepper": 2
        }
      }
    },
    {
      "name": "inline_loop_exhaustion",
      "agents": {
        "stepper": {
          "responses": [
            "\"More\""
          ],
          "repeat_last": true
        }
      },
      "expect": {
        "stdout": "xy\n",
        "calls": {
          "stepper": 5
        },
        "raises": {
          "type": "MaxIterationsExceeded",
          "fields": {
            "limit": 5
          }
        }
      }
    }
  ]
}
