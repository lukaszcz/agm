# `as`/`as?` casts to a recursive type: the same $defs/$ref JSON Schema and
# RefDecode decode plan that a recursive agent output target uses also drives
# a fallible text/json cast. Covers success and failure paths for `as`
# (CastError) and `as?` (boolean convertibility test), plus an `array[Tree]` cast
# target (a container of a recursive element type).
enum Tree
  | Leaf
  | Node(value: int, left: Tree, right: Tree)

def sum-tree(t: Tree) -> int =
  case t of
    | Leaf() => 0
    | Node(value, left, right) => value + sum-tree(left) + sum-tree(right)

program def main(tree-text: text, forest-text: text) -> unit =
  if tree-text as? Tree =>
    let t = tree-text as Tree
    print "sum: %{sum-tree(t)}"
  else =>
    try
      let t = tree-text as Tree
      print "unreachable"
    catch CastError as e =>
      print "cast failed: %{e.source-type} -> %{e.target-type}"

  if forest-text as? array[Tree] =>
    let forest = forest-text as array[Tree]
    var total: int = 0
    for t in forest do
      total := total + sum-tree(t)
    print "forest total: %{total}"
  else => print "forest invalid"
