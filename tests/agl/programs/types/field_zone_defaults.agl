# Unmarked record, enum payload, and exception fields are standard;
# an explicit * marker keeps bare-name shorthand for named-only fields.
record Pair
  left: int
  right: int

enum Result
  | PairResult(left: int, right: int)

exception Problem extends Exception
  code: int
  detail: text

record NamedPair
  *
  left: int
  right: int

program def main(base: int) -> unit =
  let positional-record = Pair(base, base + 1)
  let named-record = Pair(left = base + 2, right = base + 3)
  let positional-enum = PairResult(base + 4, base + 5)
  let named-enum = PairResult(left = base + 6, right = base + 7)
  let positional-exception = Problem(base + 8, "positional", message = "problem")
  let named-exception = Problem(code = base + 9, detail = "named", message = "problem")
  let left = base + 10
  let right = base + 11
  let shorthand = NamedPair(left, right)

  print positional-record.left
  print positional-record.right
  print named-record.left
  print named-record.right
  case positional-enum of
    | PairResult(left, right) =>
      print left
      print right
  case named-enum of
    | PairResult(left, right) =>
      print left
      print right
  print positional-exception.code
  print positional-exception.detail
  print named-exception.code
  print named-exception.detail
  print shorthand.left
  print shorthand.right
