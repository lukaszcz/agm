program def main() -> unit =
  let session = Session::open(AgentPi("writer", "model", "high"))
  let strict: int = session.ask(
    "strict parser",
    strict-json = true,
    on-parse-error = Retry(n = 1),
  )
  let lenient: int = session.ask(
    "lenient parser",
    strict-json = false,
    on-parse-error = Retry(n = 1),
  )
  print strict
  print lenient
