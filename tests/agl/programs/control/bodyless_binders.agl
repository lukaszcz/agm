# Terminal binders evaluate their RHS and keep effects in their enclosing continuation.
var events: text = ""

def log-event(event: text) -> text =
  events := events + event + "|"
  event

def prepare() -> unit =
  let function-value = log-event("function")

program def main(choose-true: bool) -> unit =
  prepare()

  if choose-true =>
    let if-value = log-event("if:true")
  else =>
    let if-value = log-event("if:false")

  case choose-true of
    true =>
      let case-value = log-event("case:true")
    | false =>
      let case-value = log-event("case:false")

  let grouped: unit = ((); let parenthesized-value = log-event("grouped"))

  let recovered: unit = try
    let try-value = log-event("try")
  catch _ =>
    ()

  print events
