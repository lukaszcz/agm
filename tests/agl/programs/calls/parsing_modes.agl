program def main() -> unit =
  # Lenient JSON recovery (extract from fences/prose, repair trivially malformed
  # JSON, then validate strictly) is the portable default; `strict_json: true` is
  # a per-call opt-in to strict parsing.
  let counter = AgentCommand("counter")
  let fetcher = AgentCommand("fetcher")
  let n: int = counter.ask("Count the items.")
  print n
  let exact: int = counter.ask("Count again.", strict_json = true)
  print exact
  let data: json = fetcher.ask("Fetch the data.")
  print data
