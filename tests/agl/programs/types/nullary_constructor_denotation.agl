# Fieldless constructors construct values outside call position, while calls and
# field-bearing constructor values retain their existing behavior.
record R1()
record Token[T]()
record Box(value: int)

enum Tree
  | Leaf
  | Node(value: int)

def accept-r1(value: R1) -> R1 = value
def accept-tree(value: Tree) -> Tree = value
def invoke-r1(factory: () -> R1) -> R1 = factory()

program def main() -> unit =
  let r = R1
  let r-call = R1()
  let leaf = Leaf
  let qualified-leaf = Tree::Leaf
  let leaf-call = Leaf()
  let qualified-leaf-call = Tree::Leaf()
  let token = Token::[int]
  let make-box: int -> Box = Box

  print(r == r-call)
  print(leaf == leaf-call)
  print(qualified-leaf == qualified-leaf-call)
  print(accept-r1(R1))
  print(accept-tree(Tree::Leaf))
  print(invoke-r1(fn() => R1))
  print(token)
  print(make-box(3))
  case leaf of | Leaf => print "bare pattern"
  case qualified-leaf of | Tree::Leaf => print "qualified pattern"
