{
  "scenarios": [
    {
      "name": "positive_start_raises",
      "params": {
        "start": 2
      },
      "expect": {
        "stdout": "[2, 3, 4, 5]\n20 true\n"
      }
    },
    {
      "name": "non_positive_start_returns",
      "params": {
        "start": -1
      },
      "expect": {
        "stdout": "[-1, 0, 1, 2]\n-1 true\n"
      }
    }
  ]
}
