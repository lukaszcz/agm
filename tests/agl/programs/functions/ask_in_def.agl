# Agent::ask called from inside a user-defined function body.
# Also exercises on-parse-error: Retry and the RecursionError depth limit
# (caught with try/catch).
let reviewer: Agent = AgentCommand("reviewer")

enum Verdict
  | Pass
  | Fail(issues: array[text])

def review-once(doc: text) -> Verdict =
  reviewer.ask("Review this document: " + doc)

def review-with-retry(doc: text) -> Verdict =
  reviewer.ask("Review this document: " + doc, on-parse-error = Retry(n = 2))

# Direct call via function — result printed.
def infinite(n: int) -> int = infinite(n + 1)

program def main(topic: text) -> unit =
  let first-verdict: Verdict = review-once(topic)
  print(first-verdict is Pass)

  # Retry-enabled call.
  let second-verdict: Verdict = review-with-retry(topic)
  print(second-verdict is Pass)

  # RecursionError caught inside try/catch.
  let depth-result = try
    infinite(0)
  catch RecursionError =>
    -1
  print depth-result
