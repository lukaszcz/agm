{
  "scenarios": [
    {
      "name": "tense_verdict",
      "inline_entry": true,
      "agents": {
        "reviewer": [
          "{\"$case\": \"Tense\", \"level\": 7}"
        ]
      },
      "expect": {
        "stdout": "init:-3\nentry\nbase:-3 low:-1\n4\n1\n2\n3\n6\n18\nnotes/tense:7\n3\n",
        "calls": {
          "reviewer": 1
        },
        "prompts": [
          {
            "agent": "reviewer",
            "call": 0,
            "contains": [
              "Review base:-3 low:-1."
            ],
            "schema_contains": [
              "Tense"
            ]
          }
        ]
      }
    },
    {
      "name": "calm_verdict",
      "inline_entry": true,
      "agents": {
        "reviewer": [
          "{\"$case\": \"Calm\"}"
        ]
      },
      "expect": {
        "stdout": "init:-3\nentry\nbase:-3 low:-1\n4\n1\n2\n3\n6\n18\nnotes/calm\n3\n",
        "calls": {
          "reviewer": 1
        }
      }
    },
    {
      "name": "unreadable_verdict",
      "inline_entry": true,
      "agents": {
        "reviewer": [
          "BROKEN"
        ]
      },
      "expect": {
        "stdout": "init:-3\nentry\nbase:-3 low:-1\n4\n1\n2\n3\n6\n18\nnotes/unreadable\n3\n",
        "calls": {
          "reviewer": 1
        }
      }
    }
  ]
}
