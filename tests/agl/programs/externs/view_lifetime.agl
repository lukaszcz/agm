# A container view can be used while its extern call is active, but a view
# retained by the companion becomes invalid after that call returns.
param mode: text

extern def stash(xs: array[int]) -> unit
extern def mutate_stashed() -> unit
extern def stash_and_use(xs: array[int]) -> unit

if mode == "within_call" =>
  var xs = [1]
  let _: unit = stash_and_use(xs)
  print xs

if mode == "after_return" =>
  var xs = [1]
  let _: unit = stash(xs)
  try
    let _: unit = mutate_stashed()
  catch ExternError as e =>
    print e.python_type
  print xs
