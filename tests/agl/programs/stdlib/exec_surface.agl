# exec accepts a complete child environment, working directory, and timeout.
import std/env::Environ

program def main() -> unit =
  let child = Environ(vars = {"ONLY": "child"})
  let cwd: Option[path] = Option::Some(value = "/work")
  let timeout: Option[text] = Option::Some(value = "2s")
  let explicit: text = exec("explicit", env = child, cwd = cwd, timeout = timeout)
  print explicit

  let ambient: text = exec $ ambient
  print ambient
