# Nested text rendering: literal interpolation markers, dollar signs, quotes,
# and \n inside records and arrays, combined with functions and control flow.
# Verifies that nested text in structured values is quoted in a round-trippable
# AgL string literal — a literal `%{` is re-escaped so the rendered form cannot
# read back as an interpolation, while a bare `$` needs no escape.
record Template
  body: text
  tag: text

enum Snippet
  | Raw(src: text)
  | Wrapped(prefix: text, src: text)

# A record whose text fields contain literal interpolation markers, dollar
# signs, and quotes.
let t1 = Template(body = "use ${x} and \%{y} here", tag = "has \"quotes\"")
print t1

# Nested text with a newline.
let t2 = Template(body = "line1\nline2", tag = "ok")
print t2

# An array of records containing special characters.
let snips = [Raw(src = "${var} \%{var}"), Wrapped(prefix = ">>", src = "a\"b")]
print snips

# Interpolating a record into a template (top-level text -> verbatim;
# nested record text fields -> quoted in the AgL-native form).
def label(t: Template) -> text =
  "tag=%{t.tag}"

print(label(t1))

# A direct dict literal is rendered as an AgL dict, including percent escaping
# in keys. JSON rendering intentionally does not share that escaping rule.
print "%{{"pct%": 1.50}}"

# Control flow: pick the snippet based on a condition.
param use_raw: bool

let chosen: Snippet = if use_raw => Raw(src = "plain ${x}") else => Wrapped(prefix = "**", src = "bold ${x}")

print chosen
