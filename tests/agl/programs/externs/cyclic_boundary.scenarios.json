{
  "scenarios": [
    {
      "name": "count_reads_outer_view_but_rendering_raises_on_reference_cycle",
      "params": {"mode": "cycle"},
      "expect": {
        "stdout": "count: 1\nshow caught: value contains a reference cycle\nidentity caught: value contains a reference cycle\ndone\n"
      }
    },
    {
      "name": "count_and_rendering_succeed_on_acyclic_value",
      "params": {"mode": "acyclic"},
      "expect": {
        "stdout": "count: 1\nshow: 1\nidentity: [Node(children = [])]\ndone\n"
      }
    },
    {
      "name": "count_and_rendering_succeed_on_diamond_shared_value",
      "params": {"mode": "diamond"},
      "expect": {
        "stdout": "count: 2\nshow: 2\nidentity: [Node(children = []), Node(children = [])]\ndone\n"
      }
    }
  ]
}
