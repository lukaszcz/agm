program def main() -> unit =
  # Lenient JSON recovery (extract from fences/prose, repair trivially malformed
  # JSON, then validate strictly) is the portable default; `strict-json: true` is
  # a per-call opt-in to strict parsing.
  let counter: Agent = AgentCommand("counter")
  let fetcher: Agent = AgentCommand("fetcher")
  let n: int = ask("Count the items.", agent = counter)
  print n
  let exact: int = ask("Count again.", agent = counter, strict-json = true)
  print exact
  let data: json = ask("Fetch the data.", agent = fetcher)
  print data
