# Headers/Response need dict and text receiver methods even when a custom
# standard library has no dependency on receiver-method modules.
import std/dict
import std/text
import std/errors::{JsonParseError, TypeError}
import std/fs
import std/json
import std/option::Option
import std/path::path
import std/result::Result
import std/url::{url}

# Inactivity timeout for a request: connect and every read must produce
# bytes within this bound; `None` disables it. Accepts a plain number
# (seconds) or a number suffixed with `s`, `m`, or `h` (seconds, minutes,
# hours); text that is not a duration raises `TypeError` when a request
# uses it, as `exec` does. Every call takes its own `timeout: Option[text]`,
# defaulting to this setting.
@param @opt-name("http-timeout") @doc("Inactivity timeout for HTTP requests; None disables it.")
var timeout: Option[text] = Some("30s")

enum Method = Get | Post | Put | Patch | Delete | Head | Options | Other(name: text)

# Upper-case verb; `Other(name)` renders its name verbatim.
def Method::render(self) -> text =
  case self of
    | Get => "GET"
    | Post => "POST"
    | Put => "PUT"
    | Patch => "PATCH"
    | Delete => "DELETE"
    | Head => "HEAD"
    | Options => "OPTIONS"
    | Other(name) => name

scope HeadersInternals
  # Header names are case-insensitive; this is the sole place a name is folded.
  def lower-name(name: text) -> text = name.lower()
end HeadersInternals

# The raw record keeps names exactly as given; use the `headers(...)`
# constructor to normalise them.
record Headers(entries: dict[text, text])

# Constructor: lowercases every name in `entries`. Names equal up to case
# collapse to one entry; the later entry wins.
def headers(entries: dict[text, text]) -> Headers =
  var normalized: dict[text, text] = {}
  entries.each(fn(name: text, value: text) =>
    normalized.set(HeadersInternals::lower-name(name), value))
  Headers(normalized)

def Headers::get(self, name: text) -> text = self.entries.get(HeadersInternals::lower-name(name))
def Headers::get?(self, name: text) -> Option[text] =
  self.entries.get?(HeadersInternals::lower-name(name))
def Headers::contains(self, name: text) -> bool =
  self.entries.contains(HeadersInternals::lower-name(name))
def Headers::set(self, name: text, value: text) -> unit =
  self.entries.set(HeadersInternals::lower-name(name), value)
# Raises `KeyError` when `name` is absent.
def Headers::remove(self, name: text) -> unit =
  let _ = self.entries.remove(HeadersInternals::lower-name(name))
  ()
# `other`'s entries win over `self`'s on a shared name.
def Headers::merged(self, other: Headers) -> Headers = headers(self.entries.merge(other.entries))

enum Auth = NoAuth | Basic(user: text, password: text) | Bearer(token: text)
enum Body = Empty | Text(content: text, content-type: text) | Json(value: json)
          | Form(fields: dict[text, text])
enum Receive = Decode | Ignore | Save(path: path)

# `method` is the verb the response answers; every `HttpError` these methods
# raise needs it alongside `url`. `elapsed` is monotonic seconds for the
# whole exchange, body transfer included.
record Response(status: int, headers: Headers, body: text, url: url, method: Method,
                cookies: dict[text, text], elapsed: decimal)

def Response::ok(self) -> bool = self.status >= 200 and self.status < 300

def Response::raise-for-status(self) -> Response =
  if self.ok() => self
  else => raise HttpStatusError(
    response = self,
    url = self.url,
    method = self.method,
    message = "HTTP %{self.status} for %{self.method.render()} %{self.url}",
  )

def Response::json(self) -> json = json::parse(self.body)
def Response::try-json(self) -> Result[json, JsonParseError] = json::try-parse(self.body)
def Response::json?(self) -> Option[json] = self.try-json().ok()

exception HttpError extends Exception
  url: url
  method: Method

# Unsupported scheme or malformed URL.
exception HttpUrlError extends HttpError()
# A request could not be transmitted at all, e.g. a header value with a
# newline or a method token with invalid characters.
exception HttpRequestError extends HttpError
  cause: text
exception HttpConnectionError extends HttpError
  cause: text
# `timeout` is the inactivity timeout given, empty when it was disabled
# (`timeout = None`).
exception HttpTimeoutError extends HttpError
  timeout: text
exception HttpTlsError extends HttpError
  cause: text
exception HttpRedirectError extends HttpError
  redirects: int
exception HttpDecodeError extends HttpError
  status: int
  headers: Headers
  encoding: text
exception HttpStatusError extends HttpError
  response: Response

scope RequestInternals
  # `method-text` is `method.render()`, passed alongside `method` so
  # `Method::render` stays the sole source of verb text.
  @extern-name("request")
  extern def send(method-text: text, method: Method, url: url, query: dict[text, text],
                 headers: Headers, body: Body, auth: Auth, cookies: dict[text, text],
                 receive: Receive, timeout: Option[text], follow-redirects: bool,
                 verify-tls: bool) -> Response
end RequestInternals

# `auth`, when not `NoAuth`, renders an `Authorization` header that overrides
# one supplied in `headers`. `query` is appended to `url`'s own query.
# `cookies` are sent exactly as given and never retained across calls.
# `follow-redirects` applies uniformly to every method, `Head` included.
# `Other(name)` is sent verbatim. `timeout` bounds every read and the connect
# step by inactivity; `None` disables it, and a non-positive or unparseable
# value raises `TypeError` before any request is sent.
def request(method: Method, url: url, query: dict[text, text] = {},
           headers: Headers = headers({}), body: Body = Empty, auth: Auth = NoAuth,
           cookies: dict[text, text] = {}, receive: Receive = Decode,
           timeout: Option[text] = ::timeout, follow-redirects: bool = true,
           verify-tls: bool = true) -> Response =
  RequestInternals::send(method.render(), method, url, query, headers, body, auth, cookies,
                        receive, timeout, follow-redirects, verify-tls)

def get(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
        body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
        receive: Receive = Decode, timeout: Option[text] = ::timeout,
        follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Get, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

def post(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
         body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
         receive: Receive = Decode, timeout: Option[text] = ::timeout,
         follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Post, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

def put(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
        body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
        receive: Receive = Decode, timeout: Option[text] = ::timeout,
        follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Put, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

def patch(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
          body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
          receive: Receive = Decode, timeout: Option[text] = ::timeout,
          follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Patch, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

def delete(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
           body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
           receive: Receive = Decode, timeout: Option[text] = ::timeout,
           follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Delete, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

def head(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
         body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
         receive: Receive = Decode, timeout: Option[text] = ::timeout,
         follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  request(Head, url, query, headers, body, auth, cookies, receive, timeout,
          follow-redirects, verify-tls)

# Saves the response body to `destination`, overwriting it atomically; a
# write failure raises `std/fs::FsError`.
def download(url: url, destination: path, query: dict[text, text] = {},
            headers: Headers = headers({}), body: Body = Empty, auth: Auth = NoAuth,
            cookies: dict[text, text] = {}, timeout: Option[text] = ::timeout,
            follow-redirects: bool = true, verify-tls: bool = true) -> Response =
  get(url, query, headers, body, auth, cookies, Save(destination), timeout, follow-redirects,
     verify-tls)

# Wraps `request`'s transport and decode failures as `Err`; `std/fs::FsError`
# and `TypeError` still propagate. Catch is exact, so every concrete
# subtype `request` can raise is listed here: `HttpStatusError` is never
# raised by `request` (only `Response::raise-for-status` raises it), so it
# is not caught. Each catch widens its concrete subtype to `HttpError`
# through an annotated `let` before `Err(...)`: a bare `Err(e)` would fix
# `Result`'s error parameter to that subtype instead of the declared
# `HttpError`.
def try-request(method: Method, url: url, query: dict[text, text] = {},
                headers: Headers = headers({}), body: Body = Empty, auth: Auth = NoAuth,
                cookies: dict[text, text] = {}, receive: Receive = Decode,
                timeout: Option[text] = ::timeout, follow-redirects: bool = true,
                verify-tls: bool = true) -> Result[Response, HttpError] =
  try
    Ok(request(method, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls))
  catch HttpUrlError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpRequestError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpConnectionError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpTimeoutError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpTlsError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpRedirectError as e =>
    let err: HttpError = e
    Err(err)
  catch HttpDecodeError as e =>
    let err: HttpError = e
    Err(err)

def try-get(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
            body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
            receive: Receive = Decode, timeout: Option[text] = ::timeout,
            follow-redirects: bool = true,
            verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Get, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)

def try-post(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
             body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
             receive: Receive = Decode, timeout: Option[text] = ::timeout,
             follow-redirects: bool = true,
             verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Post, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)

def try-put(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
            body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
            receive: Receive = Decode, timeout: Option[text] = ::timeout,
            follow-redirects: bool = true,
            verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Put, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)

def try-patch(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
              body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
              receive: Receive = Decode, timeout: Option[text] = ::timeout,
              follow-redirects: bool = true,
              verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Patch, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)

def try-delete(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
               body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
               receive: Receive = Decode, timeout: Option[text] = ::timeout,
               follow-redirects: bool = true,
               verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Delete, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)

def try-head(url: url, query: dict[text, text] = {}, headers: Headers = headers({}),
             body: Body = Empty, auth: Auth = NoAuth, cookies: dict[text, text] = {},
             receive: Receive = Decode, timeout: Option[text] = ::timeout,
             follow-redirects: bool = true,
             verify-tls: bool = true) -> Result[Response, HttpError] =
  try-request(Head, url, query, headers, body, auth, cookies, receive, timeout,
              follow-redirects, verify-tls)
