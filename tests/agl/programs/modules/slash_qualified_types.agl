import namespaces/flags/config

program def main() -> unit =
  let flag: /namespaces/flags/config::Flag = /namespaces/flags/config::Flag::On
  let result = case flag of
    | /namespaces/flags/config::Flag::On => "on"
    | /namespaces/flags/config::Flag::Off => "off"
  print(result)
  print(flag is /namespaces/flags/config::Flag::On)
