# Bare constructors as function values with explicit type arguments.
# `some::[int]` is a function value equivalent to `fn (x: int) => some(x)`.
# Direct member applications accept either the member's captured parameters or
# the owning enum's parameters; the latter preserves legacy spellings.
# The qualified `Option[int]::some` / `Option[int]::none` forms supply owner arguments.
enum Option[T]
  | none
  | some(value: T)

enum Outcome[T, E]
  | ok(value: T)
  | err(error: E)

# A payload constructor pinned with `::[int]` is a positional function value.

program def main() -> unit =
  let mk: int -> Option[int] = some::[int]
  let v = mk(7)

  # Both owner-applied and legacy direct spellings construct precise member records.
  let z: Option[int] = Option[int]::none
  let legacy-none: Option[int] = none::[int]
  let legacy-ok: Outcome[int, text] = ok::[int, text](value = 3)

  # The qualified forms work the same way.
  let qmk: int -> Option[int] = Option[int]::some
  let qv = qmk(9)
  let qz: Option[int] = Option[int]::none

  print(v is Option::some)
  print(z is Option::none)
  print(legacy-none is Option::none)
  print(legacy-ok is Outcome::ok)
  print(qv is Option::some)
  print(qz is Option::none)
