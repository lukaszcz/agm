# The do-loop bound is an arbitrary int expression (here a param plus a let),
# evaluated in the enclosing scope. The MaxIterationsExceeded `limit` field
# reflects the computed value.

program def main(cap: int, target: int) -> unit =
  let pad: int = 1
  var rounds: int = 0

  do[cap + pad]
    rounds := rounds + 1
  until rounds >= target
  print rounds
