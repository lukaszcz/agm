# `Sandbox`'s fields all default, and `AgentSandbox` widens it as a member
# record (enum-record unification): a `Sandbox` value and an `AgentSandbox`
# slot holding it are the same value, so `Sandbox(...)` alone constructs an
# `AgentSandbox::Sandbox` wherever that type is expected. `is` tests the
# member/enum relation without converting; `case` destructures the widened
# value positionally, like any other record.
def classify(mode: AgentSandbox) -> text =
  case mode of
    | Disabled => "disabled"
    | Native => "native"
    | Sandbox(memory, swap, settings, patch) =>
        "sandbox(%{memory}, %{swap}, %{settings}, %{patch})"

def tuned-for(size: text) -> AgentSandbox = Sandbox(memory = Some(size))

program def main(mode: int) -> unit =
  let all-defaults = Sandbox
  let called-defaults = Sandbox()
  print(all-defaults == called-defaults)
  print all-defaults

  let eight-gig = Sandbox(memory = Some("8G"))
  print eight-gig.memory
  print eight-gig.swap
  print eight-gig.patch

  let widened: AgentSandbox = eight-gig
  print(widened is Sandbox)
  print(widened is Native)
  print(classify(widened))

  let stretched = eight-gig with swap = Some("2G")
  print(classify(stretched))

  let entries: array[AgentSandbox] = [
    AgentSandbox::Disabled,
    AgentSandbox::Native,
    Sandbox(memory = None),
    tuned-for("4G"),
  ]
  for entry in entries do
    print(classify(entry))
  done

  let native: AgentSandbox = AgentSandbox::Native
  let disabled: AgentSandbox = AgentSandbox::Disabled
  let empty-sandbox: AgentSandbox = Sandbox(memory = None)
  print(native is Native)
  print(disabled is Disabled)
  print(empty-sandbox is Sandbox)
  print(disabled is Native)

  let selected: AgentSandbox =
    case mode of
      | 0 => AgentSandbox::Disabled
      | 1 => AgentSandbox::Native
      | _ => widened
  print(classify(selected))
  print(selected is Sandbox)
